{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/customer-profile/sections": {
      "get": {
        "operationId": "getSections",
        "summary": "GET Get Portal Sections",
        "description": "Return the add-on sections registered for one customer-portal surface. Each entry carries an uncompiled Vue component string plus its payload; the customer-portal SPA compiles it in the browser, since the SPA's route table is static and cannot otherwise be extended by add-ons.\n\n**Access policy:** `CustomerFrontendPolicy`\n\n**Access policy:** `CustomerFrontendPolicy`",
        "tags": [
          "Customer Profile"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The portal section group to fetch. Must match one of the plugin's allowlisted portal section filters or the request is rejected with a 422."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns the sections registered for the requested filter, or an empty array if the current user is not a customer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "sections": {
                      "type": "array",
                      "description": "Add-on portal sections for the requested filter.",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "example": {
                    "message": "Success",
                    "sections": []
                  }
                },
                "example": {
                  "message": "Success",
                  "sections": []
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Success",
                      "sections": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 401
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 401
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "The filter value is not a recognized portal section group.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Unknown portal section group."
                },
                "schema": {
                  "example": {
                    "message": "Unknown portal section group."
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Unknown portal section group."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
