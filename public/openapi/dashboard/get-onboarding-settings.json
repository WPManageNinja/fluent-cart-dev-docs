                    "pages": [
                      {
                        "label": "Shop( 10 )",
                        "value": "10"
                      },
                      {
                        "label": "Checkout( 12 )",
                        "value": "12"
                      }
                    ],
                    "currencies": [
                      {
                        "label": "United States Dollar",
                        "value": "USD"
                      },
                      {
                        "label": "Euro",
                        "value": "EUR"
