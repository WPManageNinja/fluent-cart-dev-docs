            "type": "integer",
            "example": 13
          },
          "receipt_page_id": {
            "type": "integer",
            "example": 14
          },
          "customer_profile_page_id": {
            "type": "integer",
            "description": "Customer profile page ID",
            "example": 15
          },
          "customer_profile_page_slug": {
            "type": "string",
            "example": "account"
          },
          "store_address1": {
            "type": "string",
