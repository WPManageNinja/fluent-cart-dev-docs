            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "show_relevant_product_in_modal": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "order_mode": {
            "type": "string",
            "enum": [
              "live",
              "test"
            ],
            "example": "live"
          },
          "variation_view": {
            "type": "string",
            "example": "both"
          },
          "variation_columns": {
            "type": "string",
            "example": "masonry"
          },
          "enable_early_payment_for_installment": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "yes"
          },
          "subscription_management_mode": {
            "type": "string",
            "example": "gateway_managed"
          },
          "subscription_system_charge": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "modules_settings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_receipt_number": {
            "type": "string",
            "example": "1000"
          },
          "reminders_enabled": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "renewal_reminders_enabled": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "renewal_reminder_overdue_days": {
            "type": "string",
            "description": "Comma-separated list of days before/after due date to send overdue reminders",
            "example": "1,3,7"
          }
        }
      },
      "OnboardingTaxSettings": {
        "type": "object",
        "description": "A summary of the store's tax configuration used by the onboarding wizard.",
        "properties": {
          "enable_tax": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "description": "Whether tax collection is enabled store-wide",
            "example": "no"
          },
          "tax_inclusion": {
            "type": "string",
            "enum": [
              "included",
              "excluded"
            ],
            "description": "Whether displayed prices include tax",
            "example": "excluded"
          },
          "eu_method": {
            "type": "string",
            "description": "EU VAT collection method (e.g. oss, home)",
            "example": "oss"
          },
          "vat_number": {
            "type": "string",
            "description": "The store's VAT/tax ID for its configured country, resolved from the EU OSS/home VAT setting or from the non-EU country's tax ID meta",
            "example": ""
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
