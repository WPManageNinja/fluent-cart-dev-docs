  "components": {
    "schemas": {
      "PageOption": {
        "type": "object",
        "description": "A published WordPress page, formatted as a label/value option for the onboarding wizard's page pickers.",
        "properties": {
          "label": {
            "type": "string",
            "description": "Page title with its ID appended",
            "example": "Shop( 10 )"
          },
          "value": {
            "type": "string",
            "description": "WordPress page ID",
            "example": "10"
          }
        }
      },
      "CurrencyOption": {
        "type": "object",
        "description": "An available store currency, formatted as a label/value option.",
        "properties": {
          "label": {
            "type": "string",
            "description": "Currency display name",
            "example": "United States Dollar"
          },
          "value": {
            "type": "string",
            "description": "Currency code (ISO 4217)",
            "example": "USD"
          }
        }
      },
      "OnboardingDefaults": {
        "type": "object",
        "description": "The store's current settings (fluentcart_settings), used to pre-fill the onboarding wizard. This is the full store settings object, not an onboarding-specific subset.",
        "properties": {
          "store_name": {
            "type": "string",
            "description": "Store name",
            "example": "My Store"
          },
          "company_name": {
            "type": "string",
            "example": ""
          },
          "currency": {
            "type": "string",
            "description": "Store currency code",
            "example": "USD"
          },
          "currency_position": {
            "type": "string",
            "example": "before"
          },
          "decimal_separator": {
            "type": "string",
            "example": "dot"
          },
          "checkout_button_text": {
            "type": "string",
            "example": "Checkout"
          },
          "view_cart_button_text": {
            "type": "string",
            "example": "View Cart"
          },
          "cart_button_text": {
            "type": "string",
            "example": "Add To Cart"
          },
          "popup_button_text": {
            "type": "string",
            "example": "View Product"
          },
          "out_of_stock_button_text": {
            "type": "string",
            "example": "Out of stock"
          },
          "checkout_method_style": {
            "type": "string",
            "example": "logo"
          },
          "enable_modal_checkout": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "require_logged_in": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "show_cart_icon_in_nav": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "show_cart_icon_in_body": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "yes"
          },
          "additional_address_field": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "yes"
          },
          "hide_coupon_field": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "example": "yes"
          },
          "user_account_creation_mode": {
            "type": "string",
            "example": "all"
          },
          "shop_page_id": {
            "type": "integer",
            "description": "Shop page ID. Defaults to a newly generated page's ID when not yet configured.",
            "example": 10
          },
          "checkout_page_id": {
            "type": "integer",
            "description": "Checkout page ID",
            "example": 12
          },
          "custom_payment_page_id": {
            "type": "string",
            "example": ""
          },
          "registration_page_id": {
            "type": "string",
            "example": ""
