{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/activity": {
      "get": {
        "operationId": "listActivities",
        "summary": "GET List Activities",
        "description": "Retrieve a paginated list of activity log entries with filtering and sorting support.\n\n**Access policy:** `AdminPolicy` \u2014 requires the `is_super_admin` FluentCart capability.",
        "tags": [
          "Dashboard"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by ID (prefix with #), title, content, or module name"
          },
          {
            "name": "active_view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "success",
                "warning",
                "error",
                "failed",
                "info",
                "api"
              ]
            },
            "description": "Filter by tab"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id"
            },
            "description": "Column to sort by"
          },
          {
            "name": "sort_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "description": "Sort direction"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 200
            },
            "description": "Results per page (max 200)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination"
          },
          {
            "name": "filter_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "advanced"
              ],
              "default": "simple"
            },
            "description": "Filter mode"
          },
          {
            "name": "advanced_filters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded advanced filter groups (requires filter_type=advanced and Pro)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "activities": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "current_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ActivityLogEntry"
                          }
                        },
                        "first_page_url": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL of the first page of results"
                        },
                        "from": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Starting record number on the current page"
                        },
                        "last_page_url": {
                          "type": "string",
                          "description": "URL of the last page of results"
                        },
                        "links": {
                          "type": "array",
                          "description": "Laravel-style pagination links (previous, page numbers, next)",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "nullable": true
                              },
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL of the next page of results"
                        },
                        "path": {
                          "type": "string",
                          "description": "Base URL of the endpoint without the query string"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL of the previous page of results"
                        },
                        "to": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Ending record number on the current page"
                        }
                      }
                    }
                  },
                  "example": {
                    "activities": {
                      "total": 156,
                      "per_page": 10,
                      "current_page": 1,
                      "last_page": 16,
                      "data": [
                        {
                          "id": 42,
                          "title": "Order #1024 status changed",
                          "content": "Order status changed from pending to completed",
                          "status": "success",
                          "log_type": "activity",
                          "module_name": "orders",
                          "read_status": "unread",
                          "created_at": "2025-06-15 14:30:00",
                          "updated_at": "2025-06-15 14:30:00"
                        }
                      ],
                      "first_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=1",
                      "from": 1,
                      "last_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=16",
                      "links": [
                        {
                          "url": null,
                          "label": "pagination.previous",
                          "active": false
                        },
                        {
                          "url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=1",
                          "label": "1",
                          "active": true
                        },
                        {
                          "url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=2",
                          "label": "2",
                          "active": false
                        }
                      ],
                      "next_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=2",
                      "path": "https://yoursite.com/wp-json/fluent-cart/v2/activity",
                      "prev_page_url": null,
                      "to": 10
                    }
                  }
                },
                "example": {
                  "activities": {
                    "total": 156,
                    "per_page": 10,
                    "current_page": 1,
                    "last_page": 16,
                    "data": [
                      {
                        "id": 42,
                        "title": "Order #1024 status changed",
                        "content": "Order status changed from pending to completed",
                        "status": "success",
                        "log_type": "activity",
                        "module_name": "orders",
                        "read_status": "unread",
                        "created_at": "2025-06-15 14:30:00",
                        "updated_at": "2025-06-15 14:30:00"
                      }
                    ],
                    "first_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=1",
                    "from": 1,
                    "last_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=16",
                    "links": [
                      {
                        "url": null,
                        "label": "pagination.previous",
                        "active": false
                      },
                      {
                        "url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=1",
                        "label": "1",
                        "active": true
                      },
                      {
                        "url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=2",
                        "label": "2",
                        "active": false
                      }
                    ],
                    "next_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=2",
                    "path": "https://yoursite.com/wp-json/fluent-cart/v2/activity",
                    "prev_page_url": null,
                    "to": 10
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "activities": {
                        "total": 156,
                        "per_page": 10,
                        "current_page": 1,
                        "last_page": 16,
                        "data": [
                          {
                            "id": 42,
                            "title": "Order #1024 status changed",
                            "content": "Order status changed from pending to completed",
                            "status": "success",
                            "log_type": "activity",
                            "module_name": "orders",
                            "read_status": "unread",
                            "created_at": "2025-06-15 14:30:00",
                            "updated_at": "2025-06-15 14:30:00"
                          }
                        ],
                        "first_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=1",
                        "from": 1,
                        "last_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=16",
                        "links": [
                          {
                            "url": null,
                            "label": "pagination.previous",
                            "active": false
                          },
                          {
                            "url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=1",
                            "label": "1",
                            "active": true
                          },
                          {
                            "url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=2",
                            "label": "2",
                            "active": false
                          }
                        ],
                        "next_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/activity/?page=2",
                        "path": "https://yoursite.com/wp-json/fluent-cart/v2/activity",
                        "prev_page_url": null,
                        "to": 10
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityLogEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Activity log entry ID",
            "example": 42
          },
          "title": {
            "type": "string",
            "description": "Activity title",
            "example": "Order #1024 status changed"
          },
          "content": {
            "type": "string",
            "description": "Activity description",
            "example": "Order status changed from pending to completed"
          },
          "status": {
            "type": "string",
            "description": "Activity status",
            "example": "success"
          },
          "log_type": {
            "type": "string",
            "description": "Log type",
            "example": "activity"
          },
          "module_name": {
            "type": "string",
            "description": "Module name",
            "example": "orders"
          },
          "read_status": {
            "type": "string",
            "description": "Read status",
            "example": "unread"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp",
            "example": "2025-06-15 14:30:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp",
            "example": "2025-06-15 14:30:00"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
