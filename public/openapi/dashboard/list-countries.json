{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/address-info/countries": {
      "get": {
        "operationId": "listCountries",
        "summary": "GET List Countries",
        "description": "Retrieve a list of all available countries formatted as select options.\n\n**Access policy:** `UserPolicy`",
        "tags": [
          "Dashboard"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CountryOption"
                      }
                    }
                  },
                  "example": {
                    "data": [
                      {
                        "value": "US",
                        "name": "United States"
                      },
                      {
                        "value": "GB",
                        "name": "United Kingdom"
                      },
                      {
                        "value": "CA",
                        "name": "Canada"
                      }
                    ]
                  }
                },
                "example": {
                  "data": [
                    {
                      "value": "US",
                      "name": "United States"
                    },
                    {
                      "value": "GB",
                      "name": "United Kingdom"
                    },
                    {
                      "value": "CA",
                      "name": "Canada"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": [
                        {
                          "value": "US",
                          "name": "United States"
                        },
                        {
                          "value": "GB",
                          "name": "United Kingdom"
                        },
                        {
                          "value": "CA",
                          "name": "Canada"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CountryOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Two-letter ISO country code",
            "example": "US"
          },
          "name": {
            "type": "string",
            "description": "Country display name",
            "example": "United States"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
