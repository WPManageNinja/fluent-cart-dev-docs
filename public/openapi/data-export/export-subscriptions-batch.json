{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/data-export/subscriptions/batch": {
      "post": {
        "operationId": "exportSubscriptionsBatch",
        "summary": "POST Export Subscriptions Batch",
        "description": "Export one batch of subscriptions. This endpoint is **cursor-paginated and self-throttling**: it returns as many records as fit inside a runtime and response-size budget, then hands back a `cursor` and `has_more`.\n\n**Loop until `has_more` is `false`**, passing the previous `cursor` each time and preferring the returned `batch.next_max` as the next `max_records`. `total` is only computed on the first call and is `null` thereafter.\n\n**Permission:** `subscriptions/export` · **Policy:** `OrderPolicy`",
        "tags": [
          "Data Export"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "csv",
                      "json"
                    ],
                    "default": "csv",
                    "description": "`csv` yields flat records keyed by `columns`; `json` yields nested records keyed by `modules`."
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "current_page",
                      "selected",
                      "search_results",
                      "all"
                    ],
                    "default": "all",
                    "description": "`all` ignores `filters` entirely. `current_page` and `selected` both require a non-empty `ids` array."
                  },
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Record IDs. Required when `scope` is `current_page` or `selected`. Truncated to the first 5000; deduplicated."
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Column keys from `csv_columns`. Unknown keys are dropped. Required (after filtering) when `format` is `csv`. Capped at 100 entries."
                  },
                  "modules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Module keys from `json_modules`. Unknown keys are dropped. Capped at 100 entries."
                  },
                  "filters": {
                    "type": "object",
                    "properties": {
                      "filter_type": {
                        "type": "string"
                      },
                      "search": {
                        "type": "string"
                      },
                      "active_view": {
                        "type": "string"
                      },
                      "sort_by": {
                        "type": "string"
                      },
                      "sort_type": {
                        "type": "string"
                      },
                      "advanced_filters": {
                        "type": "string",
                        "description": "JSON-encoded filter groups; truncated at 100,000 characters."
                      },
                      "user_tz": {
                        "type": "string"
                      }
                    },
                    "example": {
                      "filter_type": "simple",
                      "search": "",
                      "active_view": "all"
                    }
                  },
                  "cursor": {
                    "type": "integer",
                    "default": 0,
                    "description": "Continuation token from the previous response. Omit or send `0` for the first batch."
                  },
                  "max_records": {
                    "type": "integer",
                    "default": 500,
                    "minimum": 100,
                    "maximum": 1000,
                    "description": "Records to return. Clamped into the 100–1000 range."
                  }
                },
                "example": {
                  "format": "csv",
                  "scope": "all",
                  "columns": [
                    "subscription_id"
                  ],
                  "max_records": 500
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "export": {
                      "type": "object",
                      "properties": {
                        "entity": {
                          "type": "string"
                        },
                        "schema_version": {
                          "type": "integer"
                        },
                        "records": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "record_id": {
                                "type": "integer",
                                "description": "Primary key of the record; also the value written back to `cursor`."
                              }
                            },
                            "additionalProperties": true,
                            "description": "One exported record. For `format: \"csv\"` the keys are exactly the selected `columns`; for `format: \"json\"` the record is nested per the selected `modules`."
                          }
                        },
                        "total": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Total matching records. Counted only on the first call (`cursor` 0 or absent); `null` on every continuation."
                        },
                        "cursor": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Pass this back as `cursor` on the next call to continue. `null` on the first page."
                        },
                        "has_more": {
                          "type": "boolean",
                          "description": "`true` when more records remain. Keep calling until this is `false`."
                        },
                        "batch": {
                          "type": "object",
                          "properties": {
                            "records": {
                              "type": "integer",
                              "description": "Records returned in this batch."
                            },
                            "elapsed_ms": {
                              "type": "integer"
                            },
                            "estimated_bytes": {
                              "type": "integer"
                            },
                            "requested_max": {
                              "type": "integer"
                            },
                            "next_max": {
                              "type": "integer",
                              "description": "Server-suggested `max_records` for the next call, adapted to observed size and runtime. Honour it to avoid `413`s."
                            }
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "export": {
                      "entity": "customers",
                      "schema_version": 1,
                      "records": [
                        {
                          "record_id": 1219,
                          "customer_id": 1219,
                          "first_name": "Alex",
                          "last_name": "Morgan",
                          "email": "alex.morgan@example.com",
                          "status": "active",
                          "purchase_count": 1
                        }
                      ],
                      "total": 1,
                      "cursor": 1219,
                      "has_more": false,
                      "batch": {
                        "records": 1,
                        "elapsed_ms": 2,
                        "estimated_bytes": 671,
                        "requested_max": 100,
                        "next_max": 100
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the user lacks `subscriptions/export`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The module backing this entity is not active.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Human-readable error message"
                    }
                  },
                  "example": {
                    "message": "This export module is not active."
                  }
                }
              }
            }
          },
          "413": {
            "description": "A single record exceeded the response size budget. Lower `max_records`, or reduce the selected `columns`/`modules`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Human-readable error message"
                    }
                  },
                  "example": {
                    "message": "A single record was too large to export."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid `format` or `scope`; or `scope` is `current_page`/`selected` with no `ids`; or `format` is `csv` and no valid `columns` remained after filtering.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Human-readable error message"
                    }
                  },
                  "example": {
                    "message": "Select at least one CSV column."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
