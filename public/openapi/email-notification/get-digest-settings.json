{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/email-notification/digest-settings": {
      "get": {
        "operationId": "getDigestSettings",
        "summary": "GET Get Store Digest Settings",
        "description": "Retrieve the store's digest email settings \u2014 the recurring summary email(s) sent to store admins on a daily, weekly, and/or monthly cadence.\n\n**Access policy:** `StoreSensitivePolicy`\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Email Notifications"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns the current store digest settings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "string",
                          "description": "\"yes\" or \"no\" \u2014 whether digest emails are enabled at all."
                        },
                        "recipients": {
                          "type": "string",
                          "description": "Comma-separated recipient list, or a template like {{wp.admin_email}}."
                        },
                        "send_when_empty": {
                          "type": "string",
                          "description": "\"yes\" or \"no\" \u2014 whether to send a digest even when there's no activity to report."
                        },
                        "daily": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "string"
                            },
                            "send_hour": {
                              "type": "integer"
                            }
                          }
                        },
                        "weekly": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "string"
                            },
                            "send_hour": {
                              "type": "integer"
                            },
                            "send_dow": {
                              "type": "integer",
                              "description": "Day of week to send, 0-6."
                            }
                          }
                        },
                        "monthly": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "string"
                            },
                            "send_hour": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "data": {
                      "enabled": "yes",
                      "recipients": "{{wp.admin_email}}",
                      "send_when_empty": "no",
                      "daily": {
                        "enabled": "no",
                        "send_hour": 8
                      },
                      "weekly": {
                        "enabled": "yes",
                        "send_hour": 8,
                        "send_dow": 1
                      },
                      "monthly": {
                        "enabled": "no",
                        "send_hour": 8
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "enabled": "yes",
                    "recipients": "{{wp.admin_email}}",
                    "send_when_empty": "no",
                    "daily": {
                      "enabled": "no",
                      "send_hour": 8
                    },
                    "weekly": {
                      "enabled": "yes",
                      "send_hour": 8,
                      "send_dow": 1
                    },
                    "monthly": {
                      "enabled": "no",
                      "send_hour": 8
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": {
                        "enabled": "yes",
                        "recipients": "{{wp.admin_email}}",
                        "send_when_empty": "no",
                        "daily": {
                          "enabled": "no",
                          "send_hour": 8
                        },
                        "weekly": {
                          "enabled": "yes",
                          "send_hour": 8,
                          "send_dow": 1
                        },
                        "monthly": {
                          "enabled": "no",
                          "send_hour": 8
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 401
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 401
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The authenticated user lacks store-sensitive access.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 403
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
