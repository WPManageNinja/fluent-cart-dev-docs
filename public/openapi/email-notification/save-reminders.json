{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/email-notification/reminders": {
      "post": {
        "operationId": "saveSchedulingSettings",
        "summary": "POST Save Scheduling Settings",
        "description": "Update the store's reminder settings. Each reminder type has an enable toggle and, for the scheduled cycles, a days value that controls how many days before the event the reminder is sent. Overdue renewal reminders take a comma-separated list of day offsets instead.\n\nThe submitted keys are merged into the existing store settings, so keys left out keep their current values. The response returns the merged settings in full.\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Email Notifications"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Master toggle for all reminders",
                    "example": "yes"
                  },
                  "renewal_reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Enable overdue payment reminders for store-managed renewal orders",
                    "example": "no"
                  },
                  "renewal_reminder_overdue_days": {
                    "type": "string",
                    "description": "Comma-separated day offsets after the due date at which overdue reminders are sent",
                    "example": "1,3,7"
                  },
                  "yearly_renewal_reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Enable yearly subscription renewal reminders",
                    "example": "yes"
                  },
                  "yearly_renewal_reminder_days": {
                    "type": "integer",
                    "minimum": 7,
                    "maximum": 90,
                    "description": "Days before renewal to send reminder. Required when yearly_renewal_reminders_enabled is yes",
                    "example": 30
                  },
                  "trial_end_reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Enable trial ending reminders",
                    "example": "yes"
                  },
                  "trial_end_reminder_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 14,
                    "description": "Days before trial ends to send reminder. Required when trial_end_reminders_enabled is yes",
                    "example": 3
                  },
                  "monthly_renewal_reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Enable monthly renewal reminders",
                    "example": "no"
                  },
                  "monthly_renewal_reminder_days": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 28,
                    "description": "Days before renewal to send reminder. Required when monthly_renewal_reminders_enabled is yes",
                    "example": 7
                  },
                  "quarterly_renewal_reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Enable quarterly renewal reminders",
                    "example": "no"
                  },
                  "quarterly_renewal_reminder_days": {
                    "type": "integer",
                    "minimum": 7,
                    "maximum": 60,
                    "description": "Days before renewal to send reminder. Required when quarterly_renewal_reminders_enabled is yes",
                    "example": 14
                  },
                  "half_yearly_renewal_reminders_enabled": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "description": "Enable half-yearly renewal reminders",
                    "example": "no"
                  },
                  "half_yearly_renewal_reminder_days": {
                    "type": "integer",
                    "minimum": 7,
                    "maximum": 60,
                    "description": "Days before renewal to send reminder. Required when half_yearly_renewal_reminders_enabled is yes",
                    "example": 21
                  }
                },
                "example": {
                  "reminders_enabled": "yes",
                  "renewal_reminders_enabled": "no",
                  "renewal_reminder_overdue_days": "1,3,7",
                  "yearly_renewal_reminders_enabled": "yes",
                  "yearly_renewal_reminder_days": 30,
                  "trial_end_reminders_enabled": "yes",
                  "trial_end_reminder_days": 3,
                  "monthly_renewal_reminders_enabled": "no",
                  "monthly_renewal_reminder_days": 7,
                  "quarterly_renewal_reminders_enabled": "no",
                  "quarterly_renewal_reminder_days": 14,
                  "half_yearly_renewal_reminders_enabled": "no",
                  "half_yearly_renewal_reminder_days": 21
                }
              },
              "example": {
                "reminders_enabled": "yes",
                "renewal_reminders_enabled": "no",
                "renewal_reminder_overdue_days": "1,3,7",
                "yearly_renewal_reminders_enabled": "yes",
                "yearly_renewal_reminder_days": 30,
                "trial_end_reminders_enabled": "yes",
                "trial_end_reminder_days": 3,
                "monthly_renewal_reminders_enabled": "no",
                "monthly_renewal_reminder_days": 7,
                "quarterly_renewal_reminders_enabled": "no",
                "quarterly_renewal_reminder_days": 14,
                "half_yearly_renewal_reminders_enabled": "no",
                "half_yearly_renewal_reminder_days": 21
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "reminders_enabled": "yes",
                    "invoice_reminders_enabled": "yes",
                    "invoice_reminder_due_days": 3,
                    "invoice_reminder_overdue_days": "1,3,7",
                    "yearly_renewal_reminders_enabled": "yes",
                    "yearly_renewal_reminder_days": 30,
                    "trial_end_reminders_enabled": "yes",
                    "trial_end_reminder_days": 3,
                    "monthly_renewal_reminders_enabled": "no",
                    "monthly_renewal_reminder_days": 7,
                    "quarterly_renewal_reminders_enabled": "no",
                    "quarterly_renewal_reminder_days": 14,
                    "half_yearly_renewal_reminders_enabled": "no",
                    "half_yearly_renewal_reminder_days": 14
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scheduling settings saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "The merged store settings after the save."
                    },
                    "message": {
                      "type": "string",
                      "example": "Scheduling settings saved successfully"
                    }
                  },
                  "example": {
                    "data": {
                      "reminders_enabled": "yes",
                      "renewal_reminders_enabled": "no",
                      "renewal_reminder_overdue_days": "1,3,7",
                      "yearly_renewal_reminders_enabled": "yes",
                      "yearly_renewal_reminder_days": 30,
                      "trial_end_reminders_enabled": "yes",
                      "trial_end_reminder_days": 3,
                      "monthly_renewal_reminders_enabled": "no",
                      "monthly_renewal_reminder_days": 7,
                      "quarterly_renewal_reminders_enabled": "no",
                      "quarterly_renewal_reminder_days": 14,
                      "half_yearly_renewal_reminders_enabled": "no",
                      "half_yearly_renewal_reminder_days": 21
                    },
                    "message": "Scheduling settings saved successfully"
                  }
                },
                "example": {
                  "data": {
                    "reminders_enabled": "yes",
                    "renewal_reminders_enabled": "no",
                    "renewal_reminder_overdue_days": "1,3,7",
                    "yearly_renewal_reminders_enabled": "yes",
                    "yearly_renewal_reminder_days": 30,
                    "trial_end_reminders_enabled": "yes",
                    "trial_end_reminder_days": 3,
                    "monthly_renewal_reminders_enabled": "no",
                    "monthly_renewal_reminder_days": 7,
                    "quarterly_renewal_reminders_enabled": "no",
                    "quarterly_renewal_reminder_days": 14,
                    "half_yearly_renewal_reminders_enabled": "no",
                    "half_yearly_renewal_reminder_days": 21
                  },
                  "message": "Scheduling settings saved successfully"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": {
                        "reminders_enabled": "yes",
                        "invoice_reminders_enabled": "yes",
                        "invoice_reminder_due_days": 3,
                        "invoice_reminder_overdue_days": "1,3,7",
                        "yearly_renewal_reminders_enabled": "yes",
                        "yearly_renewal_reminder_days": 30,
                        "trial_end_reminders_enabled": "yes",
                        "trial_end_reminder_days": 3,
                        "monthly_renewal_reminders_enabled": "no",
                        "monthly_renewal_reminder_days": 7,
                        "quarterly_renewal_reminders_enabled": "no",
                        "quarterly_renewal_reminder_days": 14,
                        "half_yearly_renewal_reminders_enabled": "no",
                        "half_yearly_renewal_reminder_days": 14
                      },
                      "message": "Scheduling settings saved successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request or save failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed to save scheduling settings"
                    }
                  },
                  "example": {
                    "message": "Failed to save scheduling settings"
                  }
                },
                "example": {
                  "message": "Failed to save scheduling settings"
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Failed to save scheduling settings"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          },
          "423": {
            "description": "The settings could not be saved.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Failed to save scheduling settings"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
