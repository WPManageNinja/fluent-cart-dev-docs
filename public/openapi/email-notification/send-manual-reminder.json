{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/email-notification/send-manual-reminder": {
      "post": {
        "operationId": "sendManualReminder",
        "summary": "POST Send Manual Reminder",
        "description": "Send a reminder email now, for one order or subscription, outside its normal schedule.\n\n`event` accepts three values, and `entity_id` means a different record for each:\n\n| `event` | `entity_id` | Sent when |\n| --- | --- | --- |\n| `renewal_reminder_overdue` | Order ID | The order still has an outstanding balance. This event has no per-notification toggle, so only the store-wide reminder switch is checked. |\n| `subscription_renewal_reminder` | Subscription ID | The subscription is active (or on a simulated trial) and has a next billing date. |\n| `subscription_trial_end_reminder` | Subscription ID | The subscription is in a real trial period and has a trial end date. |\n\nReminders must be enabled for the store (`reminders_enabled`), and, for the two subscription events, the matching notification must be active.\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Email Notifications"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event",
                  "entity_id"
                ],
                "properties": {
                  "event": {
                    "type": "string",
                    "enum": [
                      "renewal_reminder_overdue",
                      "subscription_renewal_reminder",
                      "subscription_trial_end_reminder"
                    ],
                    "description": "The reminder to send. Any other value is rejected with 422; an unrecognised name reports \"This reminder notification is currently disabled.\"",
                    "example": "subscription_renewal_reminder"
                  },
                  "entity_id": {
                    "type": "integer",
                    "description": "Order ID for `renewal_reminder_overdue`, Subscription ID for the two subscription events.",
                    "example": 15
                  }
                },
                "example": {
                  "event": "subscription_renewal_reminder",
                  "entity_id": 15
                }
              },
              "example": {
                "event": "subscription_renewal_reminder",
                "entity_id": 15
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "event": "subscription_renewal_reminder",
                    "entity_id": 15
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reminder sent successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "Renewal reminder sent successfully"
                  }
                },
                "example": {
                  "message": "Renewal reminder sent successfully"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Renewal reminder sent successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 401
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 401
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The authenticated user lacks store-sensitive access.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 403
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "The reminder was not sent. The body carries the reason in `message`.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Subscription is not active"
                },
                "examples": {
                  "missing_params": {
                    "summary": "event or entity_id missing",
                    "value": {
                      "message": "Event type and entity ID are required"
                    }
                  },
                  "reminders_off": {
                    "summary": "Store-wide reminders are disabled",
                    "value": {
                      "message": "Reminders are disabled for this store."
                    }
                  },
                  "notification_off": {
                    "summary": "No active notification for this event, including any unrecognised name",
                    "value": {
                      "message": "This reminder notification is currently disabled."
                    }
                  },
                  "unknown_event": {
                    "summary": "An event with an active notification that is not a reminder",
                    "value": {
                      "message": "Unknown reminder type"
                    }
                  },
                  "not_eligible": {
                    "summary": "The record is not eligible",
                    "value": {
                      "message": "Subscription is not active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
