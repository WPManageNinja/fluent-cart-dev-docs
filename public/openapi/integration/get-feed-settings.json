{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/integration/global-feeds/settings": {
      "get": {
        "operationId": "getFeedSettings",
        "summary": "GET Feed Settings",
        "description": "Retrieve the settings form schema, saved values, and available shortcodes for a specific integration feed. Used to populate the feed editor when creating or editing a global feed.\n\n**Required permission:** `integrations/view`",
        "tags": [
          "Integrations"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "integration_name",
            "in": "query",
            "required": true,
            "description": "The integration provider key (e.g., `fluent-crm`, `webhook`)",
            "schema": {
              "type": "string",
              "example": "fluent-crm"
            }
          },
          {
            "name": "integration_id",
            "in": "query",
            "required": false,
            "description": "The feed ID to load existing settings for editing. Omit to get defaults for a new feed.",
            "schema": {
              "type": "integer",
              "example": 42
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "type": "object",
                      "description": "Current feed settings values (defaults for new, saved values for existing)"
                    },
                    "settings_fields": {
                      "type": "object",
                      "description": "Form schema defining the feed editor fields",
                      "properties": {
                        "fields": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/FeedSettingsField"
                          }
                        }
                      }
                    },
                    "shortcodes": {
                      "type": "object",
                      "description": "Available shortcodes for dynamic field mapping, grouped by category.",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ShortcodeGroup"
                          }
                        }
                      }
                    },
                    "inputs": {
                      "type": "object",
                      "description": "Checkout input fields available for mapping, keyed by shortcode. Serializes as an empty array `[]` when no checkout fields are configured."
                    },
                    "merge_fields": {
                      "type": "boolean",
                      "description": "`false` by default. When the selected integration list has custom merge fields, this becomes an object mapping merge field keys to labels."
                    }
                  },
                  "example": {
                    "settings": {
                      "enabled": "yes",
                      "list_name": "",
                      "name": "",
                      "list_ids": [],
                      "tag_ids": [],
                      "tag_ids_selection_type": "simple",
                      "double_opt_in": "yes",
                      "note": ""
                    },
                    "settings_fields": {
                      "fields": [
                        {
                          "key": "name",
                          "label": "Feed Title",
                          "required": true,
                          "placeholder": "Name",
                          "component": "text",
                          "inline_tip": "Name of this feed, it will be used to identify this feed in the list of feeds"
                        },
                        {
                          "key": "list_ids",
                          "label": "Add to Lists",
                          "placeholder": "Select FluentCRM Lists",
                          "inline_tip": "Select the FluentCRM Lists you would like to add your contact to.",
                          "component": "select",
                          "is_multiple": true,
                          "required": false,
                          "options": {
                            "1": "Newsletter Subscribers",
                            "2": "Customers",
                            "3": "VIP Customers"
                          }
                        }
                      ],
                      "button_require_list": false,
                      "integration_title": "FluentCRM"
                    },
                    "shortcodes": {
                      "data": [
                        {
                          "key": "customer",
                          "title": "Customer",
                          "shortcodes": {
                            "{{order.billing.full_name}}": "Full Name",
                            "{{order.billing.email}}": "Email",
                            "{{order.billing.city}}": "City",
                            "{{order.billing.country}}": "Country"
                          }
                        },
                        {
                          "key": "order",
                          "title": "Order",
                          "shortcodes": {
                            "{{order.id}}": "Order ID",
                            "{{order.invoice_no}}": "Order Number",
                            "{{order.total_amount}}": "Order Total Amount",
                            "{{order.currency}}": "Order Currency"
                          }
                        }
                      ]
                    },
                    "inputs": [],
                    "merge_fields": false
                  }
                },
                "example": {
                  "settings": {
                    "enabled": "yes",
                    "list_name": "",
                    "name": "",
                    "list_ids": [],
                    "tag_ids": [],
                    "tag_ids_selection_type": "simple",
                    "double_opt_in": "yes",
                    "note": ""
                  },
                  "settings_fields": {
                    "fields": [
                      {
                        "key": "name",
                        "label": "Feed Title",
                        "required": true,
                        "placeholder": "Name",
                        "component": "text",
                        "inline_tip": "Name of this feed, it will be used to identify this feed in the list of feeds"
                      },
                      {
                        "key": "list_ids",
                        "label": "Add to Lists",
                        "placeholder": "Select FluentCRM Lists",
                        "inline_tip": "Select the FluentCRM Lists you would like to add your contact to.",
                        "component": "select",
                        "is_multiple": true,
                        "required": false,
                        "options": {
                          "1": "Newsletter Subscribers",
                          "2": "Customers",
                          "3": "VIP Customers"
                        }
                      }
                    ],
                    "button_require_list": false,
                    "integration_title": "FluentCRM"
                  },
                  "shortcodes": {
                    "data": [
                      {
                        "key": "customer",
                        "title": "Customer",
                        "shortcodes": {
                          "{{order.billing.full_name}}": "Full Name",
                          "{{order.billing.email}}": "Email",
                          "{{order.billing.city}}": "City",
                          "{{order.billing.country}}": "Country"
                        }
                      },
                      {
                        "key": "order",
                        "title": "Order",
                        "shortcodes": {
                          "{{order.id}}": "Order ID",
                          "{{order.invoice_no}}": "Order Number",
                          "{{order.total_amount}}": "Order Total Amount",
                          "{{order.currency}}": "Order Currency"
                        }
                      }
                    ]
                  },
                  "inputs": [],
                  "merge_fields": false
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "settings": {
                        "enabled": "yes",
                        "list_name": "",
                        "name": "",
                        "list_ids": [],
                        "tag_ids": [],
                        "tag_ids_selection_type": "simple",
                        "double_opt_in": "yes",
                        "note": ""
                      },
                      "settings_fields": {
                        "fields": [
                          {
                            "key": "name",
                            "label": "Feed Title",
                            "required": true,
                            "placeholder": "Name",
                            "component": "text",
                            "inline_tip": "Name of this feed, it will be used to identify this feed in the list of feeds"
                          },
                          {
                            "key": "list_ids",
                            "label": "Add to Lists",
                            "placeholder": "Select FluentCRM Lists",
                            "inline_tip": "Select the FluentCRM Lists you would like to add your contact to.",
                            "component": "select",
                            "is_multiple": true,
                            "required": false,
                            "options": {
                              "1": "Newsletter Subscribers",
                              "2": "Customers",
                              "3": "VIP Customers"
                            }
                          }
                        ],
                        "button_require_list": false,
                        "integration_title": "FluentCRM"
                      },
                      "shortcodes": {
                        "data": [
                          {
                            "key": "customer",
                            "title": "Customer",
                            "shortcodes": {
                              "{{order.billing.full_name}}": "Full Name",
                              "{{order.billing.email}}": "Email",
                              "{{order.billing.city}}": "City",
                              "{{order.billing.country}}": "Country"
                            }
                          },
                          {
                            "key": "order",
                            "title": "Order",
                            "shortcodes": {
                              "{{order.id}}": "Order ID",
                              "{{order.invoice_no}}": "Order Number",
                              "{{order.total_amount}}": "Order Total Amount",
                              "{{order.currency}}": "Order Currency"
                            }
                          }
                        ]
                      },
                      "inputs": [],
                      "merge_fields": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`integrations/view`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FeedSettingsField": {
        "type": "object",
        "description": "Field definition. Exact shape is integration-specific (built by that provider's own settings-fields filter), so field names beyond the common ones below can vary per integration.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Field identifier"
          },
          "label": {
            "type": "string",
            "description": "Display label"
          },
          "component": {
            "type": "string",
            "description": "Field UI component (e.g., text, select, password)"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the field is required"
          },
          "placeholder": {
            "type": "string",
            "description": "Placeholder text for the input"
          },
          "inline_tip": {
            "type": "string",
            "description": "Helper text shown below the field"
          },
          "is_multiple": {
            "type": "boolean",
            "description": "Whether a select field allows multiple selections"
          },
          "options": {
            "type": "object",
            "description": "Available options for select fields, as a map of option value to label",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ShortcodeGroup": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Shortcode group identifier",
            "example": "customer"
          },
          "title": {
            "type": "string",
            "description": "Human-readable group title",
            "example": "Customer"
          },
          "shortcodes": {
            "type": "object",
            "description": "Map of shortcode to its human-readable label",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
