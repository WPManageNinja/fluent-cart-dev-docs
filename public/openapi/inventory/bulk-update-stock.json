{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/inventory/bulk-update": {
      "post": {
        "operationId": "bulkUpdateInventoryStock",
        "summary": "POST Bulk Update Stock",
        "description": "Add to or set the total stock level for multiple variations in one request, recording an adjustment per variation. In `add` mode the value is added to each variation's current stock; in `set` mode the value replaces it. Stock is clamped to a minimum of 0 and `available` is recomputed per variation. Variation IDs that do not exist are skipped. Requires the FluentCart Pro plugin with Advanced Inventory enabled. Permission: `products/edit`.",
        "tags": [
          "Inventory"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode",
                  "value",
                  "reason",
                  "items"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "add",
                      "set"
                    ],
                    "description": "`add` increments each variation's stock by `value`; `set` replaces it with `value`."
                  },
                  "value": {
                    "type": "integer",
                    "description": "The amount to add or the value to set."
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "received",
                      "damage",
                      "return",
                      "correction",
                      "transfer",
                      "other"
                    ],
                    "description": "Adjustment reason applied to every item."
                  },
                  "customReason": {
                    "type": "string",
                    "description": "Free-text reason. Required only when `reason` is `other`."
                  },
                  "items": {
                    "type": "array",
                    "description": "Variations to update.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Variation ID."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "mode": "add",
                  "value": 10,
                  "reason": "received",
                  "items": [
                    { "id": 460 },
                    { "id": 461 },
                    { "id": 462 }
                  ]
                }
              },
              "example": {
                "mode": "add",
                "value": 10,
                "reason": "received",
                "items": [
                  { "id": 460 },
                  { "id": 461 },
                  { "id": 462 }
                ]
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "mode": "add",
                    "value": 10,
                    "reason": "received",
                    "items": [
                      { "id": 460 },
                      { "id": 461 },
                      { "id": 462 }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Stock updated successfully",
                  "count": 3
                },
                "schema": {
                  "example": {
                    "message": "Stock updated successfully",
                    "count": 3
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Stock updated successfully",
                      "count": 3
                    }
                  },
                  "empty": {
                    "summary": "No items provided",
                    "value": {
                      "message": "No items to update",
                      "count": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "examples": {
                  "invalid_mode": {
                    "summary": "Invalid mode",
                    "value": {
                      "message": "Invalid mode. Allowed: add, set"
                    }
                  },
                  "invalid_reason": {
                    "summary": "Invalid reason",
                    "value": {
                      "message": "Invalid reason."
                    }
                  },
                  "custom_required": {
                    "summary": "Custom reason required",
                    "value": {
                      "message": "Custom reason is required when reason is \"other\"."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
