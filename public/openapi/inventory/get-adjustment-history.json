{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/inventory/adjustment-history": {
      "get": {
        "operationId": "getAdjustmentHistory",
        "summary": "GET Adjustment History",
        "description": "Retrieve the stock adjustment history for a single variation, most recent first (up to 100 records). Requires the FluentCart Pro plugin with Advanced Inventory enabled. Permission: `products/view`.",
        "tags": [
          "Inventory"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "variant_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The variation ID whose adjustment history to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "adjustments": [
                    {
                      "id": 12,
                      "variant_id": 460,
                      "post_id": 123,
                      "old_stock": 30,
                      "new_stock": 50,
                      "change": 20,
                      "reason": "received",
                      "reason_label": "Received Stock",
                      "custom_reason": "",
                      "user_id": 1,
                      "user_name": "admin",
                      "created_at": "2026-06-24 12:00:00",
                      "updated_at": "2026-06-24 12:00:00"
                    }
                  ],
                  "variant_id": 460
                },
                "schema": {
                  "example": {
                    "adjustments": [
                      {
                        "id": 12,
                        "variant_id": 460,
                        "post_id": 123,
                        "old_stock": 30,
                        "new_stock": 50,
                        "change": 20,
                        "reason": "received",
                        "reason_label": "Received Stock",
                        "custom_reason": "",
                        "user_id": 1,
                        "user_name": "admin",
                        "created_at": "2026-06-24 12:00:00",
                        "updated_at": "2026-06-24 12:00:00"
                      }
                    ],
                    "variant_id": 460
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "adjustments": [
                        {
                          "id": 12,
                          "variant_id": 460,
                          "post_id": 123,
                          "old_stock": 30,
                          "new_stock": 50,
                          "change": 20,
                          "reason": "received",
                          "reason_label": "Received Stock",
                          "custom_reason": "",
                          "user_id": 1,
                          "user_name": "admin",
                          "created_at": "2026-06-24 12:00:00",
                          "updated_at": "2026-06-24 12:00:00"
                        }
                      ],
                      "variant_id": 460
                    }
                  },
                  "empty": {
                    "summary": "No adjustments recorded",
                    "value": {
                      "adjustments": [],
                      "variant_id": 460
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing variant_id.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Variant ID is required"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
