{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/inventory/stats": {
      "get": {
        "operationId": "getInventoryStats",
        "summary": "GET Inventory Stats",
        "description": "Retrieve aggregate stock counts across stock-managed variations: total variations, in-stock, low-stock, and out-of-stock. Only variations with `manage_stock` enabled are counted. The low-stock threshold defaults to 10 and is filterable via `fluent_cart/inventory_low_stock_threshold`. Requires the FluentCart Pro plugin with Advanced Inventory enabled. Permission: `products/view`.",
        "tags": [
          "Inventory"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "totalVariants": 120,
                  "inStock": 80,
                  "lowStock": 25,
                  "outOfStock": 15
                },
                "schema": {
                  "example": {
                    "totalVariants": 120,
                    "inStock": 80,
                    "lowStock": 25,
                    "outOfStock": 15
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "totalVariants": 120,
                      "inStock": 80,
                      "lowStock": 25,
                      "outOfStock": 15
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
