{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/inventory/": {
      "get": {
        "operationId": "listInventory",
        "summary": "GET List Inventory",
        "description": "Retrieve a paginated list of stock-managed products, each with its variations and current stock levels. Only products with at least one `manage_stock` variation are returned. Requires the FluentCart Pro plugin with Advanced Inventory enabled. Permission: `products/view`.",
        "tags": [
          "Inventory"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term. Matches product title, variation SKU, or variation title."
          },
          {
            "name": "active_view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "low_stock",
                "out_of_stock"
              ]
            },
            "description": "Tab filter. One of: `all`, `low_stock`, `out_of_stock`."
          },
          {
            "name": "filter_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "advanced"
              ],
              "default": "simple"
            },
            "description": "Filter mode: `simple` (default) or `advanced`."
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Column to sort by."
          },
          {
            "name": "sort_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "description": "Sort direction: `asc` or `desc` (default: `desc`)."
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of results per page (default: 10)."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "products": {
                    "total": 42,
                    "per_page": 10,
                    "current_page": 1,
                    "last_page": 5,
                    "data": [
                      {
                        "ID": 123,
                        "post_title": "Example Product",
                        "post_content": "Full product description.",
                        "post_excerpt": "Short summary.",
                        "post_status": "publish",
                        "thumbnail": "https://example.com/wp-content/uploads/product.jpg",
                        "view_url": "https://example.com/product/example-product",
                        "gallery": [],
                        "detail": {
                          "fulfillment_type": "physical"
                        },
                        "variants": [
                          {
                            "id": 460,
                            "post_id": 123,
                            "variation_title": "Small",
                            "sku": "EX-SM",
                            "manage_stock": 1,
                            "total_stock": 50,
                            "available": 48,
                            "committed": 2,
                            "on_hold": 0,
                            "stock_status": "in-stock"
                          }
                        ]
                      }
                    ]
                  }
                },
                "schema": {
                  "example": {
                    "products": {
                      "total": 42,
                      "per_page": 10,
                      "current_page": 1,
                      "last_page": 5,
                      "data": [
                        {
                          "ID": 123,
                          "post_title": "Example Product",
                          "post_content": "Full product description.",
                          "post_excerpt": "Short summary.",
                          "post_status": "publish",
                          "thumbnail": "https://example.com/wp-content/uploads/product.jpg",
                          "view_url": "https://example.com/product/example-product",
                          "gallery": [],
                          "detail": {
                            "fulfillment_type": "physical"
                          },
                          "variants": [
                            {
                              "id": 460,
                              "post_id": 123,
                              "variation_title": "Small",
                              "sku": "EX-SM",
                              "manage_stock": 1,
                              "total_stock": 50,
                              "available": 48,
                              "committed": 2,
                              "on_hold": 0,
                              "stock_status": "in-stock"
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "products": {
                        "total": 42,
                        "per_page": 10,
                        "current_page": 1,
                        "last_page": 5,
                        "data": [
                          {
                            "ID": 123,
                            "post_title": "Example Product",
                            "post_content": "Full product description.",
                            "post_excerpt": "Short summary.",
                            "post_status": "publish",
                            "thumbnail": "https://example.com/wp-content/uploads/product.jpg",
                            "view_url": "https://example.com/product/example-product",
                            "gallery": [],
                            "detail": {
                              "fulfillment_type": "physical"
                            },
                            "variants": [
                              {
                                "id": 460,
                                "post_id": 123,
                                "variation_title": "Small",
                                "sku": "EX-SM",
                                "manage_stock": 1,
                                "total_stock": 50,
                                "available": 48,
                                "committed": 2,
                                "on_hold": 0,
                                "stock_status": "in-stock"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
