{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/inventory": {
      "get": {
        "operationId": "listInventory",
        "summary": "GET List Inventory",
        "description": "Retrieve a paginated list of stock-managed products with their variants. Only products whose detail row **and** at least one variant have `manage_stock = 1` are returned.\n\n**Permission:** `products/view` · **Policy:** `ProductPolicy`",
        "tags": [
          "Advanced Inventory"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination."
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Records per page."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term. Matches product title, and variant SKU or variation title. Also supports operator syntax (e.g. `sku = TES-RED-XS`)."
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id"
            },
            "description": "Column to sort by (default: `id`)."
          },
          {
            "name": "sort_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": "Sort direction."
          },
          {
            "name": "active_view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "low_stock",
                "out_of_stock"
              ]
            },
            "description": "Tab filter: `all`, `low_stock` or `out_of_stock`."
          },
          {
            "name": "filter_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "advanced"
              ],
              "default": "simple"
            },
            "description": "Filter mode."
          },
          {
            "name": "advanced_filters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded array of advanced filter groups."
          },
          {
            "name": "with",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Eager-load relations. Allowlisted values: `admin_inventory_list` (both relations, variant columns narrowed — used by the admin table), `detail`, and `variants`. Extendable via the `fluent_cart/inventory_allowed_withs` filter."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "products": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "ID": {
                                "type": "integer"
                              },
                              "post_title": {
                                "type": "string"
                              },
                              "post_content": {
                                "type": "string"
                              },
                              "post_excerpt": {
                                "type": "string"
                              },
                              "post_status": {
                                "type": "string"
                              },
                              "thumbnail": {
                                "type": "string",
                                "nullable": true
                              },
                              "view_url": {
                                "type": "string",
                                "description": "Public permalink for the product."
                              },
                              "gallery": {
                                "type": "array",
                                "items": {
                                  "type": "object"
                                }
                              },
                              "detail": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "post_id": {
                                    "type": "integer"
                                  },
                                  "fulfillment_type": {
                                    "type": "string"
                                  },
                                  "min_price": {
                                    "type": "string"
                                  },
                                  "max_price": {
                                    "type": "string"
                                  },
                                  "manage_stock": {
                                    "type": "string"
                                  },
                                  "stock_availability": {
                                    "type": "string"
                                  },
                                  "variation_type": {
                                    "type": "string"
                                  }
                                }
                              },
                              "variants": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "integer"
                                    },
                                    "post_id": {
                                      "type": "integer"
                                    },
                                    "variation_title": {
                                      "type": "string"
                                    },
                                    "variation_identifier": {
                                      "type": "string"
                                    },
                                    "sku": {
                                      "type": "string",
                                      "nullable": true
                                    },
                                    "manage_stock": {
                                      "type": "string",
                                      "description": "`\"1\"` when this variant tracks stock."
                                    },
                                    "stock_status": {
                                      "type": "string"
                                    },
                                    "backorders": {
                                      "type": "integer"
                                    },
                                    "total_stock": {
                                      "type": "integer",
                                      "description": "Physical units on hand."
                                    },
                                    "on_hold": {
                                      "type": "integer",
                                      "description": "Units reserved by in-flight checkouts."
                                    },
                                    "committed": {
                                      "type": "integer",
                                      "description": "Units sold and awaiting fulfillment."
                                    },
                                    "available": {
                                      "type": "integer",
                                      "description": "`total_stock - committed - on_hold`, floored at 0."
                                    },
                                    "item_price": {
                                      "type": "integer",
                                      "description": "Price in the store's smallest currency unit (cents)."
                                    },
                                    "item_cost": {
                                      "type": "integer"
                                    },
                                    "item_status": {
                                      "type": "string"
                                    },
                                    "fulfillment_type": {
                                      "type": "string"
                                    },
                                    "created_at": {
                                      "type": "string"
                                    },
                                    "updated_at": {
                                      "type": "string"
                                    },
                                    "serial_index": {
                                      "type": "integer",
                                      "description": "Display order of the variant within its product."
                                    },
                                    "sold_individually": {
                                      "type": "integer",
                                      "description": "`1` limits the variant to one unit per order."
                                    },
                                    "media_id": {
                                      "type": "integer",
                                      "nullable": true,
                                      "description": "Attachment ID of the variant image."
                                    },
                                    "media": {
                                      "type": "object",
                                      "nullable": true,
                                      "description": "Resolved media object for the variant image."
                                    },
                                    "thumbnail": {
                                      "type": "string",
                                      "nullable": true,
                                      "description": "Resolved thumbnail URL, falling back to the store placeholder."
                                    },
                                    "payment_type": {
                                      "type": "string",
                                      "description": "`onetime` or a subscription payment type."
                                    },
                                    "manage_cost": {
                                      "type": "string",
                                      "description": "`\"true\"`/`\"false\"` — whether cost-of-goods tracking is on."
                                    },
                                    "compare_price": {
                                      "type": "integer",
                                      "description": "Struck-through comparison price, in the smallest currency unit."
                                    },
                                    "formatted_total": {
                                      "type": "string",
                                      "description": "Human-readable price, HTML-escaped (e.g. `&#36;100.00`)."
                                    },
                                    "shipping_class": {
                                      "type": "integer",
                                      "nullable": true,
                                      "description": "Shipping class ID, `null` for digital variants."
                                    },
                                    "downloadable": {
                                      "type": "string",
                                      "description": "`\"true\"`/`\"false\"` — whether the variant carries downloadable files."
                                    },
                                    "other_info": {
                                      "type": "object",
                                      "description": "Per-variant settings: tax class/exemption, weight and dimensions, bundle config."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "first_page_url": {
                          "type": "string"
                        },
                        "from": {
                          "type": "integer",
                          "nullable": true
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "path": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "to": {
                          "type": "integer",
                          "nullable": true
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
