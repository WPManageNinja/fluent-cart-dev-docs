                      },
                      "sort_order": 2,
                      "created_at": "2026-01-12 09:15:00",
                      "updated_at": "2026-01-12 09:15:00"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": [
                        {
                          "id": 21,
                          "group_id": 4,
                          "title": "Red",
                          "slug": "red",
                          "settings": {
                            "color": "#e53e3e"
                          },
