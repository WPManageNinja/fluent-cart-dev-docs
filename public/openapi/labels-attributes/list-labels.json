{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/labels": {
      "get": {
        "operationId": "listLabels",
        "summary": "GET List Labels",
        "description": "Retrieve all available labels. Labels are tags that can be attached to orders, customers, or other entities for organizational purposes.\n\n**Required permission:** `labels/view`",
        "tags": [
          "Labels"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns all labels.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "labels": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Label"
                      }
                    }
                  },
                  "example": {
                    "labels": [
                      {
                        "id": 1,
                        "value": "VIP",
                        "created_at": "2026-05-10T09:12:00+00:00",
                        "updated_at": "2026-05-10T09:12:00+00:00"
                      },
                      {
                        "id": 2,
                        "value": "Wholesale",
                        "created_at": "2026-05-12T14:20:00+00:00",
                        "updated_at": "2026-05-12T14:20:00+00:00"
                      },
                      {
                        "id": 3,
                        "value": "Priority",
                        "created_at": "2026-05-15T08:05:00+00:00",
                        "updated_at": "2026-05-15T08:05:00+00:00"
                      }
                    ]
                  }
                },
                "example": {
                  "labels": [
                    {
                      "id": 1,
                      "value": "VIP",
                      "created_at": "2026-05-10T09:12:00+00:00",
                      "updated_at": "2026-05-10T09:12:00+00:00"
                    },
                    {
                      "id": 2,
                      "value": "Wholesale",
                      "created_at": "2026-05-12T14:20:00+00:00",
                      "updated_at": "2026-05-12T14:20:00+00:00"
                    },
                    {
                      "id": 3,
                      "value": "Priority",
                      "created_at": "2026-05-15T08:05:00+00:00",
                      "updated_at": "2026-05-15T08:05:00+00:00"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "labels": [
                        {
                          "id": 1,
                          "value": "VIP",
                          "created_at": "2026-05-10T09:12:00+00:00",
                          "updated_at": "2026-05-10T09:12:00+00:00"
                        },
                        {
                          "id": 2,
                          "value": "Wholesale",
                          "created_at": "2026-05-12T14:20:00+00:00",
                          "updated_at": "2026-05-12T14:20:00+00:00"
                        },
                        {
                          "id": 3,
                          "value": "Priority",
                          "created_at": "2026-05-15T08:05:00+00:00",
                          "updated_at": "2026-05-15T08:05:00+00:00"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`labels/view`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Label": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Label ID",
            "example": 1
          },
          "value": {
            "type": "string",
            "description": "Label name",
            "example": "VIP"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "GMT timestamp when the label was created",
            "example": "2026-05-10T09:12:00+00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "GMT timestamp when the label was last updated",
            "example": "2026-05-10T09:12:00+00:00"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
