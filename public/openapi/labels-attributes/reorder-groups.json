{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/options/attr/groups/reorder": {
      "post": {
        "operationId": "reorderGroups",
        "summary": "POST Reorder Attribute Groups",
        "description": "Persist the merchant's drag-reorder of attribute groups in the library. Submit group IDs in the desired display order; every ID must exist. Writes a dense, 1-indexed `serial` to each group. The list is capped at 500 IDs per request (filterable via `fluent_cart/attribute_groups/max_reorder`) — a reorder cannot be split into batches, so an oversized payload is rejected rather than truncated.\n\n**Required permission:** `products/edit`",
        "tags": [
          "Labels & Attributes"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Attribute group IDs in the desired display order. Non-positive and duplicate values are stripped before validation."
                  }
                },
                "example": {
                  "ids": [
                    10,
                    1,
                    3,
                    7
                  ]
                }
              },
              "example": {
                "ids": [
                  10,
                  1,
                  3,
                  7
                ]
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "ids": [
                      10,
                      1,
                      3,
                      7
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Groups reordered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array"
                    }
                  },
                  "example": {
                    "message": "Groups reordered.",
                    "data": []
                  }
                },
                "example": {
                  "message": "Groups reordered.",
                  "data": []
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Groups reordered.",
                      "data": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "No group IDs were provided, or the reorder list exceeds the maximum of 500 groups.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "No group IDs provided."
                  }
                },
                "example": {
                  "message": "No group IDs provided."
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "No group IDs provided."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
