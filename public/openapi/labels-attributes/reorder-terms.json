{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/options/attr/group/{group_id}/terms/reorder": {
      "post": {
        "operationId": "reorderTerms",
        "summary": "POST Reorder Attribute Terms",
        "description": "Persist the merchant's drag-reorder of attribute terms within one attribute group. Submit the term IDs in the desired display order; every ID must belong to the group given in the path. Writes a dense, 1-indexed `serial` to each term.\n\n**Required permission:** `products/edit`",
        "tags": [
          "Labels & Attributes"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Attribute group ID that owns the terms being reordered."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Term IDs in the desired display order. Every ID must belong to the group in the path; an empty list or a list containing an ID from a different group is rejected."
                  }
                },
                "example": {
                  "ids": [
                    12,
                    15,
                    9
                  ]
                }
              },
              "example": {
                "ids": [
                  12,
                  15,
                  9
                ]
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "ids": [
                      12,
                      15,
                      9
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Terms reordered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array"
                    }
                  },
                  "example": {
                    "message": "Terms reordered.",
                    "data": []
                  }
                },
                "example": {
                  "message": "Terms reordered.",
                  "data": []
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Terms reordered.",
                      "data": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "No term IDs were provided, or one or more term IDs do not belong to this group.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "One or more term IDs do not belong to this group."
                  }
                },
                "example": {
                  "message": "One or more term IDs do not belong to this group."
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "One or more term IDs do not belong to this group."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
