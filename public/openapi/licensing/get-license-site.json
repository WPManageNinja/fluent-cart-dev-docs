                      "total_amount": 9900
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "site": {
                        "id": 5,
                        "site_url": "https://customer-site.com",
                        "status": "active",
                        "created_at": "2026-01-10 09:00:00",
                        "updated_at": "2026-06-01 12:00:00"
                      },
                      "activations": {
                        "data": [
                          {
                            "id": 81,
                            "license_id": 1,
