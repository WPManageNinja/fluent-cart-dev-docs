{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/licensing/sites/{id}": {
      "get": {
        "operationId": "getLicenseSite",
        "summary": "GET License Site",
        "description": "Retrieve a single license site with its paginated activations, related customers, and related orders. Requires the FluentCart Pro plugin. Authorization is handled by the `LicensePolicy` and requires the `licenses/view` permission.",
        "tags": [
          "Licensing"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The license site ID"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of activations per page (default: 15, min: 1, max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "site": {
                      "type": "object",
                      "description": "The LicenseSite model"
                    },
                    "activations": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "license_id": {
                                "type": "integer"
                              },
                              "license_key": {
                                "type": "string"
                              },
                              "product_id": {
                                "type": "integer",
                                "nullable": true
                              },
                              "product_name": {
                                "type": "string",
                                "description": "Falls back to \"Unknown Product\" when the product is missing"
                              },
                              "variation_title": {
                                "type": "string"
                              },
                              "license_status": {
                                "type": "string"
                              },
                              "activation_status": {
                                "type": "string"
                              },
                              "is_local": {
                                "type": "string"
                              },
                              "last_update_version": {
                                "type": "string",
                                "nullable": true
                              },
                              "last_update_date": {
                                "type": "string",
                                "nullable": true
                              },
                              "customer": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "full_name": {
                                    "type": "string"
                                  },
                                  "email": {
                                    "type": "string"
                                  }
                                }
                              },
                              "order_id": {
                                "type": "integer",
                                "nullable": true
                              },
                              "expiration_date": {
                                "type": "string",
                                "nullable": true
                              },
                              "activation_limit": {
                                "type": "integer",
                                "nullable": true
                              },
                              "activation_count": {
                                "type": "integer",
                                "nullable": true
                              },
                              "created_at": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "total": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "current_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        }
                      }
                    },
                    "customers": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Customer models related to the activations on this site"
                    },
                    "orders": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "Order models related to the activations on this site"
                    }
                  },
                  "example": {
                    "site": {
                      "id": 5,
                      "site_url": "https://customer-site.com",
                      "status": "active",
                      "created_at": "2026-01-10 09:00:00",
                      "updated_at": "2026-06-01 12:00:00"
                    },
                    "activations": {
                      "data": [
                        {
                          "id": 81,
                          "license_id": 1,
                          "license_key": "DTPRO-A1B2-C3D4-E5F6",
                          "product_id": 10,
                          "product_name": "Pro Plugin",
                          "variation_title": "Yearly",
                          "license_status": "active",
                          "activation_status": "active",
                          "is_local": "0",
                          "last_update_version": "1.4.0",
                          "last_update_date": "2026-06-01 12:00:00",
                          "customer": {
                            "id": 7,
                            "full_name": "Jane Doe",
                            "email": "jane@example.com"
                          },
                          "order_id": 42,
                          "expiration_date": "2027-01-10 00:00:00",
                          "activation_limit": 5,
                          "activation_count": 2,
                          "created_at": "2026-01-10 09:00:00"
                        }
                      ],
                      "total": 1,
                      "per_page": 15,
                      "current_page": 1,
                      "last_page": 1
                    },
                    "customers": [
                      {
                        "id": 7,
                        "first_name": "Jane",
                        "last_name": "Doe",
                        "email": "jane@example.com"
                      }
                    ],
                    "orders": [
                      {
                        "id": 42,
                        "status": "completed",
                        "total_amount": 9900
                      }
                    ]
                  }
                },
                "example": {
                  "site": {
                    "id": 5,
                    "site_url": "https://customer-site.com",
                    "status": "active",
                    "created_at": "2026-01-10 09:00:00",
                    "updated_at": "2026-06-01 12:00:00"
                  },
                  "activations": {
                    "data": [
                      {
                        "id": 81,
                        "license_id": 1,
                        "license_key": "DTPRO-A1B2-C3D4-E5F6",
                        "product_id": 10,
                        "product_name": "Pro Plugin",
                        "variation_title": "Yearly",
                        "license_status": "active",
                        "activation_status": "active",
                        "is_local": "0",
                        "last_update_version": "1.4.0",
                        "last_update_date": "2026-06-01 12:00:00",
                        "customer": {
                          "id": 7,
                          "full_name": "Jane Doe",
                          "email": "jane@example.com"
                        },
                        "order_id": 42,
                        "expiration_date": "2027-01-10 00:00:00",
                        "activation_limit": 5,
                        "activation_count": 2,
                        "created_at": "2026-01-10 09:00:00"
                      }
                    ],
                    "total": 1,
                    "per_page": 15,
                    "current_page": 1,
                    "last_page": 1
                  },
                  "customers": [
                    {
                      "id": 7,
                      "first_name": "Jane",
                      "last_name": "Doe",
                      "email": "jane@example.com"
                    }
                  ],
                  "orders": [
                    {
                      "id": 42,
