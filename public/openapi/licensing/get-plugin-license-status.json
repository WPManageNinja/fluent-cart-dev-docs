{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/license": {
      "get": {
        "operationId": "getPluginLicenseStatus",
        "summary": "GET Get Plugin License Status",
        "description": "Retrieve the current activation status of the FluentCart Pro plugin license on this site.\n\n**Permission:** `is_super_admin` (in practice `manage_options`) \u00b7 **Policy:** `AdminPolicy`",
        "tags": [
          "Licensing"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "verify",
            "in": "query",
            "required": false,
            "description": "Re-check the key with the licensing store before answering, so activations removed remotely are reflected. When the store cannot be reached, the last known local status is returned instead.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "license_key": {
                      "type": "string",
                      "example": ""
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "unregistered",
                        "valid",
                        "expired",
                        "error"
                      ],
                      "description": "`unregistered` when no key is stored. `error` when a remote check came back for a license with no stored status.",
                      "example": "unregistered"
                    },
                    "variation_id": {
                      "type": "string",
                      "example": ""
                    },
                    "variation_title": {
                      "type": "string",
                      "example": ""
                    },
                    "expires": {
                      "type": "string",
                      "example": ""
                    },
                    "activation_hash": {
                      "type": "string",
                      "example": ""
                    },
                    "renew_url": {
                      "type": "string",
                      "description": "Only on a `verify` request that reached the store."
                    },
                    "is_expired": {
                      "type": "boolean",
                      "description": "Only on a `verify` request that reached the store."
                    },
                    "error_type": {
                      "type": "string",
                      "description": "Only when the store returned an error type."
                    },
                    "error_message": {
                      "type": "string",
                      "description": "Only alongside `error_type`."
                    }
                  }
                },
                "example": {
                  "license_key": "",
                  "status": "unregistered",
                  "variation_id": "",
                  "variation_title": "",
                  "expires": "",
                  "activation_hash": ""
                },
                "examples": {
                  "unregistered": {
                    "summary": "No license stored on this site",
                    "value": {
                      "license_key": "",
                      "status": "unregistered",
                      "variation_id": "",
                      "variation_title": "",
                      "expires": "",
                      "activation_hash": ""
                    }
                  },
                  "verified": {
                    "summary": "After a verify=1 check that reached the store",
                    "value": {
                      "license_key": "XXXX-XXXX-XXXX-XXXX",
                      "status": "valid",
                      "variation_id": "15",
                      "variation_title": "Agency",
                      "expires": "2027-01-15",
                      "activation_hash": "abc123def456",
                      "renew_url": "https://fluentcart.com/checkout?renew=1",
                      "is_expired": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
