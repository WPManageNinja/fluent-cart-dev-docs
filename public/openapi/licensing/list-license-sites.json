{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/licensing/sites": {
      "get": {
        "operationId": "listLicenseSites",
        "summary": "GET List License Sites",
        "description": "Retrieve a paginated list of every site that has activated a license, enriched with the products licensed there, the owning customers, whether any activation is a local/dev install, and the most recent activation activity.\n\nActivations are batch-loaded per page, so the enrichment costs one extra query regardless of page size.\n\n**Permission:** `licenses/view` · **Policy:** `LicensePolicy`",
        "tags": [
          "Licensing"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination."
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Records per page (default: 10)."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term matched against the site URL."
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Column to sort by."
          },
          {
            "name": "sort_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": "Sort direction."
          },
          {
            "name": "filter_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "advanced"
              ],
              "default": "simple"
            },
            "description": "Filter mode."
          },
          {
            "name": "advanced_filters",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded array of advanced filter groups."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sites": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "site_url": {
                                "type": "string",
                                "description": "Host the license was activated against, stored without a scheme."
                              },
                              "server_version": {
                                "type": "string",
                                "description": "PHP version reported by the remote site."
                              },
                              "platform_version": {
                                "type": "string",
                                "description": "WordPress version reported by the remote site."
                              },
                              "other": {
                                "type": "array",
                                "items": {
                                  "type": "object"
                                },
                                "description": "Additional environment data reported at activation."
                              },
                              "created_at": {
                                "type": "string"
                              },
                              "updated_at": {
                                "type": "string"
                              },
                              "active_licenses_count": {
                                "type": "string",
                                "description": "Number of active licenses on this site."
                              },
                              "products": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "name": {
                                      "type": "string"
                                    },
                                    "variation": {
                                      "type": "string"
                                    }
                                  }
                                },
                                "description": "Distinct products licensed on this site, derived from the site's activations."
                              },
                              "customers": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "description": "Distinct customer full names owning licenses on this site."
                              },
                              "is_local": {
                                "type": "boolean",
                                "description": "`true` when any activation on this site was flagged as a local/dev install."
                              },
                              "last_activity": {
                                "type": "string",
                                "nullable": true,
                                "description": "Most recent `last_update_date` across the site's activations."
                              }
                            }
                          }
                        },
                        "first_page_url": {
                          "type": "string"
                        },
                        "from": {
                          "type": "integer",
                          "nullable": true
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "last_page_url": {
                          "type": "string"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "path": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "to": {
                          "type": "integer",
                          "nullable": true
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "example": {
                    "sites": {
                      "current_page": 1,
                      "data": [
                        {
                          "id": 2480,
                          "site_url": "shop.example.org",
                          "server_version": "8.3.30",
                          "platform_version": "7.0",
                          "other": [],
                          "created_at": "2026-05-29T19:12:38+00:00",
                          "updated_at": "2026-05-29T19:12:38+00:00",
                          "active_licenses_count": "1",
                          "products": [
                            {
                              "name": "FluentCart Pro",
                              "variation": "50 Sites - Lifetime License"
                            }
                          ],
                          "customers": [
                            "Alex Morgan"
                          ],
                          "is_local": false,
                          "last_activity": "2026-05-29 13:12:38"
                        }
                      ],
                      "first_page_url": "https://example.com/wp-json/fluent-cart/v2/licensing/sites?page=1",
                      "from": 1,
                      "last_page": 228,
                      "last_page_url": "https://example.com/wp-json/fluent-cart/v2/licensing/sites?page=228",
                      "links": [],
                      "next_page_url": "https://example.com/wp-json/fluent-cart/v2/licensing/sites?page=2",
                      "path": "https://example.com/wp-json/fluent-cart/v2/licensing/sites",
                      "per_page": 10,
                      "prev_page_url": null,
                      "to": 10,
                      "total": 2273
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the user lacks `licenses/view`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
