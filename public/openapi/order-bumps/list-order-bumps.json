{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/order_bump": {
      "get": {
        "operationId": "listOrderBumps",
        "summary": "GET List Order Bumps",
        "description": "Retrieve a paginated list of order bumps with optional filtering, sorting, and search.\n\n**Permission:** `store/sensitive` · **Policy:** `OrderBumpPolicy`",
        "tags": [
          "Order Bumps"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id"
            },
            "description": "Column to sort by."
          },
          {
            "name": "sort_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "description": "Sort direction."
          },
          {
            "name": "active_view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "draft"
              ]
            },
            "description": "Filter by status tab."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by order bump title or description. Partial matches supported."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination."
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Number of records per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_bumps": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "current_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/OrderBumpListItem"
                          }
                        },
                        "first_page_url": {
                          "type": "string"
                        },
                        "from": {
                          "type": "integer",
                          "nullable": true
                        },
                        "last_page_url": {
                          "type": "string"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "nullable": true
                              },
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            }
                          },
                          "description": "Rendered pagination links, including the `&laquo; Previous` / `Next &raquo;` entries."
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "path": {
                          "type": "string"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true
                        },
                        "to": {
                          "type": "integer",
                          "nullable": true
                        }
                      }
                    }
                  },
                  "example": {
                    "order_bumps": {
                      "total": 5,
                      "per_page": 15,
                      "current_page": 1,
                      "last_page": 1,
                      "data": [
                        {
                          "id": 1,
                          "hash": "a1b2c3d4e5f6...",
                          "parent_id": null,
                          "type": "order_bump",
                          "status": "active",
                          "src_object_id": 42,
                          "src_object_type": null,
                          "title": "Add Extended Warranty",
                          "description": "<p>Protect your purchase with our 2-year warranty plan.</p>",
                          "conditions": {
                            "groups": [
                              [
                                {
                                  "key": "order_items",
                                  "value": [
                                    "45"
                                  ],
                                  "operator": "exist"
                                }
                              ]
                            ],
                            "is_enabled": "no"
                          },
                          "config": {
                            "discount": {
                              "discount_type": "percentage",
                              "discount_amount": 10
                            },
                            "display_conditions_if": "",
                            "call_to_action": "Yes, add warranty!",
                            "allow_coupon": "yes",
                            "enable_coupon": "yes",
                            "free_shipping": "yes"
                          },
                          "priority": 1,
                          "created_at": "2025-06-01 10:00:00",
                          "updated_at": "2025-06-15 14:30:00",
                          "product_variant": {
                            "id": 42,
                            "product_id": 10,
                            "title": "Extended Warranty - 2 Year",
                            "price": 2999,
                            "product": {
                              "id": 10,
                              "title": "Extended Warranty",
                              "status": "publish"
                            }
                          }
                        }
                      ],
                      "first_page_url": "https://example.com/wp-json/fluent-cart/v2/order_bump?page=1",
                      "from": 1,
                      "last_page_url": "https://example.com/wp-json/fluent-cart/v2/order_bump?page=1",
                      "links": [
                        {
                          "url": null,
                          "label": "&laquo; Previous",
                          "active": false
                        },
                        {
                          "url": "https://example.com/wp-json/fluent-cart/v2/order_bump?page=1",
                          "label": "1",
                          "active": true
                        }
                      ],
                      "next_page_url": null,
                      "path": "https://example.com/wp-json/fluent-cart/v2/order_bump",
                      "prev_page_url": null,
                      "to": 5
                    }
                  }
                },
                "example": {
                  "order_bumps": {
                    "total": 5,
                    "per_page": 15,
                    "current_page": 1,
                    "last_page": 1,
                    "data": [
                      {
                        "id": 1,
                        "hash": "a1b2c3d4e5f6...",
                        "parent_id": null,
                        "type": "order_bump",
                        "status": "active",
                        "src_object_id": 42,
                        "src_object_type": null,
                        "title": "Add Extended Warranty",
                        "description": "<p>Protect your purchase with our 2-year warranty plan.</p>",
                        "conditions": [
                          {
                            "type": "cart_products",
                            "operator": "contains",
                            "value": [
                              123,
                              124
                            ]
                          },
                          {
                            "type": "cart_total",
                            "operator": "greater_than",
                            "value": 2500
                          }
                        ],
                        "config": {
                          "discount": {
                            "discount_type": "percentage",
                            "discount_amount": 10
                          },
                          "display_conditions_if": "",
                          "call_to_action": "Yes, add warranty!"
                        },
                        "priority": 1,
                        "created_at": "2025-06-01 10:00:00",
                        "updated_at": "2025-06-15 14:30:00",
                        "product_variant": {
                          "id": 42,
                          "product_id": 10,
                          "title": "Extended Warranty - 2 Year",
                          "price": 2999,
                          "product": {
                            "id": 10,
                            "title": "Extended Warranty",
                            "status": "publish"
                          }
                        }
                      }
                    ]
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "order_bumps": {
                        "total": 5,
                        "per_page": 15,
                        "current_page": 1,
                        "last_page": 1,
                        "data": [
                          {
                            "id": 1,
                            "hash": "a1b2c3d4e5f6...",
                            "parent_id": null,
                            "type": "order_bump",
                            "status": "active",
                            "src_object_id": 42,
                            "src_object_type": null,
                            "title": "Add Extended Warranty",
                            "description": "<p>Protect your purchase with our 2-year warranty plan.</p>",
                            "conditions": [
                              {
                                "type": "cart_products",
                                "operator": "contains",
                                "value": [
                                  123,
                                  124
                                ]
                              },
                              {
                                "type": "cart_total",
                                "operator": "greater_than",
                                "value": 2500
                              }
                            ],
                            "config": {
                              "discount": {
                                "discount_type": "percentage",
                                "discount_amount": 10
                              },
                              "display_conditions_if": "",
                              "call_to_action": "Yes, add warranty!"
                            },
                            "priority": 1,
                            "created_at": "2025-06-01 10:00:00",
                            "updated_at": "2025-06-15 14:30:00",
                            "product_variant": {
                              "id": 42,
                              "product_id": 10,
                              "title": "Extended Warranty - 2 Year",
                              "price": 2999,
                              "product": {
                                "id": 10,
                                "title": "Extended Warranty",
                                "status": "publish"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderBumpListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Auto-increment ID"
          },
          "hash": {
            "type": "string",
            "description": "Auto-generated unique hash identifier"
          },
          "parent_id": {
            "type": "integer",
            "nullable": true,
            "description": "Parent promotion ID"
          },
          "type": {
            "type": "string",
            "description": "Promotion type (always order_bump for this API)"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "draft"
            ],
            "description": "Order bump status"
          },
          "src_object_id": {
            "type": "integer",
            "description": "Product variation ID being offered"
          },
          "src_object_type": {
            "type": "string",
            "nullable": true,
            "description": "Source object type identifier"
          },
          "title": {
            "type": "string",
            "description": "Display title"
          },
          "description": {
            "type": "string",
            "description": "HTML description shown to customers"
          },
          "conditions": {
            "type": "object",
            "nullable": true,
            "description": "Display conditions. Stored as a filter-group structure and passed through unmodified by the API (the request layer does not reshape it).",
            "properties": {
              "is_enabled": {
                "type": "string",
                "description": "`yes` or `no` — whether conditions gate this bump at all."
              },
              "groups": {
                "type": "array",
                "description": "Condition groups. Groups are OR-ed together; conditions within a group are AND-ed.",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "Condition subject, e.g. `order_items`."
                      },
                      "operator": {
                        "type": "string",
                        "description": "Comparison operator, e.g. `exist`."
                      },
                      "value": {
                        "description": "Comparison value — a string or an array depending on `operator`."
                      }
                    }
                  }
                }
              }
            }
          },
          "config": {
            "type": "object",
            "description": "JSON-decoded configuration object",
            "properties": {
              "allow_coupon": {
                "type": "string",
                "description": "`yes`/`no` — allow coupons to apply to the bump product."
              },
              "enable_coupon": {
                "type": "string",
                "description": "`yes`/`no` — show the coupon field on the bump."
              },
              "free_shipping": {
                "type": "string",
                "description": "`yes`/`no` — grant free shipping when the bump is taken."
              }
            }
          },
          "priority": {
            "type": "integer",
            "description": "Display priority ordering"
          },
          "created_at": {
            "type": "string",
            "description": "Creation timestamp (GMT)"
          },
          "updated_at": {
            "type": "string",
            "description": "Last update timestamp (GMT)"
          },
          "product_variant": {
            "type": "object",
            "description": "Associated product variant with parent product",
            "properties": {
              "id": {
                "type": "integer"
              },
              "product_id": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "price": {
                "type": "integer",
                "description": "Price in cents"
              },
              "product": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
