{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/orders/{order}/subscriptions/{subscription}/charge-now": {
      "post": {
        "operationId": "chargeNow",
        "summary": "POST Charge Subscription Now",
        "description": "Run one immediate off-session charge attempt against a subscription's open renewal invoice. Requires a store-billed (manual or auto-charge) subscription that already has a pending or scheduled renewal order. A declined card is returned as HTTP 200 with `status: \"failed\"` — the request itself succeeded, the charge attempt did not; only a state violation (e.g. no open renewal order to charge) returns an error response.\n\n**Required permission:** `subscriptions/manage`",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Parent order ID the subscription belongs to."
          },
          {
            "name": "subscription",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Subscription ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Charge attempt completed (may still report a failed charge in `status`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "subscription": {
                      "type": "object"
                    }
                  },
                  "example": {
                    "status": "success",
                    "message": "Subscription charged successfully.",
                    "subscription": {
                      "id": 15,
                      "customer_id": 12,
                      "parent_order_id": 42,
                      "product_id": 123,
                      "item_name": "Developer Toolkit Pro - Annual License",
                      "variation_id": 456,
                      "billing_interval": "yearly",
                      "recurring_amount": 9900,
                      "recurring_total": 10692,
                      "status": "active",
                      "next_billing_date": "2026-09-20 14:25:00",
                      "created_at": "2025-09-20 14:25:00",
                      "updated_at": "2026-08-18 10:00:00"
                    }
                  }
                },
                "example": {
                  "status": "success",
                  "message": "Subscription charged successfully.",
                  "subscription": {
                    "id": 15,
                    "customer_id": 12,
                    "parent_order_id": 42,
                    "product_id": 123,
                    "item_name": "Developer Toolkit Pro - Annual License",
                    "variation_id": 456,
                    "billing_interval": "yearly",
                    "recurring_amount": 9900,
                    "recurring_total": 10692,
                    "status": "active",
                    "next_billing_date": "2026-09-20 14:25:00",
                    "created_at": "2025-09-20 14:25:00",
                    "updated_at": "2026-08-18 10:00:00"
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "status": "success",
                      "message": "Subscription charged successfully.",
                      "subscription": {
                        "id": 15,
                        "customer_id": 12,
                        "parent_order_id": 42,
                        "product_id": 123,
                        "item_name": "Developer Toolkit Pro - Annual License",
                        "variation_id": 456,
                        "billing_interval": "yearly",
                        "recurring_amount": 9900,
                        "recurring_total": 10692,
                        "status": "active",
                        "next_billing_date": "2026-09-20 14:25:00",
                        "created_at": "2025-09-20 14:25:00",
                        "updated_at": "2026-08-18 10:00:00"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "404": {
            "description": "The 404 fires for whichever route-bound model resolves first: `order` (if the order ID doesn't exist) or `subscription` (if the order exists but the subscription ID doesn't, or doesn't belong to that order). No order matches the given ID. Thrown by the framework's route-model-binding, not an explicit controller check, so the message is generic and names the model class.",
            "content": {
              "application/json": {
                "example": {
                  "message": "No query results for model [FluentCart\\\\App\\\\Models\\\\Order]."
                },
                "schema": {
                  "example": {
                    "message": "No query results for model [FluentCart\\\\App\\\\Models\\\\Order]."
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "No query results for model [FluentCart\\\\App\\\\Models\\\\Order]."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "No open renewal order to charge, or the charge attempt could not be started.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "There is no open renewal order to charge for this subscription."
                  }
                },
                "example": {
                  "message": "There is no open renewal order to charge for this subscription."
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "There is no open renewal order to charge for this subscription."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
