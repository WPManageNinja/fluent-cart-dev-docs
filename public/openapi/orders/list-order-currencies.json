{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/orders/currencies": {
      "get": {
        "operationId": "listOrderCurrencies",
        "summary": "GET List Order Currencies",
        "description": "List the currencies an admin order can be created in, with today's rate for each.\n\n**Required permission:** `orders/create`\n\nThe store currency comes first. The list is empty when Multi-Currency is off or no other currency has a rate; then orders can only be created in the store currency.",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Currencies available for admin orders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "currencies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Currency code"
                          },
                          "sign": {
                            "type": "string",
                            "description": "Currency symbol"
                          },
                          "rate": {
                            "type": "string",
                            "description": "Rate from the store currency, 12 decimal places"
                          },
                          "is_base": {
                            "type": "boolean",
                            "description": "`true` for the store currency"
                          },
                          "rounding": {
                            "type": "string",
                            "description": "Price rounding rule (foreign currencies only)"
                          },
                          "charm": {
                            "type": "string",
                            "description": "Charm pricing rule (foreign currencies only)"
                          },
                          "adjustment": {
                            "type": "string",
                            "description": "Price adjustment (foreign currencies only)"
                          },
                          "decimals": {
                            "type": "integer",
                            "description": "Decimal places of the currency (foreign currencies only)"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Store in USD with EUR enabled",
                    "value": {
                      "currencies": [
                        {
                          "code": "USD",
                          "sign": "$",
                          "rate": "1.000000000000",
                          "is_base": true
                        },
                        {
                          "code": "EUR",
                          "sign": "\u20ac",
                          "rate": "0.920000000000",
                          "is_base": false,
                          "rounding": "none",
                          "charm": "none",
                          "adjustment": "0",
                          "decimals": 2
                        }
                      ]
                    }
                  },
                  "disabled": {
                    "summary": "Multi-Currency off",
                    "value": {
                      "currencies": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`orders/create`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
