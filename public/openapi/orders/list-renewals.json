  "paths": {
    "/renewals": {
      "get": {
        "operationId": "index",
        "summary": "GET List Renewal Invoices",
        "description": "List orders of type `renewal` (subscription renewal invoices), newest first, paginated. Each row includes its customer relation.\n\n**Required permission:** `orders/view`",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "payment_status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by payment status (e.g. paid, pending, failed)."
          },
          {
            "name": "parent_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filter to renewal invoices belonging to a specific parent order ID."
          },
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filter to renewal invoices belonging to a specific customer ID."
          }
        ],
