{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/orders/{order}/subscriptions/{subscription}/skip-renewal": {
      "post": {
        "operationId": "skipRenewal",
        "summary": "POST Skip Next Renewal Period",
        "description": "Advance a store-billed (manual or auto-charge) subscription's `next_billing_date` to the following period without creating or charging a renewal for the current one. Only valid for active or trialing subscriptions with an upcoming billing date. The skip does not stack — if a skip is already pending, or there is nothing left to advance, the request fails.\n\n**Required permission:** `subscriptions/manage`",
        "tags": [
          "Orders"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Parent order ID the subscription belongs to."
          },
          {
            "name": "subscription",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Subscription ID."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Optional note recorded against the skip."
                  }
                },
                "example": {
                  "reason": "Customer requested a one-cycle pause"
                }
              },
              "example": {
                "reason": "Customer requested a one-cycle pause"
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "reason": "Customer requested a one-cycle pause"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Billing period skipped successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "old_next_billing_date": {
                      "type": "string"
                    },
                    "new_next_billing_date": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Billing period has been skipped successfully.",
                  "old_next_billing_date": "2026-09-01 00:00:00",
                  "new_next_billing_date": "2026-10-01 00:00:00"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Billing period has been skipped successfully.",
                      "old_next_billing_date": "2026-09-01 00:00:00",
                      "new_next_billing_date": "2026-10-01 00:00:00"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "404": {
            "description": "The 404 fires for whichever route-bound model resolves first: `order` or `subscription`. No order matches the given ID. Thrown by the framework's route-model-binding, not an explicit controller check, so the message is generic and names the model class.",
            "content": {
              "application/json": {
                "example": {
                  "message": "No query results for model [FluentCart\\\\App\\\\Models\\\\Order]."
                },
                "schema": {
                  "example": {
                    "message": "No query results for model [FluentCart\\\\App\\\\Models\\\\Order]."
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "No query results for model [FluentCart\\\\App\\\\Models\\\\Order]."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "The subscription is not eligible to skip a period right now (wrong billing type, status, no upcoming date, or a skip is already pending).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "The next period could not be skipped. It may have already been skipped."
                  }
                },
                "example": {
                  "message": "The next period could not be skipped. It may have already been skipped."
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "The next period could not be skipped. It may have already been skipped."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
