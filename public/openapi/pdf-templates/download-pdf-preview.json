{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/pdf-templates/download": {
      "post": {
        "operationId": "downloadPdfPreview",
        "summary": "POST Download PDF Preview",
        "description": "Render a **test** PDF for a template and return it base64-encoded — no file is written and no URL is issued; decode `pdf_base64` client-side.\n\nThe sample is built from a real order: the most recent order that has an invoice number, falling back to the most recent order of any kind. The generated file is deleted from disk immediately after encoding.\n\nRequires the Fluent PDF plugin — check `GET /settings/pdf-templates/status` first.\n\n**Permission:** `is_super_admin` (`manage_options`) · **Policy:** `StoreSensitivePolicy`",
        "tags": [
          "PDF Templates"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template_id": {
                    "type": "string",
                    "default": "order_receipt",
                    "description": "Slug of the template to render."
                  }
                },
                "example": {
                  "template_id": "order_receipt"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pdf_base64": {
                      "type": "string",
                      "description": "Base64-encoded PDF bytes."
                    },
                    "filename": {
                      "type": "string",
                      "description": "`{template_id}-{invoice_no}.pdf`."
                    }
                  },
                  "example": {
                    "pdf_base64": "JVBERi0xLjcKJeLjz9MKMSAwIG9iago8PC9UeXBlL0NhdGFsb2c...",
                    "filename": "order_receipt-INV-001042.pdf"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the user is not a super admin.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Fluent PDF is not active, the template does not exist, the store has no orders to sample, or rendering failed. All four return 422 — inspect `message` to tell them apart. Rendering failures are also written to the activity log.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Human-readable error message"
                    }
                  },
                  "example": {
                    "message": "Fluent PDF plugin is not active"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
