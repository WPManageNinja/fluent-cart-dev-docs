{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/pdf-templates/receipt": {
      "get": {
        "operationId": "listPdfTemplates",
        "summary": "GET List PDF Templates",
        "description": "Retrieve every receipt PDF template, merged with the PDF engine status. Legacy templates are migrated to the current block format on read.\n\n**Permission:** `is_super_admin` (`manage_options`) · **Policy:** `StoreSensitivePolicy`",
        "tags": [
          "PDF Templates"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "templates": {
                      "type": "object",
                      "properties": {
                        "order_receipt": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Template slug; matches the key in the `templates` map."
                            },
                            "title": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "is_default": {
                              "type": "boolean",
                              "description": "Built-in templates are `true` and cannot be deleted."
                            },
                            "pdf_settings": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "active": {
                                    "type": "string",
                                    "description": "`yes` or `no`."
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "preview_image": {
                                    "type": "string"
                                  },
                                  "pdf_structure": {
                                    "type": "object",
                                    "properties": {
                                      "content": {
                                        "type": "string",
                                        "description": "Gutenberg block markup using `wp:fluent-cart/receipt-*` blocks, with `{{order.*}}` merge tags."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "renewal_receipt": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Template slug; matches the key in the `templates` map."
                            },
                            "title": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "is_default": {
                              "type": "boolean",
                              "description": "Built-in templates are `true` and cannot be deleted."
                            },
                            "pdf_settings": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "active": {
                                    "type": "string",
                                    "description": "`yes` or `no`."
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "preview_image": {
                                    "type": "string"
                                  },
                                  "pdf_structure": {
                                    "type": "object",
                                    "properties": {
                                      "content": {
                                        "type": "string",
                                        "description": "Gutenberg block markup using `wp:fluent-cart/receipt-*` blocks, with `{{order.*}}` merge tags."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "refund_notice": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Template slug; matches the key in the `templates` map."
                            },
                            "title": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "is_default": {
                              "type": "boolean",
                              "description": "Built-in templates are `true` and cannot be deleted."
                            },
                            "pdf_settings": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "active": {
                                    "type": "string",
                                    "description": "`yes` or `no`."
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "preview_image": {
                                    "type": "string"
                                  },
                                  "pdf_structure": {
                                    "type": "object",
                                    "properties": {
                                      "content": {
                                        "type": "string",
                                        "description": "Gutenberg block markup using `wp:fluent-cart/receipt-*` blocks, with `{{order.*}}` merge tags."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "proforma_invoice": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Template slug; matches the key in the `templates` map."
                            },
                            "title": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "is_default": {
                              "type": "boolean",
                              "description": "Built-in templates are `true` and cannot be deleted."
                            },
                            "pdf_settings": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "active": {
                                    "type": "string",
                                    "description": "`yes` or `no`."
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "preview_image": {
                                    "type": "string"
                                  },
                                  "pdf_structure": {
                                    "type": "object",
                                    "properties": {
                                      "content": {
                                        "type": "string",
                                        "description": "Gutenberg block markup using `wp:fluent-cart/receipt-*` blocks, with `{{order.*}}` merge tags."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "description": "Map keyed by template slug. The four built-ins are `order_receipt`, `renewal_receipt`, `refund_notice` and `proforma_invoice`; custom templates appear alongside them.",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Template slug; matches the key in the `templates` map."
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "is_default": {
                            "type": "boolean",
                            "description": "Built-in templates are `true` and cannot be deleted."
                          },
                          "pdf_settings": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "active": {
                                  "type": "string",
                                  "description": "`yes` or `no`."
                                },
                                "title": {
                                  "type": "string"
                                },
                                "preview_image": {
                                  "type": "string"
                                },
                                "pdf_structure": {
                                  "type": "object",
                                  "properties": {
                                    "content": {
                                      "type": "string",
                                      "description": "Gutenberg block markup using `wp:fluent-cart/receipt-*` blocks, with `{{order.*}}` merge tags."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "has_fluent_pdf": {
                      "type": "boolean",
                      "description": "`true` when the `FLUENT_PDF` constant is defined, i.e. the Fluent PDF plugin is active."
                    },
                    "addon_info": {
                      "type": "object",
                      "nullable": true,
                      "description": "Install/activate state for the Fluent PDF add-on. `null` when Fluent PDF is already active.",
                      "properties": {
                        "plugin_slug": {
                          "type": "string"
                        },
                        "plugin_file": {
                          "type": "string"
                        },
                        "source_type": {
                          "type": "string"
                        },
                        "is_installed": {
                          "type": "boolean"
                        },
                        "is_active": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "example": {
                    "templates": {
                      "order_receipt": {
                        "name": "order_receipt",
                        "title": "Order Receipt",
                        "description": "Default receipt template for paid orders",
                        "is_default": true,
                        "pdf_settings": [
                          {
                            "active": "yes",
                            "title": "Order Receipt",
                            "preview_image": "",
                            "pdf_structure": {
                              "content": "<!-- wp:fluent-cart/receipt-header {\"title\":\"RECEIPT\"} /-->\n\n<!-- wp:fluent-cart/receipt-addresses {\"billingLabel\":\"BILL TO\"} /-->\n\n<!-- wp:fluent-cart/receipt-meta {\"rows\":[{\"label\":\"Order Number\",\"value\":\"{{order.invoice_no}}\"},{\"label\":\"Order Date\",\"value\":\"{{order.created_at}}\"}]} /-->"
                            }
                          }
                        ]
                      },
                      "renewal_receipt": {
                        "name": "renewal_receipt",
                        "title": "Renewal Receipt",
                        "description": "Receipt sent for subscription renewals",
                        "is_default": true,
                        "pdf_settings": [
                          {
                            "active": "yes",
                            "title": "Order Receipt",
                            "preview_image": "",
                            "pdf_structure": {
                              "content": "<!-- wp:fluent-cart/receipt-header {\"title\":\"RECEIPT\"} /-->\n\n<!-- wp:fluent-cart/receipt-addresses {\"billingLabel\":\"BILL TO\"} /-->\n\n<!-- wp:fluent-cart/receipt-meta {\"rows\":[{\"label\":\"Order Number\",\"value\":\"{{order.invoice_no}}\"},{\"label\":\"Order Date\",\"value\":\"{{order.created_at}}\"}]} /-->"
                            }
                          }
                        ]
                      },
                      "refund_notice": {
                        "name": "refund_notice",
                        "title": "Refund Notice",
                        "description": "Notice sent when an order is refunded",
                        "is_default": true,
                        "pdf_settings": [
                          {
                            "active": "yes",
                            "title": "Order Receipt",
                            "preview_image": "",
                            "pdf_structure": {
                              "content": "<!-- wp:fluent-cart/receipt-header {\"title\":\"RECEIPT\"} /-->\n\n<!-- wp:fluent-cart/receipt-addresses {\"billingLabel\":\"BILL TO\"} /-->\n\n<!-- wp:fluent-cart/receipt-meta {\"rows\":[{\"label\":\"Order Number\",\"value\":\"{{order.invoice_no}}\"},{\"label\":\"Order Date\",\"value\":\"{{order.created_at}}\"}]} /-->"
                            }
                          }
                        ]
                      },
                      "proforma_invoice": {
                        "name": "proforma_invoice",
                        "title": "Proforma Invoice",
                        "description": "Proforma invoice issued before payment",
                        "is_default": true,
                        "pdf_settings": [
                          {
                            "active": "yes",
                            "title": "Order Receipt",
                            "preview_image": "",
                            "pdf_structure": {
                              "content": "<!-- wp:fluent-cart/receipt-header {\"title\":\"RECEIPT\"} /-->\n\n<!-- wp:fluent-cart/receipt-addresses {\"billingLabel\":\"BILL TO\"} /-->\n\n<!-- wp:fluent-cart/receipt-meta {\"rows\":[{\"label\":\"Order Number\",\"value\":\"{{order.invoice_no}}\"},{\"label\":\"Order Date\",\"value\":\"{{order.created_at}}\"}]} /-->"
                            }
                          }
                        ]
                      }
                    },
                    "has_fluent_pdf": false,
                    "addon_info": {
                      "plugin_slug": "fluentforms-pdf",
                      "plugin_file": "fluentforms-pdf/fluentforms-pdf.php",
                      "source_type": "wordpress",
                      "is_installed": false,
                      "is_active": false
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — the user is not a super admin.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
