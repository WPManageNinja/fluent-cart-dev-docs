{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/products/fetchVariationsByIds": {
      "get": {
        "operationId": "fetchVariationsByIds",
        "summary": "GET Fetch Variations by IDs",
        "description": "Retrieve variations by an array of IDs. Returns simplified label/value pairs.\n\n**Required permission:** `products/view`",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "productIds[]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Array of variation IDs to fetch",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "products": [
                    {
                      "value": 456,
                      "label": "Developer Toolkit Pro - Personal License ($49.00)"
                    },
                    {
                      "value": 457,
                      "label": "Developer Toolkit Pro - Business License - Annual ($99.00/yr)"
                    }
                  ]
                },
                "schema": {
                  "example": {
                    "products": [
                      {
                        "value": 456,
                        "label": "Developer Toolkit Pro - Personal License ($49.00)"
                      },
                      {
                        "value": 457,
                        "label": "Developer Toolkit Pro - Business License - Annual ($99.00/yr)"
                      }
                    ]
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "products": [
                        {
                          "value": 456,
                          "label": "Developer Toolkit Pro - Personal License ($49.00)"
                        },
                        {
                          "value": 457,
                          "label": "Developer Toolkit Pro - Business License - Annual ($99.00/yr)"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`products/view`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
