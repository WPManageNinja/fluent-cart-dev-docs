  "paths": {
    "/products/{product}": {
      "get": {
        "operationId": "getProduct",
        "summary": "GET Get Product",
        "description": "Retrieve a single product by ID.\n\n**Required permission:** `products/view`",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "schema": {
              "type": "integer"
            },
            "description": "The product ID",
            "required": true
          },
          {
            "name": "with[]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Relations to eager load (e.g., detail, variants, product_menu)",
            "required": false
          }
