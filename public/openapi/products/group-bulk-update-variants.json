{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/products/variants/group-bulk-update": {
      "post": {
        "operationId": "groupBulkUpdate",
        "summary": "POST Group Bulk Update Variants",
        "description": "Apply a partial (PATCH-style) update to a group of product variants at once. Any field left null or omitted in the payload is skipped for every variant in the group; only the provided non-null fields are written. For `other_info`, only the supplied non-null sub-keys are merged into each variant's existing JSON rather than replacing it outright. All variants in `variant_ids` must belong to the same product, and `sku` can only be set when exactly one variant is targeted (SKUs must stay unique).\n\n**Required permission:** `products/edit`",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "variant_ids"
                ],
                "properties": {
                  "variant_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "IDs of the variants to update. All must belong to the same product."
                  },
                  "sku": {
                    "type": "string",
                    "maxLength": 30,
                    "nullable": true,
                    "description": "New SKU. Only accepted when variant_ids contains exactly one ID. An empty string clears the SKU. Must be unique."
                  },
                  "item_price": {
                    "type": "number",
                    "description": "New sale price in cents, applied to every targeted variant."
                  },
                  "compare_price": {
                    "type": "number",
                    "description": "New compare-at price in cents. Ignored per-row if it would be less than the effective item_price for that row."
                  },
                  "manage_stock": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "Whether to track stock for the targeted variants."
                  },
                  "total_stock": {
                    "type": "integer",
                    "description": "New total stock quantity."
                  },
                  "fulfillment_type": {
                    "type": "string",
                    "enum": [
                      "physical",
                      "digital"
                    ],
                    "description": "New fulfillment type."
                  },
                  "manage_cost": {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ],
                    "description": "Whether to track cost of goods for the targeted variants."
                  },
                  "item_cost": {
                    "type": "number",
                    "description": "New cost of goods in cents."
                  },
                  "other_info": {
                    "type": "object",
                    "description": "Partial delta merged into each variant's existing other_info JSON (e.g. payment_type, repeat_interval, signup_fee). Only non-null sub-keys are applied. signup_fee, when present, is also in cents."
                  }
                },
                "example": {
                  "variant_ids": [
                    456,
                    457
                  ],
                  "item_price": 8900,
                  "manage_stock": 1,
                  "total_stock": 50
                }
              },
              "example": {
                "variant_ids": [
                  456,
                  457
                ],
                "item_price": 8900,
                "manage_stock": 1,
                "total_stock": 50
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "variant_ids": [
                      456,
                      457
                    ],
                    "item_price": 8900,
                    "manage_stock": 1,
                    "total_stock": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Variants updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "updated": {
                      "type": "integer"
                    }
                  },
                  "example": {
                    "message": "2 variants updated successfully.",
                    "updated": 2
                  }
                },
                "example": {
                  "message": "2 variants updated successfully.",
                  "updated": 2
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "2 variants updated successfully.",
                      "updated": 2
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 401
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 401
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The current user lacks the products/edit permission.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                },
                "schema": {
                  "example": {
                    "code": "rest_forbidden",
                    "message": "Sorry, you are not allowed to do that.",
                    "data": {
                      "status": 403
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "code": "rest_forbidden",
                      "message": "Sorry, you are not allowed to do that.",
                      "data": {
                        "status": 403
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "One or more variant IDs do not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "One or more variant IDs do not exist."
                },
                "schema": {
                  "example": {
                    "message": "One or more variant IDs do not exist."
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "One or more variant IDs do not exist."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "No valid variant IDs/updates provided, variants span more than one product, or a subscription variant is missing a billing interval.",
            "content": {
              "application/json": {
                "example": {
                  "message": "All variants must belong to the same product."
                },
                "schema": {
                  "example": {
                    "message": "All variants must belong to the same product."
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "All variants must belong to the same product."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
