{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/products/{product_id}/integrations": {
      "post": {
        "operationId": "saveProductIntegration",
        "summary": "POST Save Product Integration",
        "description": "Create or update an integration feed for a product.\n\n**Also used by the integrations UI.** Create a new product-level integration feed or update an existing one. Validates required fields and associates the feed with the specified product.\n\n**Required permission:** `products/edit`",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "schema": {
              "type": "integer"
            },
            "description": "The product ID",
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "integration_name",
                  "integration"
                ],
                "properties": {
                  "integration_name": {
                    "type": "string",
                    "description": "Integration provider name"
                  },
                  "integration_id": {
                    "type": "integer",
                    "description": "Existing feed ID (for updates)"
                  },
                  "integration": {
                    "type": "string",
                    "description": "JSON-encoded integration settings object"
                  }
                },
                "example": {
                  "integration_name": "fluentcrm",
                  "integration": "{\"name\":\"Add to List\",\"list_id\":1,\"enabled\":\"yes\"}"
                }
              },
              "example": {
                "integration_name": "fluentcrm",
                "integration": "{\"name\":\"Add to List\",\"list_id\":1,\"enabled\":\"yes\"}"
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "integration_name": "fluentcrm",
                    "integration": "{\"name\":\"Add to List\",\"list_id\":1,\"enabled\":\"yes\"}"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Integration has been successfully saved",
                  "integration_id": 10,
                  "integration_name": "fluentcrm",
                  "created": true,
                  "feedData": {
                    "id": 10,
                    "name": "Add to List",
                    "list_id": 1,
                    "tag_ids": [
                      5,
                      8
                    ],
                    "conditional_variation_ids": [],
                    "enabled": "yes",
                    "provider": "fluentcrm",
                    "scope": "product"
                  }
                },
                "schema": {
                  "example": {
                    "message": "Integration has been successfully saved",
                    "integration_id": 10,
                    "integration_name": "fluentcrm",
                    "created": true,
                    "feedData": {
                      "id": 10,
                      "name": "Add to List",
                      "list_id": 1,
                      "tag_ids": [
                        5,
                        8
                      ],
                      "conditional_variation_ids": [],
                      "enabled": "yes",
                      "provider": "fluentcrm",
                      "scope": "product"
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Integration has been successfully saved",
                      "integration_id": 10,
                      "integration_name": "fluentcrm",
                      "created": true,
                      "feedData": {
                        "id": 10,
                        "name": "Add to List",
                        "list_id": 1,
                        "tag_ids": [
                          5,
                          8
                        ],
                        "conditional_variation_ids": [],
                        "enabled": "yes",
                        "provider": "fluentcrm",
                        "scope": "product"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "Product not found"
                  }
                },
                "example": {
                  "message": "Product not found"
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Product not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "example": {
                    "message": "Please fill up the required fields:",
                    "errors": {
                      "name": "Feed Name is required."
                    }
                  }
                },
                "example": {
                  "message": "Please fill up the required fields:",
                  "errors": {
                    "name": "Feed Name is required."
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Please fill up the required fields:",
                      "errors": {
                        "name": "Feed Name is required."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`products/edit`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
