  "paths": {
    "/products/searchProductByName": {
      "get": {
        "operationId": "searchProductsByName",
        "summary": "GET Search Products by Name",
        "description": "Search for published products by name. Returns products formatted for select dropdowns.\n\n**Required permission:** `products/view`",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Product name to search for",
            "required": false
          },
          {
            "name": "url_mode",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "URL mode flag",
            "required": false
          },
          {
            "name": "termId",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by taxonomy term ID (product-categories)",
            "required": false
          }
        ],
