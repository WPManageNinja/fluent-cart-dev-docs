{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/country-heat-map": {
      "get": {
        "operationId": "getCountryHeatMap",
        "summary": "GET Get Country Heat Map",
        "description": "Returns the number of orders per billing country, smallest first. It counts every order with a billing address, of any status, in all currencies, over all time.\n\nThe endpoint reads `params[currency]` but does not apply it. A country code that is not in the store's country list returns `country_code: null` and the name \"Uncategorized\".\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "countryHeatMap": [
                      {
                        "country_code": "GB",
                        "name": "United Kingdom",
                        "value": 20
                      },
                      {
                        "country_code": "US",
                        "name": "United States (US)",
                        "value": 85
                      }
                    ]
                  }
                },
                "example": {
                  "countryHeatMap": [
                    {
                      "country_code": "GB",
                      "name": "United Kingdom",
                      "value": 20
                    },
                    {
                      "country_code": "US",
                      "name": "United States (US)",
                      "value": 85
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "countryHeatMap": [
                        {
                          "country_code": "GB",
                          "name": "United Kingdom",
                          "value": 20
                        },
                        {
                          "country_code": "US",
                          "name": "United States (US)",
                          "value": 85
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
