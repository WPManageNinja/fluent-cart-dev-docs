{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/customer-insights": {
      "get": {
        "operationId": "getCustomerInsights",
        "summary": "GET Get Customer Insights",
        "description": "Returns repeat rates, lifetime value and the top 100 customers by lifetime net, for customers with an order in the range. Amounts are decimal currency units; net figures are the Revenue report's net sales.\n\nA customer's history is every order with a report payment status (paid, partially paid, refunded, partially refunded) up to the range end, in the report currency. `repeat_any` counts customers with two or more orders of any type; `repeat_new` counts two or more purchases (one-time or new subscription). `range_net` is the net of orders from the range start. This endpoint reads only the date range and currency: `filterMode`, `variation_ids` and comparison params have no effect.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "summary": {
                      "customers": 80,
                      "repeat_any": 30,
                      "repeat_any_rate": 37.5,
                      "repeat_new": 12,
                      "repeat_new_rate": 15.0,
                      "lifetime_net": 6000.0,
                      "average_ltv": 75.0,
                      "range_net": 2200.0,
                      "average_range_net": 27.5
                    },
                    "top_customers": [
                      {
                        "customer_id": 7,
                        "name": "Jane Doe",
                        "email": "jane@example.com",
                        "orders": 6,
                        "renewals": 4,
                        "lifetime_net": 400.0,
                        "range_net": 50.0,
                        "first_order_at": "2023-03-01 09:00:00",
                        "last_order_at": "2025-01-15 12:00:00"
                      }
                    ]
                  }
                },
                "example": {
                  "summary": {
                    "customers": 80,
                    "repeat_any": 30,
                    "repeat_any_rate": 37.5,
                    "repeat_new": 12,
                    "repeat_new_rate": 15.0,
                    "lifetime_net": 6000.0,
                    "average_ltv": 75.0,
                    "range_net": 2200.0,
                    "average_range_net": 27.5
                  },
                  "top_customers": [
                    {
                      "customer_id": 7,
                      "name": "Jane Doe",
                      "email": "jane@example.com",
                      "orders": 6,
                      "renewals": 4,
                      "lifetime_net": 400.0,
                      "range_net": 50.0,
                      "first_order_at": "2023-03-01 09:00:00",
                      "last_order_at": "2025-01-15 12:00:00"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "summary": {
                        "customers": 80,
                        "repeat_any": 30,
                        "repeat_any_rate": 37.5,
                        "repeat_new": 12,
                        "repeat_new_rate": 15.0,
                        "lifetime_net": 6000.0,
                        "average_ltv": 75.0,
                        "range_net": 2200.0,
                        "average_range_net": 27.5
                      },
                      "top_customers": [
                        {
                          "customer_id": 7,
                          "name": "Jane Doe",
                          "email": "jane@example.com",
                          "orders": 6,
                          "renewals": 4,
                          "lifetime_net": 400.0,
                          "range_net": 50.0,
                          "first_order_at": "2023-03-01 09:00:00",
                          "last_order_at": "2025-01-15 12:00:00"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
