{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/dashboard-stats": {
      "get": {
        "operationId": "getDashboardStats",
        "summary": "GET Get Dashboard Stats",
        "description": "Returns four order tiles for a date range and for the previous period of the same length: all orders, paid orders, paid order items and paid order value. The paid order value is in cents.\n\n\"Paid\" means the report statuses: paid, partially paid, refunded and partially refunded. The order value is `SUM(total_paid)`, not net sales. With no dates the range runs from the first order to today. One currency only: the base currency when `params[currency]` is empty. The admin Orders page stat bar reads this endpoint; the Dashboard page tiles come from `GET /dashboard/stats`.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First store day of the range (Y-m-d).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last store day of the range (Y-m-d).",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. Defaults to the base currency. `__all__` is not supported.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "dashBoardStats": {
                      "total_orders": {
                        "title": "All Orders",
                        "icon": "AllOrdersIcon",
                        "current_count": 150,
                        "compare_count": 120
                      },
                      "paid_orders": {
                        "title": "Paid Orders",
                        "icon": "Money",
                        "current_count": 140,
                        "compare_count": 110
                      },
                      "total_paid_order_items": {
                        "title": "Paid Order Items",
                        "icon": "OrderItemsIcon",
                        "current_count": 210,
                        "compare_count": 180
                      },
                      "total_paid_amounts": {
                        "title": "Order Value (Paid)",
                        "icon": "OrderValueIcon",
                        "current_count": 1250000,
                        "compare_count": 1000000,
                        "is_cents": true
                      }
                    }
                  }
                },
                "example": {
                  "dashBoardStats": {
                    "total_orders": {
                      "title": "All Orders",
                      "icon": "AllOrdersIcon",
                      "current_count": 150,
                      "compare_count": 120
                    },
                    "paid_orders": {
                      "title": "Paid Orders",
                      "icon": "Money",
                      "current_count": 140,
                      "compare_count": 110
                    },
                    "total_paid_order_items": {
                      "title": "Paid Order Items",
                      "icon": "OrderItemsIcon",
                      "current_count": 210,
                      "compare_count": 180
                    },
                    "total_paid_amounts": {
                      "title": "Order Value (Paid)",
                      "icon": "OrderValueIcon",
                      "current_count": 1250000,
                      "compare_count": 1000000,
                      "is_cents": true
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "dashBoardStats": {
                        "total_orders": {
                          "title": "All Orders",
                          "icon": "AllOrdersIcon",
                          "current_count": 150,
                          "compare_count": 120
                        },
                        "paid_orders": {
                          "title": "Paid Orders",
                          "icon": "Money",
                          "current_count": 140,
                          "compare_count": 110
                        },
                        "total_paid_order_items": {
                          "title": "Paid Order Items",
                          "icon": "OrderItemsIcon",
                          "current_count": 210,
                          "compare_count": 180
                        },
                        "total_paid_amounts": {
                          "title": "Order Value (Paid)",
                          "icon": "OrderValueIcon",
                          "current_count": 1250000,
                          "compare_count": 1000000,
                          "is_cents": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
