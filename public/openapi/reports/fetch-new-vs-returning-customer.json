{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/fetch-new-vs-returning-customer": {
      "get": {
        "operationId": "getNewVsReturningCustomer",
        "summary": "GET Get New vs Returning Customers",
        "description": "Splits the period's orders by customer type: New, Returning, Renewal, Installment payment, Free order and Guest. Amounts are decimal currency units; `net_sales` is the Revenue report's net sales.\n\nEach order gets one type, checked in this order: a renewal (`Installment payment` for an installment plan, else `Renewal`), `Guest` (no customer), `Free order` (nothing paid), `New` (the customer's first paid purchase), else `Returning`. `Installment payment` and `Free order` rows appear only when such orders exist. `customer_count` counts distinct customers inside one row, so a customer can appear in both `New` and `Returning`.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Only live or only test orders. Without it, both count.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain these variation IDs.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Only these sale types. `renewal` leaves out installment payments.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "newVsReturning": [
                      {
                        "customer_type": "New",
                        "customer_count": 20,
                        "order_count": 20,
                        "gross_sales": 1000.0,
                        "net_sales": 900.0,
                        "average_gross": 50.0,
                        "average_net": 45.0
                      },
                      {
                        "customer_type": "Returning",
                        "customer_count": 8,
                        "order_count": 10,
                        "gross_sales": 500.0,
                        "net_sales": 450.0,
                        "average_gross": 50.0,
                        "average_net": 45.0
                      },
                      {
                        "customer_type": "Renewal",
                        "customer_count": 15,
                        "order_count": 15,
                        "gross_sales": 750.0,
                        "net_sales": 700.0,
                        "average_gross": 50.0,
                        "average_net": 46.67
                      },
                      {
                        "customer_type": "Guest",
                        "customer_count": 0,
                        "order_count": 0,
                        "gross_sales": 0,
                        "net_sales": 0,
                        "average_gross": 0,
                        "average_net": 0
                      }
                    ]
                  }
                },
                "example": {
                  "newVsReturning": [
                    {
                      "customer_type": "New",
                      "customer_count": 20,
                      "order_count": 20,
                      "gross_sales": 1000.0,
                      "net_sales": 900.0,
                      "average_gross": 50.0,
                      "average_net": 45.0
                    },
                    {
                      "customer_type": "Returning",
                      "customer_count": 8,
                      "order_count": 10,
                      "gross_sales": 500.0,
                      "net_sales": 450.0,
                      "average_gross": 50.0,
                      "average_net": 45.0
                    },
                    {
                      "customer_type": "Renewal",
                      "customer_count": 15,
                      "order_count": 15,
                      "gross_sales": 750.0,
                      "net_sales": 700.0,
                      "average_gross": 50.0,
                      "average_net": 46.67
                    },
                    {
                      "customer_type": "Guest",
                      "customer_count": 0,
                      "order_count": 0,
                      "gross_sales": 0,
                      "net_sales": 0,
                      "average_gross": 0,
                      "average_net": 0
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "newVsReturning": [
                        {
                          "customer_type": "New",
                          "customer_count": 20,
                          "order_count": 20,
                          "gross_sales": 1000.0,
                          "net_sales": 900.0,
                          "average_gross": 50.0,
                          "average_net": 45.0
                        },
                        {
                          "customer_type": "Returning",
                          "customer_count": 8,
                          "order_count": 10,
                          "gross_sales": 500.0,
                          "net_sales": 450.0,
                          "average_gross": 50.0,
                          "average_net": 45.0
                        },
                        {
                          "customer_type": "Renewal",
                          "customer_count": 15,
                          "order_count": 15,
                          "gross_sales": 750.0,
                          "net_sales": 700.0,
                          "average_gross": 50.0,
                          "average_net": 46.67
                        },
                        {
                          "customer_type": "Guest",
                          "customer_count": 0,
                          "order_count": 0,
                          "gross_sales": 0,
                          "net_sales": 0,
                          "average_gross": 0,
                          "average_net": 0
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
