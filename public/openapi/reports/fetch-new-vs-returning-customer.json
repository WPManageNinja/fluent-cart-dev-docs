{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/fetch-new-vs-returning-customer": {
      "get": {
        "operationId": "getNewVsReturningCustomer",
        "summary": "GET Get New vs Returning Customers",
        "description": "Compare orders from new customers versus returning customers over the given period.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "monthly",
                "yearly",
                "billing_country",
                "shipping_country",
                "payment_method",
                "payment_status"
              ]
            },
            "description": "Grouping interval for data aggregation.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "Currency code to filter by.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Payment mode filter.",
            "required": false
          },
          {
            "name": "params[variation_ids]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Array of product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period type.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Custom comparison start date. Required when compareType is custom.",
            "required": false
          },
          {
            "name": "params[paymentStatus]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Payment status filter.",
            "required": false
          },
          {
            "name": "params[orderTypes]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Order type filter (e.g., one-time, subscription).",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "newVsReturning": {
                      "type": "array",
                      "description": "Two rows: one for new customers, one for returning customers.",
                      "items": {
                        "$ref": "#/components/schemas/NewVsReturningRow"
                      }
                    }
                  },
                  "example": {
                    "newVsReturning": [
                      {
                        "customer_type": "new",
                        "customer_count": 32,
                        "order_count": 38,
                        "net_sales": 261500,
                        "average_net": 6882,
                        "gross_sales": 285000,
                        "average_gross": 7500
                      },
                      {
                        "customer_type": "returning",
                        "customer_count": 183,
                        "order_count": 304,
                        "net_sales": 889000,
                        "average_net": 2924,
                        "gross_sales": 965000,
                        "average_gross": 3174
                      }
                    ]
                  }
                },
                "example": {
                  "newVsReturning": [
                    {
                      "customer_type": "new",
                      "customer_count": 32,
                      "order_count": 38,
                      "net_sales": 261500,
                      "average_net": 6882,
                      "gross_sales": 285000,
                      "average_gross": 7500
                    },
                    {
                      "customer_type": "returning",
                      "customer_count": 183,
                      "order_count": 304,
                      "net_sales": 889000,
                      "average_net": 2924,
                      "gross_sales": 965000,
                      "average_gross": 3174
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "newVsReturning": [
                        {
                          "customer_type": "new",
                          "customer_count": 32,
                          "order_count": 38,
                          "net_sales": 261500,
                          "average_net": 6882,
                          "gross_sales": 285000,
                          "average_gross": 7500
                        },
                        {
                          "customer_type": "returning",
                          "customer_count": 183,
                          "order_count": 304,
                          "net_sales": 889000,
                          "average_net": 2924,
                          "gross_sales": 965000,
                          "average_gross": 3174
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewVsReturningRow": {
        "type": "object",
        "properties": {
          "customer_type": {
            "type": "string",
            "enum": [
              "new",
              "returning"
            ],
            "description": "Which segment this row describes",
            "example": "new"
          },
          "customer_count": {
            "type": "integer",
            "description": "Number of distinct customers in this segment for the period",
            "example": 32
          },
          "order_count": {
            "type": "integer",
            "description": "Number of orders placed by this segment for the period",
            "example": 38
          },
          "net_sales": {
            "type": "integer",
            "description": "Net sales in cents (after discounts/refunds, excluding tax) for this segment",
            "example": 261500
          },
          "average_net": {
            "type": "integer",
            "description": "Average net sales per order, in cents",
            "example": 6882
          },
          "gross_sales": {
            "type": "integer",
            "description": "Gross sales in cents for this segment",
            "example": 285000
          },
          "average_gross": {
            "type": "integer",
            "description": "Average gross sales per order, in cents",
            "example": 7500
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
