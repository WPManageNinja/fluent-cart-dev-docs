                      "Wednesday": 0,
                      "Thursday": 25,
                      "Friday": 0,
                      "Saturday": 0
                    },
                    {
                      "hour": "2 PM",
                      "Sunday": 0,
                      "Monday": 22,
                      "Tuesday": 0,
                      "Wednesday": 19,
                      "Thursday": 0,
                      "Friday": 0,
                      "Saturday": 0
                    }
                  ],
                  "grossSaleByDay": [
                    {
                      "day": 1,
                      "gross_sale": 542.0,
                      "order_count": 8
                    },
                    {
                      "day": 2,
                      "gross_sale": 1284.5,
                      "order_count": 21
                    },
                    {
                      "day": 3,
                      "gross_sale": 998.0,
                      "order_count": 16
                    }
                  ],
                  "grossSaleByHour": [
                    {
                      "hour": "9 AM",
                      "gross_sale": 320.0,
                      "order_count": 5
                    },
                    {
                      "hour": "10 AM",
                      "gross_sale": 610.0,
                      "order_count": 9
                    },
                    {
                      "hour": "2 PM",
                      "gross_sale": 415.0,
                      "order_count": 6
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "orderByDayAndHour": [
                        {
                          "hour": "9 AM",
                          "Sunday": 0,
                          "Monday": 18,
                          "Tuesday": 12,
                          "Wednesday": 15,
                          "Thursday": 0,
                          "Friday": 0,
                          "Saturday": 0
                        },
                        {
                          "hour": "10 AM",
                          "Sunday": 0,
                          "Monday": 24,
                          "Tuesday": 28,
                          "Wednesday": 0,
                          "Thursday": 25,
                          "Friday": 0,
                          "Saturday": 0
                        },
                        {
                          "hour": "2 PM",
                          "Sunday": 0,
                          "Monday": 22,
                          "Tuesday": 0,
                          "Wednesday": 19,
                          "Thursday": 0,
                          "Friday": 0,
                          "Saturday": 0
                        }
                      ],
                      "grossSaleByDay": [
                        {
                          "day": 1,
                          "gross_sale": 542.0,
                          "order_count": 8
                        },
                        {
                          "day": 2,
