{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/fetch-report-by-day-and-hour": {
      "get": {
        "operationId": "getReportByDayAndHour",
        "summary": "GET Get Report by Day and Hour",
        "description": "Groups the orders in the range by weekday and hour of the store's local time. `gross_sale` is the sum of `total_paid` in decimal currency units (not cents), before refunds.\n\n**Requires FluentCart Pro.** Without Pro this route is not registered and returns 404.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range (Y-m-d), store timezone.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range (Y-m-d), store timezone.",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code, or `__all__` for all currencies converted to the base currency. Default: the base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Live or test orders only. Default: both.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain one of these variation IDs.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Sale types to include. Default: all.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "orderByDayAndHour": [
                      {
                        "hour": "12 AM",
                        "Sunday": 0,
                        "Monday": 2,
                        "Tuesday": 1,
                        "Wednesday": 0,
                        "Thursday": 3,
                        "Friday": 1,
                        "Saturday": 0
                      }
                    ],
                    "grossSaleByDay": [
                      {
                        "day": 1,
                        "gross_sale": 450.0,
                        "order_count": 5
                      },
                      {
                        "day": 0,
                        "gross_sale": 0,
                        "order_count": 0
                      }
                    ],
                    "grossSaleByHour": [
                      {
                        "hour": "12 AM",
                        "gross_sale": 320.0,
                        "order_count": 7
                      }
                    ]
                  }
                },
                "example": {
                  "orderByDayAndHour": [
                    {
                      "hour": "12 AM",
                      "Sunday": 0,
                      "Monday": 2,
                      "Tuesday": 1,
                      "Wednesday": 0,
                      "Thursday": 3,
                      "Friday": 1,
                      "Saturday": 0
                    }
                  ],
                  "grossSaleByDay": [
                    {
                      "day": 1,
                      "gross_sale": 450.0,
                      "order_count": 5
                    },
                    {
                      "day": 0,
                      "gross_sale": 0,
                      "order_count": 0
                    }
                  ],
                  "grossSaleByHour": [
                    {
                      "hour": "12 AM",
                      "gross_sale": 320.0,
                      "order_count": 7
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "orderByDayAndHour": [
                        {
                          "hour": "12 AM",
                          "Sunday": 0,
                          "Monday": 2,
                          "Tuesday": 1,
                          "Wednesday": 0,
                          "Thursday": 3,
                          "Friday": 1,
                          "Saturday": 0
                        }
                      ],
                      "grossSaleByDay": [
                        {
                          "day": 1,
                          "gross_sale": 450.0,
                          "order_count": 5
                        },
                        {
                          "day": 0,
                          "gross_sale": 0,
                          "order_count": 0
                        }
                      ],
                      "grossSaleByHour": [
                        {
                          "hour": "12 AM",
                          "gross_sale": 320.0,
                          "order_count": 7
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
