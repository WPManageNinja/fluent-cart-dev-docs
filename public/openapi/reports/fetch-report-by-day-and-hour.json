{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/fetch-report-by-day-and-hour": {
      "get": {
        "operationId": "getReportByDayAndHour",
        "summary": "GET Get Report by Day and Hour",
        "description": "Retrieve a heatmap-style report showing order distribution by day of the week and hour of the day.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "monthly",
                "yearly",
                "billing_country",
                "shipping_country",
                "payment_method",
                "payment_status"
              ]
            },
            "description": "Grouping interval for data aggregation.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "Currency code to filter by.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Payment mode filter.",
            "required": false
          },
          {
            "name": "params[variation_ids]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Array of product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period type.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Custom comparison start date. Required when compareType is custom.",
            "required": false
          },
          {
            "name": "params[paymentStatus]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Payment status filter.",
            "required": false
          },
          {
            "name": "params[orderTypes]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Order type filter (e.g., one-time, subscription).",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Order distribution and gross sales broken down by day of week and hour of day.",
                  "properties": {
                    "orderByDayAndHour": {
                      "type": "array",
                      "description": "One row per hour of the day (24 rows), with an order count per day of the week.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hour": {
                            "type": "string",
                            "description": "Hour label, e.g. `9 AM`."
                          },
                          "Sunday": {
                            "type": "integer"
                          },
                          "Monday": {
                            "type": "integer"
                          },
                          "Tuesday": {
                            "type": "integer"
                          },
                          "Wednesday": {
                            "type": "integer"
                          },
                          "Thursday": {
                            "type": "integer"
                          },
                          "Friday": {
                            "type": "integer"
                          },
                          "Saturday": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "grossSaleByDay": {
                      "type": "array",
                      "description": "One row per day of the week (1=Sunday ... 7=Saturday) with gross sale totals.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "day": {
                            "type": "integer",
                            "description": "Day of week, 1=Sunday through 7=Saturday."
                          },
                          "gross_sale": {
                            "type": "number",
                            "description": "Gross sale total for the day, in major currency units (e.g. dollars)."
                          },
                          "order_count": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "grossSaleByHour": {
                      "type": "array",
                      "description": "One row per hour of the day (24 rows) with gross sale totals.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hour": {
                            "type": "string",
                            "description": "Hour label, e.g. `9 AM`."
                          },
                          "gross_sale": {
                            "type": "number",
                            "description": "Gross sale total for the hour, in major currency units (e.g. dollars)."
                          },
                          "order_count": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "orderByDayAndHour": [
                      {
                        "hour": "9 AM",
                        "Sunday": 0,
                        "Monday": 18,
                        "Tuesday": 12,
                        "Wednesday": 15,
                        "Thursday": 0,
                        "Friday": 0,
                        "Saturday": 0
                      },
                      {
                        "hour": "10 AM",
                        "Sunday": 0,
                        "Monday": 24,
                        "Tuesday": 28,
                        "Wednesday": 0,
                        "Thursday": 25,
                        "Friday": 0,
                        "Saturday": 0
                      },
                      {
                        "hour": "2 PM",
                        "Sunday": 0,
                        "Monday": 22,
                        "Tuesday": 0,
                        "Wednesday": 19,
                        "Thursday": 0,
                        "Friday": 0,
                        "Saturday": 0
                      }
                    ],
                    "grossSaleByDay": [
                      {
                        "day": 1,
                        "gross_sale": 542.0,
                        "order_count": 8
                      },
                      {
                        "day": 2,
                        "gross_sale": 1284.5,
                        "order_count": 21
                      },
                      {
                        "day": 3,
                        "gross_sale": 998.0,
                        "order_count": 16
                      }
                    ],
                    "grossSaleByHour": [
                      {
                        "hour": "9 AM",
                        "gross_sale": 320.0,
                        "order_count": 5
                      },
                      {
                        "hour": "10 AM",
                        "gross_sale": 610.0,
                        "order_count": 9
                      },
                      {
                        "hour": "2 PM",
                        "gross_sale": 415.0,
                        "order_count": 6
                      }
                    ]
                  }
                },
                "example": {
                  "orderByDayAndHour": [
                    {
                      "hour": "9 AM",
                      "Sunday": 0,
                      "Monday": 18,
                      "Tuesday": 12,
                      "Wednesday": 15,
                      "Thursday": 0,
                      "Friday": 0,
                      "Saturday": 0
                    },
                    {
                      "hour": "10 AM",
                      "Sunday": 0,
                      "Monday": 24,
