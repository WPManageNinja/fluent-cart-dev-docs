{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/fetch-report-meta": {
      "get": {
        "operationId": "getReportMeta",
        "summary": "GET Get Report Meta",
        "description": "Returns the data the report filters need: currencies with orders in the range, order counts per currency, the base currency, the earliest order date and the store mode.\n\nWith more than one currency, `currencies` also holds `__all__` (all currencies converted to the base currency), and `converted_excluded_orders` counts orders that cannot convert. Dates are store-timezone strings.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "First store day for the currency lookup (Y-m-d).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Last store day for the currency lookup (Y-m-d).",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "currencies": {
                      "USD": "$",
                      "EUR": "\u20ac",
                      "__all__": "$"
                    },
                    "currency_order_counts": {
                      "USD": 120,
                      "EUR": 30
                    },
                    "default_currency": "USD",
                    "base_currency": "USD",
                    "converted_excluded_orders": 0,
                    "min_date": "2025-01-01 00:00:00",
                    "storeMode": "live",
                    "first_order_date": "2024-03-15 10:20:00"
                  }
                },
                "example": {
                  "currencies": {
                    "USD": "$",
                    "EUR": "\u20ac",
                    "__all__": "$"
                  },
                  "currency_order_counts": {
                    "USD": 120,
                    "EUR": 30
                  },
                  "default_currency": "USD",
                  "base_currency": "USD",
                  "converted_excluded_orders": 0,
                  "min_date": "2025-01-01 00:00:00",
                  "storeMode": "live",
                  "first_order_date": "2024-03-15 10:20:00"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "currencies": {
                        "USD": "$",
                        "EUR": "\u20ac",
                        "__all__": "$"
                      },
                      "currency_order_counts": {
                        "USD": 120,
                        "EUR": 30
                      },
                      "default_currency": "USD",
                      "base_currency": "USD",
                      "converted_excluded_orders": 0,
                      "min_date": "2025-01-01 00:00:00",
                      "storeMode": "live",
                      "first_order_date": "2024-03-15 10:20:00"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
