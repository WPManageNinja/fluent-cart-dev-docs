{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/future-renewals": {
      "get": {
        "operationId": "getFutureRenewals",
        "summary": "GET Get Future Renewals",
        "description": "Retrieve projected future subscription renewal data.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Future renewal projection data for active/trialing subscriptions over the next quarter, grouped by month. Note: the `params[startDate]`/`params[endDate]` query parameters are currently read but not applied \u2014 the window is always \"today\" through \"+3 months\".",
                  "properties": {
                    "totalProjected": {
                      "type": "integer",
                      "description": "Sum of all projected renewal amounts across the period, in cents"
                    },
                    "totalRenewals": {
                      "type": "integer",
                      "description": "Total count of projected renewals across the period"
                    },
                    "projections": {
                      "type": "array",
                      "description": "Renewals and projected revenue grouped by month",
                      "items": {
                        "type": "object",
                        "properties": {
                          "group": {
                            "type": "string",
                            "description": "Month bucket, formatted Y-m"
                          },
                          "renewals_count": {
                            "type": "integer"
                          },
                          "projected_amount": {
                            "type": "integer",
                            "description": "Projected renewal amount for this month, in cents"
                          }
                        }
                      }
                    },
                    "period": {
                      "type": "array",
                      "description": "[start, end] datetime strings of the report window",
                      "items": {
                        "type": "string"
                      }
                    },
                    "groupBy": {
                      "type": "string",
                      "description": "Grouping granularity (currently always \"monthly\")"
                    }
                  },
                  "example": {
                    "totalProjected": 148500,
                    "totalRenewals": 15,
                    "projections": [
                      {
                        "group": "2026-08",
                        "renewals_count": 5,
                        "projected_amount": 49500
                      },
                      {
                        "group": "2026-09",
                        "renewals_count": 6,
                        "projected_amount": 59400
                      },
                      {
                        "group": "2026-10",
                        "renewals_count": 4,
                        "projected_amount": 39600
                      }
                    ],
                    "period": [
                      "2026-08-17 00:00:00",
                      "2026-11-17 23:59:59"
                    ],
                    "groupBy": "monthly"
                  }
                },
                "example": {
                  "totalProjected": 148500,
                  "totalRenewals": 15,
                  "projections": [
                    {
                      "group": "2026-08",
                      "renewals_count": 5,
                      "projected_amount": 49500
                    },
                    {
                      "group": "2026-09",
                      "renewals_count": 6,
                      "projected_amount": 59400
                    },
                    {
                      "group": "2026-10",
                      "renewals_count": 4,
                      "projected_amount": 39600
                    }
                  ],
                  "period": [
                    "2026-08-17 00:00:00",
                    "2026-11-17 23:59:59"
                  ],
                  "groupBy": "monthly"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "totalProjected": 148500,
                      "totalRenewals": 15,
                      "projections": [
                        {
                          "group": "2026-08",
                          "renewals_count": 5,
                          "projected_amount": 49500
                        },
                        {
                          "group": "2026-09",
                          "renewals_count": 6,
                          "projected_amount": 59400
                        },
                        {
                          "group": "2026-10",
                          "renewals_count": 4,
                          "projected_amount": 39600
                        }
                      ],
                      "period": [
                        "2026-08-17 00:00:00",
                        "2026-11-17 23:59:59"
                      ],
                      "groupBy": "monthly"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
