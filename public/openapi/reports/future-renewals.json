{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/future-renewals": {
      "get": {
        "operationId": "getFutureRenewals",
        "summary": "GET Get Future Renewals",
        "description": "Projects the renewals of live open-ended subscriptions month by month for the next 3, 6 or 12 months, with the store's renewal rates for the last 12 months. Amounts are in cents.\n\nThe date range does not apply; the window starts on the as-of day and ends at the end of the horizon's last month. `by_variation` comes only when FluentCart Pro answers the `fluent_cart/report/future_renewals_by_variation` filter. In `by_interval` and `trial`, the inner key is the renewal's position in the window.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. Defaults to the base currency. `__all__` converts every currency to the base currency.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[horizon]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "3",
                "6",
                "12"
              ]
            },
            "description": "Months to project. Default `3`.",
            "required": false
          },
          {
            "name": "params[as_of]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Start day (Y-m-d). Defaults to today.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "totalProjected": 1250000,
                    "totalRenewals": 420,
                    "projections": [
                      {
                        "group": "2025-02",
                        "renewals_count": 140,
                        "projected_amount": 420000,
                        "by_interval": {
                          "month": {
                            "1": 400000
                          }
                        },
                        "trial": {
                          "month": [
                            20000
                          ]
                        }
                      }
                    ],
                    "by_interval": {
                      "month": {
                        "1": 400000,
                        "2": 400000
                      }
                    },
                    "trial": {
                      "month": [
                        20000
                      ]
                    },
                    "trial_first": {
                      "count": 4,
                      "amount": 20000
                    },
                    "rates": {
                      "month": 92.5,
                      "year": 80.0
                    },
                    "trial_rate": 40.0,
                    "rate_window": [
                      "2024-02-01",
                      "2025-01-31"
                    ],
                    "overdue": {
                      "count": 3,
                      "amount": 9000
                    },
                    "retrying": {
                      "count": 5,
                      "amount": 15000
                    },
                    "wont_renew": {
                      "count": 6,
                      "amount": 18000,
                      "by_month": {
                        "2025-02": 6000
                      }
                    },
                    "period": [
                      "2025-02-01 00:00:00",
                      "2025-04-30 23:59:59"
                    ],
                    "groupBy": "monthly",
                    "horizon": "3",
                    "by_variation": [
                      {
                        "variation_id": 12,
                        "product_id": 10,
                        "product_title": "Pro Plan",
                        "variation_title": "Monthly",
                        "renewals_count": 300,
                        "projected_amount": 900000,
                        "by_interval": {
                          "month": {
                            "1": 300000
                          }
                        },
                        "trial": []
                      }
                    ]
                  }
                },
                "example": {
                  "totalProjected": 1250000,
                  "totalRenewals": 420,
                  "projections": [
                    {
                      "group": "2025-02",
                      "renewals_count": 140,
                      "projected_amount": 420000,
                      "by_interval": {
                        "month": {
                          "1": 400000
                        }
                      },
                      "trial": {
                        "month": [
                          20000
                        ]
                      }
                    }
                  ],
                  "by_interval": {
                    "month": {
                      "1": 400000,
                      "2": 400000
                    }
                  },
                  "trial": {
                    "month": [
                      20000
                    ]
                  },
                  "trial_first": {
                    "count": 4,
                    "amount": 20000
                  },
                  "rates": {
                    "month": 92.5,
                    "year": 80.0
                  },
                  "trial_rate": 40.0,
                  "rate_window": [
                    "2024-02-01",
                    "2025-01-31"
                  ],
                  "overdue": {
                    "count": 3,
                    "amount": 9000
                  },
                  "retrying": {
                    "count": 5,
                    "amount": 15000
                  },
                  "wont_renew": {
                    "count": 6,
                    "amount": 18000,
                    "by_month": {
                      "2025-02": 6000
                    }
                  },
                  "period": [
                    "2025-02-01 00:00:00",
                    "2025-04-30 23:59:59"
                  ],
                  "groupBy": "monthly",
                  "horizon": "3",
                  "by_variation": [
                    {
                      "variation_id": 12,
                      "product_id": 10,
                      "product_title": "Pro Plan",
                      "variation_title": "Monthly",
                      "renewals_count": 300,
                      "projected_amount": 900000,
                      "by_interval": {
                        "month": {
                          "1": 300000
                        }
                      },
                      "trial": []
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "totalProjected": 1250000,
                      "totalRenewals": 420,
                      "projections": [
                        {
                          "group": "2025-02",
                          "renewals_count": 140,
                          "projected_amount": 420000,
                          "by_interval": {
                            "month": {
                              "1": 400000
                            }
                          },
                          "trial": {
                            "month": [
                              20000
                            ]
                          }
                        }
                      ],
                      "by_interval": {
                        "month": {
                          "1": 400000,
                          "2": 400000
                        }
                      },
                      "trial": {
                        "month": [
                          20000
                        ]
                      },
                      "trial_first": {
                        "count": 4,
                        "amount": 20000
                      },
                      "rates": {
                        "month": 92.5,
                        "year": 80.0
                      },
                      "trial_rate": 40.0,
                      "rate_window": [
                        "2024-02-01",
                        "2025-01-31"
                      ],
                      "overdue": {
                        "count": 3,
                        "amount": 9000
                      },
                      "retrying": {
                        "count": 5,
                        "amount": 15000
                      },
                      "wont_renew": {
                        "count": 6,
                        "amount": 18000,
                        "by_month": {
                          "2025-02": 6000
                        }
                      },
                      "period": [
                        "2025-02-01 00:00:00",
                        "2025-04-30 23:59:59"
                      ],
                      "groupBy": "monthly",
                      "horizon": "3",
                      "by_variation": [
                        {
                          "variation_id": 12,
                          "product_id": 10,
                          "product_title": "Pro Plan",
                          "variation_title": "Monthly",
                          "renewals_count": 300,
                          "projected_amount": 900000,
                          "by_interval": {
                            "month": {
                              "1": 300000
                            }
                          },
                          "trial": []
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
