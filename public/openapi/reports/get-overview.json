{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/overview": {
      "get": {
        "operationId": "getReportsOverview",
        "summary": "GET Get Reports Overview",
        "description": "Returns year-over-year gross and net revenue for the last 12 store months, the last 4 quarters and the top 5 billing countries, plus 24 months of net sales. The revenue series are in cents; `net_sales_months` is a decimal.\n\nThis endpoint does not use the date range. `net_revenue` is paid \u2212 refunds \u2212 unrefunded tax (shipping and fees stay in). `net_sales_months` is the Revenue report's net sales. Only `net_sales_months` accepts `__all__`; the other series use one currency. With `params[net_sales_only]=1` only `net_sales_months` is returned.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. Defaults to the base currency. `__all__` converts every currency to the base currency.",
            "required": false
          },
          {
            "name": "params[net_sales_only]",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "When `1`, return only `net_sales_months`.",
            "required": false
          },
          {
            "name": "params[cached]",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "With `net_sales_only`, when `1` the result may come from a 10-minute cache.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "data": {
                      "gross_revenue": {
                        "2025-01": {
                          "current": 500000,
                          "prev": 400000,
                          "yoy_growth": "25.00"
                        }
                      },
                      "gross_revenue_quarterly": {
                        "Q1-2025": {
                          "current": 1500000,
                          "prev_year": 1200000,
                          "yy_growth": "25.00"
                        }
                      },
                      "net_revenue": {
                        "2025-01": {
                          "current": 450000,
                          "prev": 360000,
                          "yoy_growth": "25.00"
                        }
                      },
                      "net_revenue_quarterly": {
                        "Q1-2025": {
                          "current": 1350000,
                          "prev_year": 1080000,
                          "yy_growth": "25.00"
                        }
                      },
                      "gross_summary": {
                        "total": 6000000,
                        "total_prev": 4800000,
                        "yoy_growth": "25.00"
                      },
                      "net_summary": {
                        "total": 5400000,
                        "total_prev": 4320000,
                        "yoy_growth": "25.00"
                      },
                      "top_country_net": {
                        "by_month": {
                          "2025-01": {
                            "US": 300000,
                            "GB": 100000
                          }
                        },
                        "by_countries": {
                          "US": 3600000,
                          "GB": 1200000
                        }
                      },
                      "top_country_gross": {
                        "by_month": {
                          "2025-01": {
                            "US": 330000,
                            "GB": 110000
                          }
                        },
                        "by_countries": {
                          "US": 3960000,
                          "GB": 1320000
                        }
                      },
                      "net_sales_months": [
                        {
                          "group": "2025-01",
                          "net_sales": 4100.0
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "data": {
                    "gross_revenue": {
                      "2025-01": {
                        "current": 500000,
                        "prev": 400000,
                        "yoy_growth": "25.00"
                      }
                    },
                    "gross_revenue_quarterly": {
                      "Q1-2025": {
                        "current": 1500000,
                        "prev_year": 1200000,
                        "yy_growth": "25.00"
                      }
                    },
                    "net_revenue": {
                      "2025-01": {
                        "current": 450000,
                        "prev": 360000,
                        "yoy_growth": "25.00"
                      }
                    },
                    "net_revenue_quarterly": {
                      "Q1-2025": {
                        "current": 1350000,
                        "prev_year": 1080000,
                        "yy_growth": "25.00"
                      }
                    },
                    "gross_summary": {
                      "total": 6000000,
                      "total_prev": 4800000,
                      "yoy_growth": "25.00"
                    },
                    "net_summary": {
                      "total": 5400000,
                      "total_prev": 4320000,
                      "yoy_growth": "25.00"
                    },
                    "top_country_net": {
                      "by_month": {
                        "2025-01": {
                          "US": 300000,
                          "GB": 100000
                        }
                      },
                      "by_countries": {
                        "US": 3600000,
                        "GB": 1200000
                      }
                    },
                    "top_country_gross": {
                      "by_month": {
                        "2025-01": {
                          "US": 330000,
                          "GB": 110000
                        }
                      },
                      "by_countries": {
                        "US": 3960000,
                        "GB": 1320000
                      }
                    },
                    "net_sales_months": [
                      {
                        "group": "2025-01",
                        "net_sales": 4100.0
                      }
                    ]
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": {
                        "gross_revenue": {
                          "2025-01": {
                            "current": 500000,
                            "prev": 400000,
                            "yoy_growth": "25.00"
                          }
                        },
                        "gross_revenue_quarterly": {
                          "Q1-2025": {
                            "current": 1500000,
                            "prev_year": 1200000,
                            "yy_growth": "25.00"
                          }
                        },
                        "net_revenue": {
                          "2025-01": {
                            "current": 450000,
                            "prev": 360000,
                            "yoy_growth": "25.00"
                          }
                        },
                        "net_revenue_quarterly": {
                          "Q1-2025": {
                            "current": 1350000,
