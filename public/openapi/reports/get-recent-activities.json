{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/get-recent-activities": {
      "get": {
        "operationId": "getRecentActivities",
        "summary": "GET Get Recent Activities",
        "description": "Returns the 10 newest activity log entries, optionally limited to today, yesterday or this week in the store timezone.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "groupKey",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "today",
                "yesterday",
                "this_week"
              ]
            },
            "description": "Time filter. Default `all`.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "recentActivities": [
                      {
                        "title": "Order status updated",
                        "content": "Order status changed from processing to completed",
                        "created_at": "2025-01-31 14:25:00",
                        "created_by": "admin",
                        "module_name": "order",
                        "module_id": 1050
                      }
                    ]
                  }
                },
                "example": {
                  "recentActivities": [
                    {
                      "title": "Order status updated",
                      "content": "Order status changed from processing to completed",
                      "created_at": "2025-01-31 14:25:00",
                      "created_by": "admin",
                      "module_name": "order",
                      "module_id": 1050
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "recentActivities": [
                        {
                          "title": "Order status updated",
                          "content": "Order status changed from processing to completed",
                          "created_at": "2025-01-31 14:25:00",
                          "created_by": "admin",
                          "module_name": "order",
                          "module_id": 1050
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
