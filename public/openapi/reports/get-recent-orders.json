{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/get-recent-orders": {
      "get": {
        "operationId": "getRecentOrders",
        "summary": "GET Get Recent Orders",
        "description": "Returns the 10 newest orders of any status, with customer name and item count. `total_amount` is a decimal in the order's currency.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "recentOrders": [
                      {
                        "id": 1050,
                        "customer_id": 42,
                        "customer_name": "Jane Doe",
                        "total_amount": "49.0000",
                        "currency": "USD",
                        "created_at": "2025-01-31 14:20:00",
                        "order_items_count": 2
                      }
                    ]
                  }
                },
                "example": {
                  "recentOrders": [
                    {
                      "id": 1050,
                      "customer_id": 42,
                      "customer_name": "Jane Doe",
                      "total_amount": "49.0000",
                      "currency": "USD",
                      "created_at": "2025-01-31 14:20:00",
                      "order_items_count": 2
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "recentOrders": [
                        {
                          "id": 1050,
                          "customer_id": 42,
                          "customer_name": "Jane Doe",
                          "total_amount": "49.0000",
                          "currency": "USD",
                          "created_at": "2025-01-31 14:20:00",
                          "order_items_count": 2
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
