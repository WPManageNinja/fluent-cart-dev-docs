{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/installments/variations": {
      "get": {
        "operationId": "getInstallmentsVariations",
        "summary": "GET Get Installments by Variation",
        "description": "Returns installment plans grouped by the variation they were sold on: how many started, what they collected, and what is still owed. Amounts are in cents.\n\n`collected` is paid less refunded on the plans' orders. `scheduled` is still owed on running plans, `overdue_amount` on overdue plans, `lapsed_amount` on lapsed plans. `total` = `collected` + `scheduled`; rows sort by it. Each plan falls in one `<bucket>_count`: completed, running, overdue, paused, upgraded, lapsed, refunded.\n\n**Requires FluentCart Pro.** Without Pro this route is not registered and returns 404.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code, or `__all__` for all currencies converted to the base currency. Default: the base currency.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain one of these variation IDs.",
            "required": false
          },
          {
            "name": "params[started_from]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only plans that started on or after this day (Y-m-d, store timezone).",
            "required": false
          },
          {
            "name": "params[started_to]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only plans that started on or before this day (Y-m-d, store timezone).",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "data": [
                      {
                        "variation_id": 108,
                        "product_id": 42,
                        "product_title": "Pro Plugin",
                        "variation_title": "3 payments",
                        "min_price": 10000,
                        "max_price": 10000,
                        "min_bill_times": 3,
                        "max_bill_times": 3,
                        "is_installment_price": true,
                        "plans_started": 20,
                        "payments": 45,
                        "collected": 450000,
                        "scheduled": 100000,
                        "overdue_amount": 20000,
                        "lapsed_amount": 10000,
                        "completed_count": 10,
                        "running_count": 6,
                        "overdue_count": 2,
                        "paused_count": 0,
                        "upgraded_count": 0,
                        "lapsed_count": 1,
                        "refunded_count": 1,
                        "total": 550000
                      }
                    ]
                  }
                },
                "example": {
                  "data": [
                    {
                      "variation_id": 108,
                      "product_id": 42,
                      "product_title": "Pro Plugin",
                      "variation_title": "3 payments",
                      "min_price": 10000,
                      "max_price": 10000,
                      "min_bill_times": 3,
                      "max_bill_times": 3,
                      "is_installment_price": true,
                      "plans_started": 20,
                      "payments": 45,
                      "collected": 450000,
                      "scheduled": 100000,
                      "overdue_amount": 20000,
                      "lapsed_amount": 10000,
                      "completed_count": 10,
                      "running_count": 6,
                      "overdue_count": 2,
                      "paused_count": 0,
                      "upgraded_count": 0,
                      "lapsed_count": 1,
                      "refunded_count": 1,
                      "total": 550000
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": [
                        {
                          "variation_id": 108,
                          "product_id": 42,
                          "product_title": "Pro Plugin",
                          "variation_title": "3 payments",
                          "min_price": 10000,
                          "max_price": 10000,
                          "min_bill_times": 3,
                          "max_bill_times": 3,
                          "is_installment_price": true,
                          "plans_started": 20,
                          "payments": 45,
                          "collected": 450000,
                          "scheduled": 100000,
                          "overdue_amount": 20000,
                          "lapsed_amount": 10000,
                          "completed_count": 10,
                          "running_count": 6,
                          "overdue_count": 2,
                          "paused_count": 0,
                          "upgraded_count": 0,
                          "lapsed_count": 1,
                          "refunded_count": 1,
                          "total": 550000
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
