                        "scheduled": 300000,
                        "overdue": 20000,
                        "lapsed_unpaid": 40000,
                        "completion_rate": 85.0,
                        "collection_rate": 92.5,
                        "completed_count": 30,
                        "running_count": 12,
                        "overdue_count": 2,
                        "paused_count": 0,
                        "upgraded_count": 1,
                        "lapsed_count": 4,
                        "refunded_count": 1
                      },
                      "schedule": [
                        {
                          "month": "2025-02",
                          "payments": 14,
                          "amount": 70000,
                          "scheduled": 60000,
                          "overdue": 10000
                        }
                      ],
                      "due_soon": {
                        "count": 14,
                        "amount": 70000,
                        "overdue": {
                          "count": 2,
                          "amount": 10000
                        }
                      },
                      "starts": [
                        {
                          "month": "2024-06",
                          "plans_started": 5,
                          "collected": 100000,
                          "completed_count": 3,
                          "running_count": 2,
                          "overdue_count": 0,
                          "paused_count": 0,
                          "upgraded_count": 0,
                          "lapsed_count": 0,
                          "refunded_count": 0
                        }
                      ],
                      "at_risk": [],
                      "filter_options": [
                        {
                          "product_id": 20,
                          "product_title": "Course",
                          "variations": [
                            {
                              "id": 31,
                              "title": "3 payments"
                            }
                          ]
                        }
                      ],
                      "at_risk_count": 6,
                      "at_risk_amount": 60000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
