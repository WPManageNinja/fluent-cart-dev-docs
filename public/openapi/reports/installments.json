                        }
                      ]
                    }
                  ],
                  "at_risk_count": 6,
                  "at_risk_amount": 60000
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "as_of": "2025-02-01",
                      "currency": "USD",
                      "started_from": null,
