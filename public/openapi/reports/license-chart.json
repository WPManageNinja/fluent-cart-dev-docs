{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/license-chart": {
      "get": {
        "operationId": "getLicenseChart",
        "summary": "GET Get License Line Chart",
        "description": "Retrieve license creation/activation data as time-series chart data, grouped by the specified interval.\n\n**Also used by the licensing UI.** Retrieve license data formatted for a line chart visualization.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          },
          {
            "name": "params[paymentStatus]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Payment status filter.",
            "required": false
          },
          {
            "name": "params[orderStatus]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Order status filter.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "Currency code filter.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Payment mode filter.",
            "required": false
          },
          {
            "name": "params[orderTypes]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Order type filter.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "daily",
                "monthly",
                "yearly"
              ],
              "default": "daily"
            },
            "description": "Time grouping interval.",
            "required": false
          },
          {
            "name": "params",
            "in": "query",
            "required": true,
            "schema": {
              "type": "object"
            },
            "description": "Request parameters object containing filters, date range, and grouping",
            "style": "deepObject",
            "explode": true
          },
          {
            "name": "params[filters]",
            "in": "query",
            "schema": {
              "type": "object"
            },
            "description": "Filter criteria",
            "required": false,
            "style": "deepObject",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Time-series license-count data. The shape of each `lineChartData` entry depends on `params[groupKey]`: `daily` (default) yields `{date, license_count}`, `monthly` yields `{year, month, license_count}`, and `yearly` yields `{year, license_count}`. Requires FluentCart Pro's Licensing module.",
                  "properties": {
                    "lineChartData": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string",
                            "description": "Date bucket (Y-m-d), present when groupKey is \"daily\""
                          },
                          "year": {
                            "type": "integer",
                            "description": "Present when groupKey is \"monthly\" or \"yearly\""
                          },
                          "month": {
                            "type": "integer",
                            "description": "Present when groupKey is \"monthly\""
                          },
                          "license_count": {
                            "type": "integer",
                            "description": "Number of licenses created in this bucket"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "lineChartData": [
                      {
                        "date": "2026-08-01",
                        "license_count": 4
                      },
                      {
                        "date": "2026-08-02",
                        "license_count": 7
                      },
                      {
                        "date": "2026-08-03",
                        "license_count": 2
                      }
                    ]
                  }
                },
                "example": {
                  "lineChartData": [
                    {
                      "date": "2026-08-01",
                      "license_count": 4
                    },
                    {
                      "date": "2026-08-02",
                      "license_count": 7
                    },
                    {
                      "date": "2026-08-03",
                      "license_count": 2
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "lineChartData": [
                        {
                          "date": "2026-08-01",
                          "license_count": 4
                        },
                        {
                          "date": "2026-08-02",
                          "license_count": 7
                        },
                        {
                          "date": "2026-08-03",
                          "license_count": 2
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
