{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/license-pie-chart": {
      "get": {
        "operationId": "getLicensePieChart",
        "summary": "GET Get License Pie Chart",
        "description": "Retrieve license distribution data suitable for pie/donut chart visualization (e.g., active vs expired vs revoked).\n\n**Also used by the licensing UI.** Retrieve license data formatted for a pie chart visualization.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          },
          {
            "name": "params[paymentStatus]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Payment status filter.",
            "required": false
          },
          {
            "name": "params[orderStatus]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Order status filter.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "Currency code filter.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Payment mode filter.",
            "required": false
          },
          {
            "name": "params[orderTypes]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Order type filter.",
            "required": false
          },
          {
            "name": "params",
            "in": "query",
            "required": true,
            "schema": {
              "type": "object"
            },
            "description": "Request parameters object containing filters and date range",
            "style": "deepObject",
            "explode": true
          },
          {
            "name": "params[filters]",
            "in": "query",
            "schema": {
              "type": "object"
            },
            "description": "Filter criteria",
            "required": false,
            "style": "deepObject",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pieChartData": {
                      "type": "array",
                      "description": "License activation distribution by product, one entry per product that has licenses",
                      "items": {
                        "$ref": "#/components/schemas/LicensePieChartSlice"
                      }
                    }
                  },
                  "example": {
                    "pieChartData": [
                      {
                        "product_id": "10",
                        "post_title": "FluentCart Pro",
                        "activation_count": "198",
                        "percentage": "80.82"
                      },
                      {
                        "product_id": "14",
                        "post_title": "FluentCart Pro Add-on",
                        "activation_count": "47",
                        "percentage": "19.18"
                      }
                    ]
                  }
                },
                "example": {
                  "pieChartData": [
                    {
                      "product_id": "10",
                      "post_title": "FluentCart Pro",
                      "activation_count": "198",
                      "percentage": "80.82"
                    },
                    {
                      "product_id": "14",
                      "post_title": "FluentCart Pro Add-on",
                      "activation_count": "47",
                      "percentage": "19.18"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "pieChartData": [
                        {
                          "product_id": "10",
                          "post_title": "FluentCart Pro",
                          "activation_count": "198",
                          "percentage": "80.82"
                        },
                        {
                          "product_id": "14",
                          "post_title": "FluentCart Pro Add-on",
                          "activation_count": "47",
                          "percentage": "19.18"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LicensePieChartSlice": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "Product post ID",
            "example": "10"
          },
          "post_title": {
            "type": "string",
            "description": "Product title",
            "example": "FluentCart Pro"
          },
          "activation_count": {
            "type": "string",
            "description": "Number of license activations for this product within the report range",
            "example": "198"
          },
          "percentage": {
            "type": "string",
            "description": "Share of total activations this product represents, as a percentage string",
            "example": "80.82"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
