{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/license-summary": {
      "get": {
        "operationId": "getLicenseSummary",
        "summary": "GET Get License Summary",
        "description": "Returns license counts by current status, total activated sites and the number of licensed products. The date range does not apply.\n\nThis is a core route, but it reads the `fct_licenses` table that the FluentCart Pro licensing module creates. Without that table the query throws a database error.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "summaryData": {
                      "totalLicense": 200,
                      "totalActiveLicense": 150,
                      "totalInactiveLicense": 20,
                      "totalDisabledLicense": 5,
                      "totalExpiredLicense": 25,
                      "totalActivatedSites": 310,
                      "totalLicensedProducts": 4
                    }
                  }
                },
                "example": {
                  "summaryData": {
                    "totalLicense": 200,
                    "totalActiveLicense": 150,
                    "totalInactiveLicense": 20,
                    "totalDisabledLicense": 5,
                    "totalExpiredLicense": 25,
                    "totalActivatedSites": 310,
                    "totalLicensedProducts": 4
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "summaryData": {
                        "totalLicense": 200,
                        "totalActiveLicense": 150,
                        "totalInactiveLicense": 20,
                        "totalDisabledLicense": 5,
                        "totalExpiredLicense": 25,
                        "totalActivatedSites": 310,
                        "totalLicensedProducts": 4
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
