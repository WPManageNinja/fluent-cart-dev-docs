{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/locations": {
      "get": {
        "operationId": "getLocations",
        "summary": "GET Get Locations",
        "description": "Returns orders, customers and money by country. With FluentCart Pro it also drills down to states and cities and adds lifetime value, repeat rate and the biggest movers. Amounts are decimal currency units; `net_sales` is the Revenue report's net sales.\n\nWithout Pro, the report is always at country level (`level` is ignored) and `full` is `false`. Pro answers the `fluent_cart/report/locations` filter with the full report (`full: true`): `level`, `country` and `state` work, each row gets `average_ltv` and `repeat_rate` of the new customers it won, and `movers` lists the three biggest gains and drops in net sales against the comparison period.\n\nAn order's location is its latest address of the chosen type (shipping falls back to billing), else a renewal's parent order billing address, else the customer record's country, else `__unknown__`. In a row, a customer counts once: new wins over returning (`returning_customers` leaves out customers who are new there). Renewal orders count in `renewal_orders`, not as new or returning. With `variation_ids`, the money fields are the picked variations' share of each order.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Only live or only test orders. Without it, both count.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain these variation IDs.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Start of the comparison range when `compareType` is `custom`.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Only these sale types. `renewal` leaves out installment payments.",
            "required": false
          },
          {
            "name": "params[level]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "country",
                "state",
                "city"
              ]
            },
            "description": "Pro only. `country` (default), `state` or `city`.",
            "required": false
          },
          {
            "name": "params[country]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "US"
            },
            "description": "Pro only. Country code to drill into. Needed for `state` and `city`.",
            "required": false
          },
          {
            "name": "params[state]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pro only. State to drill into at `city` level. `__unknown__` selects orders with no state.",
            "required": false
          },
          {
            "name": "params[address_type]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "billing",
                "shipping"
              ]
            },
            "description": "`billing` (default) or `shipping`. Shipping falls back to billing.",
            "required": false
          },
          {
            "name": "params[with_summary]",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "At `state` or `city` level, also return the store-wide `summary` and `previous` cards. Country level always returns them.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "level": "country",
                    "rows": [
                      {
                        "key": "US",
                        "unknown": false,
                        "orders": 40,
                        "customers": 30,
                        "new_customers": 18,
                        "returning_customers": 7,
                        "new_orders": 18,
                        "returning_orders": 9,
                        "renewal_orders": 13,
                        "gross_sales": 2000.0,
                        "refunds": 100.0,
                        "net_sales": 1800.0,
                        "average_net_order": 45.0,
                        "refund_rate": 5.0,
                        "via_parent": 2,
                        "via_customer": 1,
                        "previous_net": null,
                        "net_change": null,
                        "net_share": 75.0
                      }
                    ],
                    "totals": {
