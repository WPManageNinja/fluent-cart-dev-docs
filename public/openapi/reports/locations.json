                      "customers": 42,
                      "new_customers": 25,
                      "returning_customers": 9,
                      "new_orders": 25,
                      "returning_orders": 12,
                      "renewal_orders": 18,
                      "gross_sales": 2650.0,
                      "refunds": 120.0,
