                      "via_parent": 3,
                      "via_customer": 1
                    },
                    "sources": {
                      "parent_order": 3,
                      "customer_record": 1
                    },
                    "outsized": null,
                    "summary": {
                      "store_country": "US",
                      "net_sales": 2400.0,
                      "orders": 55,
                      "international_net": 600.0,
                      "international_share": 25.0,
                      "international_new_customers": 7,
                      "countries": 6,
