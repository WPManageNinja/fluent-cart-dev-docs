{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/order-chart": {
      "get": {
        "operationId": "getOrderChart",
        "summary": "GET Get Order Chart",
        "description": "Returns order counts, items and money per day, month or year, with totals and rates. Amounts are decimal currency units.\n\n`average_net` uses the Revenue report's net sales; `net_revenue` is paid minus refunds minus unrefunded tax. `monthly_net`, `monthly_gross`, `monthly_orders` and `monthly_items` appear in `summary` only when the range has orders. `refund_rate` is refunded orders as a percent of orders. With a comparison, `fluctuations` holds the percent change per summary key (`null` when the previous value is 0) and `previousChartData` holds the comparison buckets.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "daily",
                "monthly",
                "yearly"
              ]
            },
            "description": "Chart bucket: `daily`, `monthly`, `yearly`, or `default` (picked from the range length).",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Only live or only test orders. Without it, both count.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain these variation IDs.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Start of the comparison range when `compareType` is `custom`.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Only these sale types. `renewal` leaves out installment payments.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "orderChartData": [
                      {
                        "group": "2025-01",
                        "year": "2025",
                        "gross_sale": 1250.0,
                        "net_revenue": 1152.0,
                        "order_count": 42,
                        "total_refund": 60.0,
                        "shipping_total": 50.0,
                        "tax_total": 38.0,
                        "average_net": 26.36,
                        "average_gross": 29.76,
                        "total_item_count": 50,
                        "average_order_items_count": 1.19,
                        "refunded_orders": 2,
                        "average_order_gross": 30,
                        "net_sales": 1107.0
                      }
                    ],
                    "summary": {
                      "net_revenue": 1152.0,
                      "net_sales": 1107.0,
                      "gross_sale": 1250.0,
                      "order_count": 42,
                      "total_item_count": 50,
                      "average_net": 26.36,
                      "average_order_items_count": 1.19,
                      "average_gross": 29.76,
                      "total_refund": 60.0,
                      "tax_total": 38.0,
                      "shipping_total": 50.0,
                      "refunded_orders": 2,
                      "monthly_net": 1152.0,
                      "monthly_gross": 1250.0,
                      "monthly_orders": 42,
                      "monthly_items": 50,
                      "refund_rate": 4.76,
                      "orders_per_day": 1.35,
                      "orders_per_month": 42
                    },
                    "previousSummary": [],
                    "fluctuations": [],
                    "compare_range": null,
                    "compare_ranges": {
                      "previous_period": {
                        "start": "2024-12-01 00:00:00",
                        "end": "2024-12-31 23:59:59"
                      },
                      "previous_month": {
                        "start": "2024-12-01 00:00:00",
                        "end": "2024-12-31 23:59:59"
                      },
                      "previous_quarter": {
                        "start": "2024-10-01 00:00:00",
                        "end": "2024-10-31 23:59:59"
                      },
                      "previous_year": {
                        "start": "2024-01-01 00:00:00",
                        "end": "2024-01-31 23:59:59"
                      }
                    },
                    "previousChartData": []
                  }
                },
                "example": {
                  "orderChartData": [
                    {
                      "group": "2025-01",
                      "year": "2025",
                      "gross_sale": 1250.0,
                      "net_revenue": 1152.0,
                      "order_count": 42,
                      "total_refund": 60.0,
                      "shipping_total": 50.0,
                      "tax_total": 38.0,
                      "average_net": 26.36,
                      "average_gross": 29.76,
                      "total_item_count": 50,
                      "average_order_items_count": 1.19,
                      "refunded_orders": 2,
                      "average_order_gross": 30,
                      "net_sales": 1107.0
                    }
                  ],
                  "summary": {
                    "net_revenue": 1152.0,
                    "net_sales": 1107.0,
                    "gross_sale": 1250.0,
                    "order_count": 42,
                    "total_item_count": 50,
                    "average_net": 26.36,
                    "average_order_items_count": 1.19,
                    "average_gross": 29.76,
                    "total_refund": 60.0,
                    "tax_total": 38.0,
                    "shipping_total": 50.0,
                    "refunded_orders": 2,
                    "monthly_net": 1152.0,
                    "monthly_gross": 1250.0,
                    "monthly_orders": 42,
                    "monthly_items": 50,
                    "refund_rate": 4.76,
                    "orders_per_day": 1.35,
                    "orders_per_month": 42
                  },
                  "previousSummary": [],
                  "fluctuations": [],
                  "compare_range": null,
                  "compare_ranges": {
                    "previous_period": {
                      "start": "2024-12-01 00:00:00",
                      "end": "2024-12-31 23:59:59"
                    },
                    "previous_month": {
                      "start": "2024-12-01 00:00:00",
                      "end": "2024-12-31 23:59:59"
                    },
                    "previous_quarter": {
                      "start": "2024-10-01 00:00:00",
                      "end": "2024-10-31 23:59:59"
                    },
                    "previous_year": {
                      "start": "2024-01-01 00:00:00",
                      "end": "2024-01-31 23:59:59"
                    }
                  },
                  "previousChartData": []
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "orderChartData": [
                        {
                          "group": "2025-01",
                          "year": "2025",
                          "gross_sale": 1250.0,
                          "net_revenue": 1152.0,
                          "order_count": 42,
                          "total_refund": 60.0,
                          "shipping_total": 50.0,
                          "tax_total": 38.0,
                          "average_net": 26.36,
                          "average_gross": 29.76,
                          "total_item_count": 50,
                          "average_order_items_count": 1.19,
                          "refunded_orders": 2,
                          "average_order_gross": 30,
                          "net_sales": 1107.0
                        }
                      ],
                      "summary": {
                        "net_revenue": 1152.0,
                        "net_sales": 1107.0,
                        "gross_sale": 1250.0,
                        "order_count": 42,
                        "total_item_count": 50,
                        "average_net": 26.36,
                        "average_order_items_count": 1.19,
                        "average_gross": 29.76,
                        "total_refund": 60.0,
                        "tax_total": 38.0,
                        "shipping_total": 50.0,
                        "refunded_orders": 2,
                        "monthly_net": 1152.0,
                        "monthly_gross": 1250.0,
                        "monthly_orders": 42,
                        "monthly_items": 50,
                        "refund_rate": 4.76,
                        "orders_per_day": 1.35,
                        "orders_per_month": 42
                      },
                      "previousSummary": [],
                      "fluctuations": [],
                      "compare_range": null,
                      "compare_ranges": {
                        "previous_period": {
                          "start": "2024-12-01 00:00:00",
                          "end": "2024-12-31 23:59:59"
                        },
                        "previous_month": {
                          "start": "2024-12-01 00:00:00",
                          "end": "2024-12-31 23:59:59"
                        },
                        "previous_quarter": {
                          "start": "2024-10-01 00:00:00",
                          "end": "2024-10-31 23:59:59"
                        },
                        "previous_year": {
                          "start": "2024-01-01 00:00:00",
                          "end": "2024-01-31 23:59:59"
                        }
                      },
                      "previousChartData": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
