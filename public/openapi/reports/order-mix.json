{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/order-mix": {
      "get": {
        "operationId": "getOrderMix",
        "summary": "GET Get Order Mix",
        "description": "Splits the period's orders four ways: sale type, order status, discounted orders, and physical orders by shipping status. Counts and percent shares only; no money fields.\n\nEvery split adds up to `total`. `share` is a percent of `total`, except `fulfillment.statuses[].share`, which is a percent of `fulfillment.orders` (physical orders only). Orders with no shipping status count as `unshipped`.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Only live or only test orders. Without it, both count.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain these variation IDs.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Only these sale types. `renewal` leaves out installment payments.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "total": 120,
                    "types": [
                      {
                        "key": "payment",
                        "label": "One-time",
                        "orders": 80,
                        "share": 66.67
                      },
                      {
                        "key": "renewal",
                        "label": "Renewal",
                        "orders": 40,
                        "share": 33.33
                      }
                    ],
                    "statuses": [
                      {
                        "key": "completed",
                        "label": "Completed",
                        "orders": 100,
                        "share": 83.33
                      },
                      {
                        "key": "processing",
                        "label": "Processing",
                        "orders": 20,
                        "share": 16.67
                      }
                    ],
                    "discounted": {
                      "orders": 25,
                      "share": 20.83
                    },
                    "fulfillment": {
                      "orders": 30,
                      "statuses": [
                        {
                          "key": "shipped",
                          "label": "Shipped",
                          "orders": 20,
                          "share": 66.67
                        },
                        {
                          "key": "unshipped",
                          "label": "Unshipped",
                          "orders": 10,
                          "share": 33.33
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "total": 120,
                  "types": [
                    {
                      "key": "payment",
                      "label": "One-time",
                      "orders": 80,
                      "share": 66.67
                    },
                    {
                      "key": "renewal",
                      "label": "Renewal",
                      "orders": 40,
                      "share": 33.33
                    }
                  ],
                  "statuses": [
                    {
                      "key": "completed",
                      "label": "Completed",
                      "orders": 100,
                      "share": 83.33
                    },
                    {
                      "key": "processing",
                      "label": "Processing",
                      "orders": 20,
                      "share": 16.67
                    }
                  ],
                  "discounted": {
                    "orders": 25,
                    "share": 20.83
                  },
                  "fulfillment": {
                    "orders": 30,
                    "statuses": [
                      {
                        "key": "shipped",
                        "label": "Shipped",
                        "orders": 20,
                        "share": 66.67
                      },
                      {
                        "key": "unshipped",
                        "label": "Unshipped",
                        "orders": 10,
                        "share": 33.33
                      }
                    ]
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "total": 120,
                      "types": [
                        {
                          "key": "payment",
                          "label": "One-time",
                          "orders": 80,
                          "share": 66.67
                        },
                        {
                          "key": "renewal",
                          "label": "Renewal",
                          "orders": 40,
                          "share": 33.33
                        }
                      ],
                      "statuses": [
                        {
                          "key": "completed",
                          "label": "Completed",
                          "orders": 100,
                          "share": 83.33
                        },
                        {
                          "key": "processing",
                          "label": "Processing",
                          "orders": 20,
                          "share": 16.67
                        }
                      ],
                      "discounted": {
                        "orders": 25,
                        "share": 20.83
                      },
                      "fulfillment": {
                        "orders": 30,
                        "statuses": [
                          {
                            "key": "shipped",
                            "label": "Shipped",
                            "orders": 20,
                            "share": 66.67
                          },
                          {
                            "key": "unshipped",
                            "label": "Unshipped",
                            "orders": 10,
                            "share": 33.33
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
