{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/order-value-distribution": {
      "get": {
        "operationId": "getOrderValueDistribution",
        "summary": "GET Get Order Value Distribution",
        "description": "Retrieve the distribution of orders by their total value, showing how orders are spread across different price ranges.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "monthly",
                "yearly",
                "billing_country",
                "shipping_country",
                "payment_method",
                "payment_status"
              ]
            },
            "description": "Grouping interval for data aggregation.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "Currency code to filter by.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Payment mode filter.",
            "required": false
          },
          {
            "name": "params[variation_ids]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Array of product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period type.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Custom comparison start date. Required when compareType is custom.",
            "required": false
          },
          {
            "name": "params[paymentStatus]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Payment status filter.",
            "required": false
          },
          {
            "name": "params[orderTypes]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Order type filter (e.g., one-time, subscription).",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Order counts bucketed by fixed $100-wide order-value ranges (order total_amount, in dollars).",
                      "properties": {
                        "0-100": {
                          "type": "integer",
                          "description": "Order count for orders totaling $0\u2013$100."
                        },
                        "100-200": {
                          "type": "integer",
                          "description": "Order count for orders totaling $100\u2013$200."
                        },
                        "200-300": {
                          "type": "integer",
                          "description": "Order count for orders totaling $200\u2013$300."
                        },
                        "300-400": {
                          "type": "integer",
                          "description": "Order count for orders totaling $300\u2013$400."
                        },
                        "400-500": {
                          "type": "integer",
                          "description": "Order count for orders totaling $400\u2013$500."
                        },
                        "500-600": {
                          "type": "integer",
                          "description": "Order count for orders totaling $500\u2013$600."
                        },
                        "600-700": {
                          "type": "integer",
                          "description": "Order count for orders totaling $600\u2013$700."
                        },
                        "700-800": {
                          "type": "integer",
                          "description": "Order count for orders totaling $700\u2013$800."
                        },
                        "800-900": {
                          "type": "integer",
                          "description": "Order count for orders totaling $800\u2013$900."
                        },
                        "900-1000": {
                          "type": "integer",
                          "description": "Order count for orders totaling $900\u2013$1000."
                        },
                        "1000+": {
                          "type": "integer",
                          "description": "Order count for orders totaling more than $1000."
                        }
                      }
                    }
                  },
                  "example": {
                    "data": {
                      "0-100": 28,
                      "100-200": 82,
                      "200-300": 45,
                      "300-400": 30,
                      "400-500": 22,
                      "500-600": 15,
                      "600-700": 10,
                      "700-800": 6,
                      "800-900": 4,
                      "900-1000": 3,
                      "1000+": 6
                    }
                  }
                },
                "example": {
                  "data": {
                    "0-100": 28,
                    "100-200": 82,
                    "200-300": 45,
                    "300-400": 30,
                    "400-500": 22,
                    "500-600": 15,
                    "600-700": 10,
                    "700-800": 6,
                    "800-900": 4,
                    "900-1000": 3,
                    "1000+": 6
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "data": {
                        "0-100": 28,
                        "100-200": 82,
                        "200-300": 45,
                        "300-400": 30,
                        "400-500": 22,
                        "500-600": 15,
                        "600-700": 10,
                        "700-800": 6,
                        "800-900": 4,
                        "900-1000": 3,
                        "1000+": 6
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
