                        "failed_charges": 2,
                        "failed_charge_amount": 100.0,
                        "failing_subscriptions": 1,
                        "mrr_at_risk": 20.0,
                        "net_share": 100,
                        "dispute_rate": 0
                      },
                      "previous": null,
                      "chart": [
                        {
                          "year": "2025",
                          "group": "2025-01-01",
                          "gateways": {
                            "paypal": 30.0,
                            "stripe": 120.0
                          }
                        }
                      ],
                      "compare_ranges": {
                        "previous_period": {
                          "start": "2024-12-01 00:00:00",
                          "end": "2024-12-31 23:59:59"
                        },
                        "previous_month": {
                          "start": "2024-12-01 00:00:00",
