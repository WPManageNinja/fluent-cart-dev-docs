{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/product-detail": {
      "get": {
        "operationId": "getProductDetail",
        "summary": "GET Get Product Detail",
        "description": "Returns the detail of one product: its paid orders in the range, the products bought in the same orders, and its subscriptions. Subscription `mrr` values are in decimal currency units (not cents).\n\nOrders count only paid orders (`total_paid` > 0) that are not renewals. `bought_together` lists at most 5 products; `share` is the percent of this product's orders that also hold the other product. `subscriptions` covers every variant of the product: live count and MRR now, and renewals paid and lost in the range. It is `null` when no variant or subscription of the product is found.\n\n**Requires FluentCart Pro.** Without Pro this route is not registered and returns 404.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "The product (post) ID. Top-level, not inside `params`.",
            "required": true
          },
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range (Y-m-d), store timezone.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range (Y-m-d), store timezone.",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code, or `__all__` for all currencies converted to the base currency. Default: the base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Live or test orders only. Default: both.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Sale types to include. Default: all.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Limit to these variants of the product. Default: all of its variants.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "orders": 120,
                    "bought_together": [
                      {
                        "product_id": 55,
                        "product_title": "Add-on Pack",
                        "orders": 30,
                        "share": 25.0
                      }
                    ],
                    "subscriptions": {
                      "subscriptions": 40,
                      "mrr": 1200.0,
                      "canceling": {
                        "count": 3,
                        "mrr": 90.0
                      },
                      "failing": {
                        "count": 2,
                        "mrr": 60.0
                      },
                      "renewals_paid": 25,
                      "renewals_lost": 5,
                      "renewal_rate": 83.3
                    }
                  }
                },
                "example": {
                  "orders": 120,
                  "bought_together": [
                    {
                      "product_id": 55,
                      "product_title": "Add-on Pack",
                      "orders": 30,
                      "share": 25.0
                    }
                  ],
                  "subscriptions": {
                    "subscriptions": 40,
                    "mrr": 1200.0,
                    "canceling": {
                      "count": 3,
                      "mrr": 90.0
                    },
                    "failing": {
                      "count": 2,
                      "mrr": 60.0
                    },
                    "renewals_paid": 25,
                    "renewals_lost": 5,
                    "renewal_rate": 83.3
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "orders": 120,
                      "bought_together": [
                        {
                          "product_id": 55,
                          "product_title": "Add-on Pack",
                          "orders": 30,
                          "share": 25.0
                        }
                      ],
                      "subscriptions": {
                        "subscriptions": 40,
                        "mrr": 1200.0,
                        "canceling": {
                          "count": 3,
                          "mrr": 90.0
                        },
                        "failing": {
                          "count": 2,
                          "mrr": 60.0
                        },
                        "renewals_paid": 25,
                        "renewals_lost": 5,
                        "renewal_rate": 83.3
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
