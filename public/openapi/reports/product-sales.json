                      "end": "2024-01-31 23:59:59"
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "summary": {
                        "gross": 250000,
                        "refunds": 10000,
                        "net": 220000,
                        "new_net": 150000,
                        "renewal_net": 60000,
                        "installment_net": 10000,
                        "units": 120,
                        "orders": 100,
                        "customers": 80,
