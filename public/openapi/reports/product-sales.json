                  ],
                  "chart": [
                    {
                      "year": "2025",
                      "group": "2025-01-01",
                      "units": 4,
                      "new_net": 5000,
                      "renewal_net": 2000,
                      "installment_net": 0
                    }
                  ],
                  "compare_ranges": {
                    "previous_period": {
                      "start": "2024-12-01 00:00:00",
                      "end": "2024-12-31 23:59:59"
                    },
                    "previous_month": {
                      "start": "2024-12-01 00:00:00",
                      "end": "2024-12-31 23:59:59"
                    },
                    "previous_quarter": {
