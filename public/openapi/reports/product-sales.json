{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/product-sales": {
      "get": {
        "operationId": "getProductSales",
        "summary": "GET Get Product Sales",
        "description": "Returns one row per product with its variations, the totals and a chart. Each order's payment, refunds and net sales are shared across its lines by line amount. Amounts are integers in cents; `net` is the Revenue report's net sales.\n\n`net` splits into `new_net` (non-renewal orders), `renewal_net` and `installment_net`. `units` leaves out signup-fee and fee lines. A $0 order counts as an order; `customers` and `new_customers` count paid orders only. `refund_rate` is `refunds` / `gross` as a percent. With a comparison, `previous` holds the comparison totals and each product gets `previous_net`; else `previous` and `previous_net` are `null`. Lines with no variation (fees, custom items) count in `summary` only.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "daily",
                "monthly",
                "yearly"
              ]
            },
            "description": "Chart bucket: `daily`, `monthly`, `yearly`, or `default` (picked from the range length).",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Only live or only test orders. Without it, both count.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain these variation IDs.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Start of the comparison range when `compareType` is `custom`.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Only these sale types. `renewal` leaves out installment payments.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "summary": {
                      "gross": 250000,
                      "refunds": 10000,
                      "net": 220000,
                      "new_net": 150000,
                      "renewal_net": 60000,
                      "installment_net": 10000,
                      "units": 120,
                      "orders": 100,
                      "customers": 80,
                      "new_customers": 50,
                      "refund_rate": 4.0,
                      "average_order": 2200
                    },
                    "previous": null,
                    "products": [
                      {
                        "product_id": 10,
                        "product_title": "Pro Plan",
                        "orders": 60,
                        "customers": 50,
                        "new_customers": 30,
                        "variations": [
                          {
                            "variation_id": 12,
                            "variation_title": "Yearly",
                            "orders": 60,
                            "gross": 150000,
                            "refunds": 5000,
                            "net": 135000,
                            "new_net": 90000,
                            "renewal_net": 45000,
                            "installment_net": 0,
                            "units": 60,
                            "customers": 50,
                            "new_customers": 30,
                            "refund_rate": 3.3
                          }
                        ],
                        "gross": 150000,
                        "refunds": 5000,
                        "net": 135000,
                        "new_net": 90000,
                        "renewal_net": 45000,
                        "installment_net": 0,
                        "units": 60,
                        "refund_rate": 3.3,
                        "previous_net": null
                      }
                    ],
                    "chart": [
                      {
                        "year": "2025",
                        "group": "2025-01-01",
                        "units": 4,
                        "new_net": 5000,
                        "renewal_net": 2000,
                        "installment_net": 0
                      }
                    ],
                    "compare_ranges": {
                      "previous_period": {
                        "start": "2024-12-01 00:00:00",
                        "end": "2024-12-31 23:59:59"
                      },
                      "previous_month": {
                        "start": "2024-12-01 00:00:00",
                        "end": "2024-12-31 23:59:59"
                      },
                      "previous_quarter": {
                        "start": "2024-10-01 00:00:00",
                        "end": "2024-10-31 23:59:59"
                      },
                      "previous_year": {
                        "start": "2024-01-01 00:00:00",
                        "end": "2024-01-31 23:59:59"
                      }
                    }
                  }
                },
                "example": {
                  "summary": {
                    "gross": 250000,
                    "refunds": 10000,
                    "net": 220000,
                    "new_net": 150000,
                    "renewal_net": 60000,
                    "installment_net": 10000,
                    "units": 120,
                    "orders": 100,
                    "customers": 80,
                    "new_customers": 50,
                    "refund_rate": 4.0,
                    "average_order": 2200
