{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/refunds-overview": {
      "get": {
        "operationId": "getRefundsOverview",
        "summary": "GET Get Refunds Overview",
        "description": "Returns the refunds made in the period: totals, full vs partial, a chart, splits by sale type and payment method, reasons and refund rates. Amounts are decimal currency units.\n\nMoney out counts on the refund date, on orders of any date. Refund rates divide by the orders placed in the period: `refund_rate_cohort` (period orders refunded at all), `refund_rate_orders` (orders refunded in the period / orders placed), `refund_rate_amount` (refunded amount / paid amount). A rate is `null` when no orders were placed. `median_days` counts store calendar days from order to its first refund. `by_product` (the 10 most refunded products, by order date) is a FluentCart Pro report: it appears only when the `fluent_cart/report/refund_products` filter returns true. With a comparison, `fluctuations` gives rates as a point difference and other keys as a percent change (`null` when the previous value is 0).\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last day of the range, store timezone (`YYYY-MM-DD`).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "daily",
                "monthly",
                "yearly"
              ]
            },
            "description": "Chart bucket: `daily`, `monthly`, `yearly`, or `default` (picked from the range length).",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. `__all__` converts every currency to the base currency. Default: base currency.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Only live or only test orders. Without it, both count.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Only orders that contain these variation IDs.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Start of the comparison range when `compareType` is `custom`.",
            "required": false
          },
          {
            "name": "params[orderTypes][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "payment",
                  "subscription",
                  "renewal",
                  "installment",
                  "installment_payment"
                ]
              }
            },
            "description": "Only these sale types. `renewal` leaves out installment payments.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "summary": {
                      "refunded_amount": 300.0,
                      "refunds": 6,
                      "refunded_orders": 5,
                      "average_refund": 50.0,
                      "full": {
                        "count": 3,
                        "amount": 220.0
                      },
                      "partial": {
                        "count": 2,
                        "amount": 80.0
                      },
                      "refund_rate_cohort": 4.0,
                      "refund_rate_orders": 5.0,
                      "refund_rate_amount": 3.5,
                      "median_days": 4.0
                    },
                    "chart": [
                      {
                        "year": "2025",
                        "group": "2025-01-01",
                        "amount": 50.0,
                        "count": 1,
                        "refunded_orders": 1,
                        "orders": 4,
                        "refund_rate": 25.0
                      }
                    ],
                    "by_sale_type": [
                      {
                        "key": "payment",
                        "label": "One-time",
                        "amount": 200.0,
                        "refunds": 4
                      }
                    ],
                    "by_payment_method": [
                      {
                        "key": "stripe",
                        "label": "stripe",
                        "amount": 250.0,
                        "refunds": 5
                      }
                    ],
                    "by_product": [
                      {
                        "variation_id": 12,
                        "product": "Pro Plan",
                        "variation": "Yearly",
                        "sold": 1000.0,
                        "refunded": 100.0,
                        "refunded_orders": 2,
