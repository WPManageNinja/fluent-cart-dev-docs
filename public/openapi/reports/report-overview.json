{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/report-overview": {
      "get": {
        "operationId": "getReportOverview",
        "summary": "GET Get Report Overview",
        "description": "Retrieve an aggregated report overview including order summary statistics and breakdowns by payment method.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[created_at]",
            "in": "query",
            "schema": {
              "type": "object"
            },
            "description": "Date filter with column, operator, and value keys.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_deprecated": {
                      "type": "string",
                      "description": "Present because this endpoint is deprecated since v1.4. Use GET /reports/overview instead."
                    },
                    "data": {
                      "type": "object",
                      "description": "Aggregated order totals for the filtered period. Note: values are numeric strings (raw SQL aggregate results) and amounts are in cents.",
                      "properties": {
                        "total_sales": {
                          "type": "string",
                          "description": "Total sales amount, in cents."
                        },
                        "net_sales": {
                          "type": "string",
                          "description": "Net sales amount (after discounts), in cents."
                        },
                        "total_discounts": {
                          "type": "string",
                          "description": "Total discount amount, in cents."
                        },
                        "total_shipping_tax": {
                          "type": "string",
                          "description": "Total shipping tax amount, in cents."
                        },
                        "average_order_value": {
                          "type": "string",
                          "description": "Average order value, in cents."
                        },
                        "customer_order_count": {
                          "type": "string",
                          "description": "Number of orders counted."
                        }
                      }
                    },
                    "orders_by_payment_method": {
                      "type": "array",
                      "description": "Order counts and transaction totals broken down by payment method.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "payment_method": {
                            "type": "string"
                          },
                          "order_count": {
                            "type": "string"
                          },
                          "transactions": {
                            "type": "string",
                            "description": "Total transaction amount for this payment method, in cents."
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/overview instead.",
                    "data": {
                      "total_sales": "1086707",
                      "net_sales": "1009851",
                      "total_discounts": "76856",
                      "total_shipping_tax": "0",
                      "average_order_value": "229.5051",
                      "customer_order_count": "473"
                    },
                    "orders_by_payment_method": [
                      {
                        "payment_method": "stripe",
                        "order_count": "421",
                        "transactions": "880637"
                      },
                      {
                        "payment_method": "offline_payment",
                        "order_count": "52",
                        "transactions": "26970"
                      }
                    ]
                  }
                },
                "example": {
                  "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/overview instead.",
                  "data": {
                    "total_sales": "1086707",
                    "net_sales": "1009851",
                    "total_discounts": "76856",
                    "total_shipping_tax": "0",
                    "average_order_value": "229.5051",
                    "customer_order_count": "473"
                  },
                  "orders_by_payment_method": [
                    {
                      "payment_method": "stripe",
                      "order_count": "421",
                      "transactions": "880637"
                    },
                    {
                      "payment_method": "offline_payment",
                      "order_count": "52",
                      "transactions": "26970"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/overview instead.",
                      "data": {
                        "total_sales": "1086707",
                        "net_sales": "1009851",
                        "total_discounts": "76856",
                        "total_shipping_tax": "0",
                        "average_order_value": "229.5051",
                        "customer_order_count": "473"
                      },
                      "orders_by_payment_method": [
                        {
                          "payment_method": "stripe",
                          "order_count": "421",
                          "transactions": "880637"
                        },
                        {
                          "payment_method": "offline_payment",
                          "order_count": "52",
                          "transactions": "26970"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
