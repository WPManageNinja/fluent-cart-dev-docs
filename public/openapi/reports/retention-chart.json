{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/retention-chart": {
      "get": {
        "operationId": "getRetentionChart",
        "summary": "GET Get Retention Chart",
        "description": "Retrieve subscription retention data as chart data, showing how many subscribers remain active over time.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "Start date for the report period.",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-12-31"
            },
            "description": "End date for the report period.",
            "required": false
          },
          {
            "name": "params[groupKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "monthly",
                "yearly",
                "billing_country",
                "shipping_country",
                "payment_method",
                "payment_status"
              ]
            },
            "description": "Grouping interval for data aggregation.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "Currency code to filter by.",
            "required": false
          },
          {
            "name": "params[filterMode]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "test"
              ]
            },
            "description": "Payment mode filter.",
            "required": false
          },
          {
            "name": "params[variation_ids]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Array of product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[compareType]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "previous_period",
                "previous_month",
                "previous_quarter",
                "previous_year",
                "custom"
              ]
            },
            "description": "Comparison period type.",
            "required": false
          },
          {
            "name": "params[compareDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Custom comparison start date. Required when compareType is custom.",
            "required": false
          },
          {
            "name": "params[customDays]",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 90
            },
            "description": "Custom number of days for the retention period.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chartData": {
                      "$ref": "#/components/schemas/RetentionChartData"
                    }
                  },
                  "example": {
                    "chartData": {
                      "day_7": 12,
                      "day_15": 9,
                      "day_30": 24,
                      "day_90": 41,
                      "day_180": 33,
                      "day_365": 28,
                      "more_than_year": 36
                    }
                  }
                },
                "example": {
                  "chartData": {
                    "day_7": 12,
                    "day_15": 9,
                    "day_30": 24,
                    "day_90": 41,
                    "day_180": 33,
                    "day_365": 28,
                    "more_than_year": 36
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "chartData": {
                        "day_7": 12,
                        "day_15": 9,
                        "day_30": 24,
                        "day_90": 41,
                        "day_180": 33,
                        "day_365": 28,
                        "more_than_year": 36
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RetentionChartData": {
        "type": "object",
        "description": "Count of subscriptions falling into each lifespan bucket (measured in days from creation to cancellation, or to now if still active). When `params[customDays]` is supplied, the response instead contains a single dynamic key `day_{customDays}` with the count for that custom window, in place of the fixed buckets below.",
        "properties": {
          "day_7": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan of 0-7 days. Null when there is no matching data for the selected range.",
            "example": 12
          },
          "day_15": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan of 8-15 days",
            "example": 9
          },
          "day_30": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan of 16-30 days",
            "example": 24
          },
          "day_90": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan of 31-90 days",
            "example": 41
          },
          "day_180": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan of 91-180 days",
            "example": 33
          },
          "day_365": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan of 181-365 days",
            "example": 28
          },
          "more_than_year": {
            "type": "integer",
            "nullable": true,
            "description": "Subscriptions with a lifespan greater than 365 days",
            "example": 36
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
