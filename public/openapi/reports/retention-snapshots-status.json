{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/retention-snapshots/status": {
      "get": {
        "operationId": "getRetentionSnapshotStatus",
        "summary": "GET Get Retention Snapshot Status",
        "description": "Returns the state of a snapshot job started by `POST /reports/retention-snapshots/generate`: `running`, `completed` or `failed`.\n\nA missing or unknown job ID returns HTTP 200 with `success: false` and a message. `data` is the stored job record.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[job_id]",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "The `job_id` from the generate response.",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "success": true,
                    "status": "completed",
                    "message": "Retention snapshots generated successfully",
                    "stats": {
                      "total_records": 5000,
                      "unique_cohorts": 24,
                      "unique_periods": 36,
                      "unique_products": 6
                    },
                    "data": {
                      "status": "completed",
                      "started_at": "2025-01-31 10:00:00",
                      "completed_at": "2025-01-31 10:00:00",
                      "product_id": null,
                      "message": "Retention snapshots generated successfully",
                      "stats": {
                        "total_records": 5000,
                        "unique_cohorts": 24,
                        "unique_periods": 36,
                        "unique_products": 6
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "status": "completed",
                  "message": "Retention snapshots generated successfully",
                  "stats": {
                    "total_records": 5000,
                    "unique_cohorts": 24,
                    "unique_periods": 36,
                    "unique_products": 6
                  },
                  "data": {
                    "status": "completed",
                    "started_at": "2025-01-31 10:00:00",
                    "completed_at": "2025-01-31 10:00:00",
                    "product_id": null,
                    "message": "Retention snapshots generated successfully",
                    "stats": {
                      "total_records": 5000,
                      "unique_cohorts": 24,
                      "unique_periods": 36,
                      "unique_products": 6
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "success": true,
                      "status": "completed",
                      "message": "Retention snapshots generated successfully",
                      "stats": {
                        "total_records": 5000,
                        "unique_cohorts": 24,
                        "unique_periods": 36,
                        "unique_products": 6
                      },
                      "data": {
                        "status": "completed",
                        "started_at": "2025-01-31 10:00:00",
                        "completed_at": "2025-01-31 10:00:00",
                        "product_id": null,
                        "message": "Retention snapshots generated successfully",
                        "stats": {
                          "total_records": 5000,
                          "unique_cohorts": 24,
                          "unique_periods": 36,
                          "unique_products": 6
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
