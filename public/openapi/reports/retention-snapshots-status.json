{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/retention-snapshots/status": {
      "get": {
        "operationId": "getRetentionSnapshotStatus",
        "summary": "GET Check Retention Snapshot Status",
        "description": "Check the status of a previously queued retention snapshot generation job.\n\n**Access policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[job_id]",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 1718456789
            },
            "description": "The job ID returned from the retention-snapshots/generate endpoint.",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the lookup was successful. `false` when `params[job_id]` is missing or no job is found for that ID \u2014 in that case `status` and `data` are omitted."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "running",
                        "completed",
                        "failed"
                      ],
                      "description": "Job status. Only present when a valid job was found (i.e. when `success` is true, or when `success` is false because the job was not found \u2014 see `job_id` in that case)."
                    },
                    "message": {
                      "type": "string",
                      "description": "Status message"
                    },
                    "job_id": {
                      "type": "string",
                      "description": "Echoes back `params[job_id]`. Only present in the 'job not found' error response.",
                      "example": "1718456789"
                    },
                    "stats": {
                      "type": "object",
                      "description": "Snapshot generation statistics. Only present once the job has reached `completed` or `failed` status."
                    },
                    "data": {
                      "type": "object",
                      "description": "Raw job record as stored for this job ID. Present whenever a job was found (running, completed, or failed)."
                    }
                  },
                  "example": {
                    "success": true,
                    "status": "running",
                    "message": "Job is still running",
                    "data": {
                      "status": "pending",
                      "started_at": "2025-06-15 14:30:00",
                      "product_id": 42
                    }
                  }
                },
                "example": {
                  "success": true,
                  "status": "running",
                  "message": "Job is still running",
                  "data": {
                    "status": "pending",
                    "started_at": "2025-06-15 14:30:00",
                    "product_id": 42
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response \u2014 job still running",
                    "value": {
                      "success": true,
                      "status": "running",
                      "message": "Job is still running",
                      "data": {
                        "status": "pending",
                        "started_at": "2025-06-15 14:30:00",
                        "product_id": 42
                      }
                    }
                  },
                  "missingJobId": {
                    "summary": "params[job_id] not supplied",
                    "value": {
                      "success": false,
                      "message": "Job ID required"
                    }
                  },
                  "jobNotFound": {
                    "summary": "No job found for the given job_id",
                    "value": {
                      "success": false,
                      "message": "Job not found",
                      "job_id": "1718456789"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
