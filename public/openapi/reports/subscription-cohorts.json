{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/subscription-cohorts": {
      "get": {
        "operationId": "getSubscriptionCohorts",
        "summary": "GET Get Subscription Cohorts",
        "description": "Returns subscription cohort retention from the retention snapshots table, by start month or start year. MRR values are decimals.\n\nThe date range does not apply: month view shows the last 24 months of cohorts, year view every year. One currency only (`__all__` is read as the base currency). `metric=mrr`, `billingInterval` and `rebuyAdjusted` need FluentCart Pro (`fluent_cart/report/cohort_options`); without it the metric is `subscribers` and `full` is false. Build the snapshots with `POST /reports/retention-snapshots/generate`.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. Defaults to the base currency. `__all__` is read as the base currency.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[groupBy]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "month",
                "year"
              ]
            },
            "description": "Cohort size. Default `year`.",
            "required": false
          },
          {
            "name": "params[metric]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "subscribers",
                "mrr"
              ]
            },
            "description": "Metric to show (Pro). Default `subscribers`.",
            "required": false
          },
          {
            "name": "params[billingInterval]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only cohorts of this billing interval (Pro).",
            "required": false
          },
          {
            "name": "params[rebuyAdjusted]",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Count a cancel-and-rebuy as retained (Pro).",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "cohorts": [
                      {
                        "cohort": "2024",
                        "start_mrr": 3000.0,
                        "start_count": 100,
                        "periods": [
                          {
                            "offset": 1,
                            "retained_mrr": 2400.0,
                            "retained_count": 80,
                            "churned_mrr": 600.0,
                            "churned_count": 20,
                            "retention_rate_mrr": 80.0,
                            "retention_rate_count": 80.0,
                            "retention_rate_previous_mrr": 80.0,
                            "retention_rate_previous_count": 80.0,
                            "churn_rate_total_mrr": 20.0,
                            "churn_rate_total_count": 20.0,
                            "base_mrr": 3000.0,
                            "base_count": 100,
                            "partial": false,
                            "matured_cohorts": 12,
                            "total_cohorts": 12
                          }
                        ]
                      }
                    ],
                    "weighted_averages": [
                      {
                        "offset": 1,
                        "weighted_avg_mrr": 80.0,
                        "weighted_avg_count": 80.0,
                        "weighted_avg_prev_mrr": 80.0,
                        "weighted_avg_prev_count": 80.0,
                        "weighted_avg_churn_mrr": 20.0,
                        "weighted_avg_churn_count": 20.0
                      }
                    ],
                    "group_by": "year",
                    "metric": "subscribers",
                    "max_periods": 8,
                    "generated_at": "2025-01-31 10:00:00",
                    "intervals": [
                      "month",
                      "year"
                    ],
                    "full": true
                  }
                },
                "example": {
                  "cohorts": [
                    {
                      "cohort": "2024",
                      "start_mrr": 3000.0,
                      "start_count": 100,
                      "periods": [
                        {
                          "offset": 1,
                          "retained_mrr": 2400.0,
                          "retained_count": 80,
                          "churned_mrr": 600.0,
                          "churned_count": 20,
                          "retention_rate_mrr": 80.0,
                          "retention_rate_count": 80.0,
                          "retention_rate_previous_mrr": 80.0,
                          "retention_rate_previous_count": 80.0,
                          "churn_rate_total_mrr": 20.0,
                          "churn_rate_total_count": 20.0,
                          "base_mrr": 3000.0,
                          "base_count": 100,
                          "partial": false,
                          "matured_cohorts": 12,
                          "total_cohorts": 12
                        }
                      ]
                    }
                  ],
                  "weighted_averages": [
                    {
                      "offset": 1,
                      "weighted_avg_mrr": 80.0,
                      "weighted_avg_count": 80.0,
                      "weighted_avg_prev_mrr": 80.0,
                      "weighted_avg_prev_count": 80.0,
                      "weighted_avg_churn_mrr": 20.0,
                      "weighted_avg_churn_count": 20.0
                    }
                  ],
                  "group_by": "year",
                  "metric": "subscribers",
                  "max_periods": 8,
                  "generated_at": "2025-01-31 10:00:00",
                  "intervals": [
                    "month",
                    "year"
                  ],
                  "full": true
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "cohorts": [
                        {
                          "cohort": "2024",
                          "start_mrr": 3000.0,
                          "start_count": 100,
                          "periods": [
                            {
                              "offset": 1,
                              "retained_mrr": 2400.0,
                              "retained_count": 80,
                              "churned_mrr": 600.0,
                              "churned_count": 20,
                              "retention_rate_mrr": 80.0,
                              "retention_rate_count": 80.0,
                              "retention_rate_previous_mrr": 80.0,
                              "retention_rate_previous_count": 80.0,
                              "churn_rate_total_mrr": 20.0,
                              "churn_rate_total_count": 20.0,
                              "base_mrr": 3000.0,
                              "base_count": 100,
                              "partial": false,
                              "matured_cohorts": 12,
                              "total_cohorts": 12
                            }
                          ]
                        }
                      ],
                      "weighted_averages": [
                        {
                          "offset": 1,
                          "weighted_avg_mrr": 80.0,
                          "weighted_avg_count": 80.0,
                          "weighted_avg_prev_mrr": 80.0,
                          "weighted_avg_prev_count": 80.0,
                          "weighted_avg_churn_mrr": 20.0,
                          "weighted_avg_churn_count": 20.0
                        }
                      ],
                      "group_by": "year",
                      "metric": "subscribers",
                      "max_periods": 8,
                      "generated_at": "2025-01-31 10:00:00",
                      "intervals": [
                        "month",
                        "year"
                      ],
                      "full": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
