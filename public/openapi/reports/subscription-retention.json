{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/subscription-retention": {
      "get": {
        "operationId": "getSubscriptionRetention",
        "summary": "GET Get Subscription Retention",
        "description": "Returns one row per store month (or year) in the range: new, churned, retained and active subscriptions, MRR, churn reasons and the renewal rate. MRR and `period_gross` are decimals.\n\nOpen-ended plans only. Retained = the starting base still active at period end. `retained_mrr`, `mrr` and `start_mrr` are decimal strings. `intervals` lists the billing intervals that have subscriptions, most first. The range end is clamped to today.\n\n**Permission:** `reports/view` \u00b7 **Policy:** `ReportPolicy`",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "params[startDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-01"
            },
            "description": "First store day of the range (Y-m-d).",
            "required": false
          },
          {
            "name": "params[endDate]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            },
            "description": "Last store day of the range (Y-m-d).",
            "required": false
          },
          {
            "name": "params[rangeKey]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "last_7",
                "last_30",
                "this_month",
                "last_month",
                "last_12_months",
                "year_to_date",
                "all_time"
              ]
            },
            "description": "Preset range relative to today. Overrides the dates.",
            "required": false
          },
          {
            "name": "params[currency]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "USD"
            },
            "description": "3-letter currency code. Defaults to the base currency. `__all__` converts every currency to the base currency.",
            "required": false
          },
          {
            "name": "params[variation_ids][]",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Product variation IDs to filter by.",
            "required": false
          },
          {
            "name": "params[period]",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "month",
                "year"
              ]
            },
            "description": "Row size. `year` gives one row per year; any other value one row per month.",
            "required": false
          },
          {
            "name": "params[billingInterval]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only subscriptions with this billing interval, e.g. `month` or `year`.",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "retention_data": [
                      {
                        "day": "2025-01-31",
                        "week": "2025-05",
                        "group": "2025-01",
                        "year": "2025",
                        "is_complete": true,
                        "is_running": false,
                        "new_subscriptions": 40,
                        "new_subscriptions_mrr": 1200.0,
                        "churned_subscriptions": 10,
                        "churned_subscriptions_mrr": 300.0,
                        "churned_new_subscriptions": 2,
                        "left_by_reason": {
                          "canceled": 6,
                          "payment_failed": 2,
                          "retrying": 1,
                          "paused": 1,
                          "completed": 0
                        },
                        "renewals_paid": 190,
                        "renewals_lost": 10,
                        "renewals_retrying": 3,
                        "renewal_rate": 95.0,
                        "retained_subscriptions": 490,
                        "retained_mrr": "14700.00",
                        "active_subscriptions": "528",
                        "active_paid_subscriptions": "520",
                        "active_free_subscriptions": "8",
                        "mrr": "15600.00",
                        "start_subscriptions": 500,
                        "start_mrr": "15000.00",
                        "retention_rate": 98.0,
                        "retention_rate_money": 98.0,
                        "period_gross": 1200.0,
                        "period_subscriptions": 40
                      }
                    ],
                    "intervals": [
                      "month",
                      "year"
                    ]
                  }
                },
                "example": {
                  "retention_data": [
                    {
                      "day": "2025-01-31",
                      "week": "2025-05",
                      "group": "2025-01",
                      "year": "2025",
                      "is_complete": true,
                      "is_running": false,
                      "new_subscriptions": 40,
                      "new_subscriptions_mrr": 1200.0,
                      "churned_subscriptions": 10,
                      "churned_subscriptions_mrr": 300.0,
                      "churned_new_subscriptions": 2,
                      "left_by_reason": {
                        "canceled": 6,
                        "payment_failed": 2,
                        "retrying": 1,
                        "paused": 1,
                        "completed": 0
                      },
                      "renewals_paid": 190,
                      "renewals_lost": 10,
                      "renewals_retrying": 3,
                      "renewal_rate": 95.0,
                      "retained_subscriptions": 490,
                      "retained_mrr": "14700.00",
                      "active_subscriptions": "528",
                      "active_paid_subscriptions": "520",
                      "active_free_subscriptions": "8",
                      "mrr": "15600.00",
                      "start_subscriptions": 500,
                      "start_mrr": "15000.00",
                      "retention_rate": 98.0,
                      "retention_rate_money": 98.0,
                      "period_gross": 1200.0,
                      "period_subscriptions": 40
                    }
                  ],
                  "intervals": [
                    "month",
                    "year"
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "retention_data": [
                        {
                          "day": "2025-01-31",
                          "week": "2025-05",
                          "group": "2025-01",
                          "year": "2025",
                          "is_complete": true,
                          "is_running": false,
                          "new_subscriptions": 40,
                          "new_subscriptions_mrr": 1200.0,
                          "churned_subscriptions": 10,
                          "churned_subscriptions_mrr": 300.0,
                          "churned_new_subscriptions": 2,
                          "left_by_reason": {
                            "canceled": 6,
                            "payment_failed": 2,
                            "retrying": 1,
                            "paused": 1,
                            "completed": 0
                          },
                          "renewals_paid": 190,
                          "renewals_lost": 10,
                          "renewals_retrying": 3,
                          "renewal_rate": 95.0,
                          "retained_subscriptions": 490,
                          "retained_mrr": "14700.00",
                          "active_subscriptions": "528",
                          "active_paid_subscriptions": "520",
                          "active_free_subscriptions": "8",
                          "mrr": "15600.00",
                          "start_subscriptions": 500,
                          "start_mrr": "15000.00",
                          "retention_rate": 98.0,
                          "retention_rate_money": 98.0,
                          "period_gross": 1200.0,
                          "period_subscriptions": 40
                        }
                      ],
                      "intervals": [
                        "month",
                        "year"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
