{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/reports/top-products-sold": {
      "get": {
        "operationId": "getTopProductsSold",
        "summary": "GET Get Top Products Sold",
        "description": "**Deprecated since v1.4** \u2014 use `GET /reports/fetch-top-sold-products` instead. Retrieve the top 5 products by total quantity sold, using the Resource API layer. The response always includes a `_deprecated` notice alongside the data.\n\n**Access policy:** `ReportPolicy`",
        "deprecated": true,
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_deprecated": {
                      "type": "string",
                      "description": "Deprecation notice always included in the response.",
                      "example": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/fetch-top-sold-products instead."
                    },
                    "top_products_sold": {
                      "type": "array",
                      "description": "Top 5 products by total quantity sold (descending).",
                      "items": {
                        "$ref": "#/components/schemas/TopProductSoldRow"
                      }
                    }
                  },
                  "example": {
                    "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/fetch-top-sold-products instead.",
                    "top_products_sold": [
                      {
                        "post_id": 123,
                        "total_sold": 142,
                        "product": {
                          "ID": 123,
                          "post_title": "Developer Toolkit Pro"
                        }
                      },
                      {
                        "post_id": 125,
                        "total_sold": 98,
                        "product": {
                          "ID": 125,
                          "post_title": "API Testing Suite"
                        }
                      }
                    ]
                  }
                },
                "example": {
                  "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/fetch-top-sold-products instead.",
                  "top_products_sold": [
                    {
                      "post_id": 123,
                      "total_sold": 142,
                      "product": {
                        "ID": 123,
                        "post_title": "Developer Toolkit Pro"
                      }
                    },
                    {
                      "post_id": 125,
                      "total_sold": 98,
                      "product": {
                        "ID": 125,
                        "post_title": "API Testing Suite"
                      }
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/fetch-top-sold-products instead.",
                      "top_products_sold": [
                        {
                          "post_id": 123,
                          "total_sold": 142,
                          "product": {
                            "ID": 123,
                            "post_title": "Developer Toolkit Pro"
                          }
                        },
                        {
                          "post_id": 125,
                          "total_sold": 98,
                          "product": {
                            "ID": 125,
                            "post_title": "API Testing Suite"
                          }
                        }
                      ]
                    }
                  },
                  "empty": {
                    "summary": "No order items found for the query",
                    "value": {
                      "_deprecated": "This endpoint is deprecated since v1.4 and will be removed in a future release. Use GET /fluent-cart/v2/reports/fetch-top-sold-products instead.",
                      "top_products_sold": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TopProductSoldRow": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "integer",
            "description": "Product post ID",
            "example": 123
          },
          "total_sold": {
            "type": "integer",
            "description": "Total quantity sold (SUM of order item quantity), grouped by product",
            "example": 142
          },
          "product": {
            "type": "object",
            "description": "Eager-loaded product relation (only ID and title are selected)",
            "properties": {
              "ID": {
                "type": "integer",
                "example": 123
              },
              "post_title": {
                "type": "string",
                "example": "Developer Toolkit Pro"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
