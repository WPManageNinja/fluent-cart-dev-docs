{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/payment-methods/paypal/webhook/check": {
      "get": {
        "operationId": "checkPaypalWebhook",
        "summary": "GET Check PayPal Webhook",
        "description": "Verify the current PayPal webhook registration status and set up the webhook if it is missing. If no PayPal API key has been connected yet for the given `mode`, returns `status`/`message` explaining that PayPal must be connected first. Otherwise it looks up (or registers) the webhook and returns the raw PayPal webhook object (`id`, `url`, `event_types`, `status`) verbatim.\n\n**Required permission:** `super_admin`",
        "tags": [
          "Settings"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "test",
                "live"
              ],
              "example": "live"
            },
            "description": "Environment mode: `test` or `live`."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns either a not-connected status message, or the webhook configuration details from PayPal.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Webhook status. Shape depends on whether a PayPal API key is already connected for `mode` (see examples).",
                  "additionalProperties": true,
                  "example": {
                    "status": "false",
                    "message": "No API key found for webhook setup. Please connect your PayPal account first."
                  }
                },
                "example": {
                  "status": "false",
                  "message": "No API key found for webhook setup. Please connect your PayPal account first."
                },
                "examples": {
                  "default": {
                    "summary": "No PayPal API key connected for this mode",
                    "value": {
                      "status": "false",
                      "message": "No API key found for webhook setup. Please connect your PayPal account first."
                    }
                  },
                  "webhookActive": {
                    "summary": "PayPal API key connected \u2014 webhook found or newly registered",
                    "value": {
                      "id": "WH-LIVE-80021663MN711374V",
                      "url": "https://example.com/wp-json/fluent-cart/v2/webhook/paypal",
                      "event_types": [
                        {
                          "name": "PAYMENT.CAPTURE.COMPLETED",
                          "description": "Payment capture completed"
                        },
                        {
                          "name": "PAYMENT.CAPTURE.REFUNDED",
                          "description": "Payment capture refunded"
                        },
                        {
                          "name": "BILLING.SUBSCRIPTION.ACTIVATED",
                          "description": "Subscription activated"
                        },
                        {
                          "name": "BILLING.SUBSCRIPTION.CANCELLED",
                          "description": "Subscription cancelled"
                        },
                        {
                          "name": "BILLING.SUBSCRIPTION.PAYMENT.FAILED",
                          "description": "Subscription payment failed"
                        }
                      ],
                      "status": "ACTIVE"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`super_admin`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
