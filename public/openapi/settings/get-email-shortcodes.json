                        "order": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string",
                              "example": "Order"
                            },
                            "key": {
                              "type": "string",
                              "description": "Internal group key used to namespace the shortcodes."
                            },
                            "shortcodes": {
                              "type": "object",
                              "description": "Map of shortcode tag to human-readable label.",
