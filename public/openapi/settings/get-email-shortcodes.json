      "get": {
        "operationId": "getEmailShortcodes",
        "summary": "GET Get Email Shortcodes",
        "description": "Retrieve available shortcodes/merge tags that can be used in email notification templates and confirmation messages.\n\n**Required permission:** `is_super_admin`",
