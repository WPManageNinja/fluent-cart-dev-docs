{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/storage-drivers/bucket-list": {
      "post": {
        "operationId": "listBuckets",
        "summary": "POST List Storage Buckets",
        "description": "List the buckets available to a storage driver's credentials, without saving them. Used by the settings UI to populate a bucket picker while a driver is being configured.\n\n**Required permission:** `is_super_admin`",
        "tags": [
          "Settings"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "driver",
                  "settings"
                ],
                "properties": {
                  "driver": {
                    "type": "string",
                    "description": "The storage driver key (e.g., `s3`, `bunny`).",
                    "example": "s3"
                  },
                  "settings": {
                    "type": "object",
                    "description": "Driver-specific credentials used to authenticate and list buckets. Fields vary by driver.",
                    "additionalProperties": true,
                    "example": {
                      "access_key": "AKIAEXAMPLE1234",
                      "secret_key": "your-secret-key-here",
                      "region": "us-east-1"
                    }
                  },
                  "query": {
                    "type": "string",
                    "description": "Optional search string to filter the bucket list by name.",
                    "example": "store"
                  }
                },
                "example": {
                  "driver": "s3",
                  "settings": {
                    "access_key": "AKIAEXAMPLE1234",
                    "secret_key": "your-secret-key-here",
                    "region": "us-east-1"
                  },
                  "query": "store"
                }
              },
              "example": {
                "driver": "s3",
                "settings": {
                  "access_key": "AKIAEXAMPLE1234",
                  "secret_key": "your-secret-key-here",
                  "region": "us-east-1"
                },
                "query": "store"
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "driver": "s3",
                    "settings": {
                      "access_key": "AKIAEXAMPLE1234",
                      "secret_key": "your-secret-key-here",
                      "region": "us-east-1"
                    },
                    "query": "store"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response. Returns the matching buckets as select-style options.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "options": [
                      {
                        "id": "my-store-files",
                        "title": "my-store-files"
                      },
                      {
                        "id": "my-store-backups",
                        "title": "my-store-backups"
                      }
                    ]
                  }
                },
                "example": {
                  "options": [
                    {
                      "id": "my-store-files",
                      "title": "my-store-files"
                    },
                    {
                      "id": "my-store-backups",
                      "title": "my-store-backups"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "options": [
                        {
                          "id": "my-store-files",
                          "title": "my-store-files"
                        },
                        {
                          "id": "my-store-backups",
                          "title": "my-store-backups"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The driver could not be resolved, or the driver's credentials were rejected while listing buckets.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Could not connect to the storage provider with the supplied credentials.",
                  "error_data": null
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`is_super_admin`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
