{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/settings/storage-drivers/reset": {
      "post": {
        "operationId": "resetSettings",
        "summary": "POST Reset Storage Driver Settings",
        "description": "Reset a storage driver's saved settings (including any stored credentials) back to its defaults. The returned settings omit the driver's hidden/secret keys.\n\n**Required permission:** `is_super_admin`",
        "tags": [
          "Settings"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "driver"
                ],
                "properties": {
                  "driver": {
                    "type": "string",
                    "description": "The storage driver key to reset (e.g., `s3`, `local`).",
                    "example": "s3"
                  }
                },
                "example": {
                  "driver": "s3"
                }
              },
              "example": {
                "driver": "s3"
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "driver": "s3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response. Returns the driver's reset settings, with secret keys omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "description": "The driver's default settings after reset, excluding hidden/secret keys."
                    }
                  },
                  "example": {
                    "message": "Settings reset successfully",
                    "data": {
                      "is_active": "no",
                      "region": "",
                      "bucket": ""
                    }
                  }
                },
                "example": {
                  "message": "Settings reset successfully",
                  "data": {
                    "is_active": "no",
                    "region": "",
                    "bucket": ""
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Settings reset successfully",
                      "data": {
                        "is_active": "no",
                        "region": "",
                        "bucket": ""
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The driver could not be resolved, or resetting its settings failed.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Invalid driver.",
                  "error_data": null
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`is_super_admin`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
