{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/shipping/classes/{id}/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "GET Get Shipping Class Profile",
        "description": "Retrieve a shipping class together with every shipping zone it is assigned to, each zone including its shipping methods. Used to show the full reach of a class across all zones in one call.\n\n**Access policy:** `StoreSensitivePolicy`\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Shipping"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The shipping class ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns the shipping class with its zones and each zone's methods.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "shipping_class": {
                      "$ref": "#/components/schemas/ShippingClassProfile"
                    }
                  },
                  "example": {
                    "shipping_class": {
                      "id": 1,
                      "name": "Heavy Items",
                      "cost": 15.0,
                      "type": "fixed",
                      "per_item": 1,
                      "created_at": "2025-01-20 09:00:00",
                      "updated_at": "2025-01-20 09:00:00",
                      "zones": [
                        {
                          "id": 1,
                          "name": "Domestic",
                          "region": "US",
                          "shipping_class_id": 1,
                          "order": 0,
                          "formatted_region": "United States",
                          "created_at": "2025-01-15 12:00:00",
                          "updated_at": "2025-01-15 12:00:00",
                          "methods": [
                            {
                              "id": 10,
                              "zone_id": 1,
                              "title": "Standard Shipping",
                              "type": "flat_rate",
                              "amount": 500,
                              "is_enabled": true,
                              "created_at": "2025-01-15 12:30:00",
                              "updated_at": "2025-01-15 12:30:00"
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "shipping_class": {
                    "id": 1,
                    "name": "Heavy Items",
                    "cost": 15.0,
                    "type": "fixed",
                    "per_item": 1,
                    "created_at": "2025-01-20 09:00:00",
                    "updated_at": "2025-01-20 09:00:00",
                    "zones": [
                      {
                        "id": 1,
                        "name": "Domestic",
                        "region": "US",
                        "shipping_class_id": 1,
                        "order": 0,
                        "formatted_region": "United States",
                        "created_at": "2025-01-15 12:00:00",
                        "updated_at": "2025-01-15 12:00:00",
                        "methods": [
                          {
                            "id": 10,
                            "zone_id": 1,
                            "title": "Standard Shipping",
                            "type": "flat_rate",
                            "amount": 500,
                            "is_enabled": true,
                            "created_at": "2025-01-15 12:30:00",
                            "updated_at": "2025-01-15 12:30:00"
                          }
                        ]
                      }
                    ]
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "shipping_class": {
                        "id": 1,
                        "name": "Heavy Items",
                        "cost": 15.0,
                        "type": "fixed",
                        "per_item": 1,
                        "created_at": "2025-01-20 09:00:00",
                        "updated_at": "2025-01-20 09:00:00",
                        "zones": [
                          {
                            "id": 1,
                            "name": "Domestic",
                            "region": "US",
                            "shipping_class_id": 1,
                            "order": 0,
                            "formatted_region": "United States",
                            "created_at": "2025-01-15 12:00:00",
                            "updated_at": "2025-01-15 12:00:00",
                            "methods": [
                              {
                                "id": 10,
                                "zone_id": 1,
                                "title": "Standard Shipping",
                                "type": "flat_rate",
                                "amount": 500,
                                "is_enabled": true,
                                "created_at": "2025-01-15 12:30:00",
                                "updated_at": "2025-01-15 12:30:00"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "404": {
            "description": "No shipping class exists with the given ID. Thrown by `ShippingClass::findOrFail()`, not an explicit controller check, so the message is generic and names the model class and ID.",
            "content": {
              "application/json": {
                "example": {
                  "message": "No query results for model [FluentCart\\App\\Models\\ShippingClass] 42"
                },
                "schema": {
                  "example": {
                    "message": "No query results for model [FluentCart\\App\\Models\\ShippingClass] 42"
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "No query results for model [FluentCart\\App\\Models\\ShippingClass] 42"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShippingClassProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique class identifier",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Class display name",
            "example": "Heavy Items"
          },
          "cost": {
            "type": "number",
            "format": "float",
            "description": "Cost value",
            "example": 15.0
          },
          "type": {
            "type": "string",
            "enum": [
              "fixed",
              "percentage"
            ],
            "description": "Cost type",
            "example": "fixed"
          },
          "per_item": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 = per item, 0 = per order",
            "example": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp (UTC)"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp (UTC)"
          },
          "zones": {
            "type": "array",
            "description": "Every shipping zone this class is assigned to.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 1
                },
                "name": {
                  "type": "string",
                  "example": "Domestic"
                },
                "region": {
                  "type": "string",
                  "example": "US"
                },
                "shipping_class_id": {
                  "type": "integer",
                  "example": 1
                },
                "order": {
                  "type": "integer",
                  "example": 0
                },
                "formatted_region": {
                  "type": "string",
                  "example": "United States"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "methods": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 10
                      },
                      "zone_id": {
                        "type": "integer",
                        "example": 1
                      },
                      "title": {
                        "type": "string",
                        "example": "Standard Shipping"
                      },
                      "type": {
                        "type": "string",
                        "example": "flat_rate"
                      },
                      "amount": {
                        "type": "integer",
                        "description": "Shipping cost in cents",
                        "example": 500
                      },
                      "is_enabled": {
                        "type": "boolean",
                        "example": true
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "updated_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
