{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/shipping/zone/countries": {
      "get": {
        "operationId": "getCountriesByContinent",
        "summary": "GET Get Countries By Continent",
        "description": "List every country FluentCart recognizes, grouped by continent. Used to populate the region picker when creating or editing a shipping zone.\n\n**Access policy:** `StoreSensitivePolicy`\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Shipping"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns countries grouped by continent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "continents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Continent code."
                          },
                          "name": {
                            "type": "string",
                            "description": "Continent display name."
                          },
                          "countries": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "code": {
                                  "type": "string",
                                  "description": "ISO 3166-1 alpha-2 country code."
                                },
                                "name": {
                                  "type": "string",
                                  "description": "Country display name."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "continents": [
                      {
                        "code": "AF",
                        "name": "Africa",
                        "countries": [
                          {
                            "code": "AO",
                            "name": "Angola"
                          },
                          {
                            "code": "BF",
                            "name": "Burkina Faso"
                          }
                        ]
                      },
                      {
                        "code": "AN",
                        "name": "Antarctica",
                        "countries": [
                          {
                            "code": "AQ",
                            "name": "Antarctica"
                          },
                          {
                            "code": "BV",
                            "name": "Bouvet Island"
                          }
                        ]
                      }
                    ]
                  }
                },
                "example": {
                  "continents": [
                    {
                      "code": "AF",
                      "name": "Africa",
                      "countries": [
                        {
                          "code": "AO",
                          "name": "Angola"
                        },
                        {
                          "code": "BF",
                          "name": "Burkina Faso"
                        }
                      ]
                    },
                    {
                      "code": "AN",
                      "name": "Antarctica",
                      "countries": [
                        {
                          "code": "AQ",
                          "name": "Antarctica"
                        },
                        {
                          "code": "BV",
                          "name": "Bouvet Island"
                        }
                      ]
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "continents": [
                        {
                          "code": "AF",
                          "name": "Africa",
                          "countries": [
                            {
                              "code": "AO",
                              "name": "Angola"
                            },
                            {
                              "code": "BF",
                              "name": "Burkina Faso"
                            }
                          ]
                        },
                        {
                          "code": "AN",
                          "name": "Antarctica",
                          "countries": [
                            {
                              "code": "AQ",
                              "name": "Antarctica"
                            },
                            {
                              "code": "BV",
                              "name": "Bouvet Island"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
