{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/shipping/zones": {
      "get": {
        "operationId": "listShippingZones",
        "summary": "GET List Shipping Zones",
        "description": "Retrieve a paginated list of shipping zones with filtering and sorting capabilities.\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Shipping"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search zones by name",
            "required": false
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 200
            },
            "description": "Number of results per page (default: 10, max: 200)",
            "required": false
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for pagination",
            "required": false
          },
          {
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "order"
            },
            "description": "Column to sort by (default: order)",
            "required": false
          },
          {
            "name": "sort_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            },
            "description": "Sort direction: asc or desc (default: asc)",
            "required": false
          },
          {
            "name": "filter_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "simple",
                "advanced"
              ]
            },
            "description": "Filter type: simple or advanced",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns a paginated list of shipping zones.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "shipping_zones": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "current_page": {
                          "type": "integer"
                        },
                        "first_page_url": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL of the first page"
                        },
                        "from": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Index of first item on this page"
                        },
                        "last_page_url": {
                          "type": "string",
                          "description": "URL of the last page"
                        },
                        "links": {
                          "type": "array",
                          "description": "Pagination links (previous, page numbers, next)",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "nullable": true
                              },
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "next_page_url": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL of the next page"
                        },
                        "path": {
                          "type": "string",
                          "description": "Base URL without query string"
                        },
                        "prev_page_url": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL of the previous page"
                        },
                        "to": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Index of last item on this page"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ShippingZone"
                          }
                        }
                      }
                    }
                  },
                  "example": {
                    "shipping_zones": {
                      "total": 3,
                      "per_page": 10,
                      "current_page": 1,
                      "first_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                      "from": 1,
                      "last_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                      "links": [
                        {
                          "url": null,
                          "label": "pagination.previous",
                          "active": false
                        },
                        {
                          "url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                          "label": "1",
                          "active": true
                        }
                      ],
                      "next_page_url": null,
                      "path": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones",
                      "prev_page_url": null,
                      "to": 2,
                      "last_page": 1,
                      "data": [
                        {
                          "id": 1,
                          "name": "Domestic",
                          "region": "US",
                          "order": 0,
                          "formatted_region": "United States",
                          "created_at": "2025-01-15 12:00:00",
                          "updated_at": "2025-01-15 12:00:00"
                        },
                        {
                          "id": 2,
                          "name": "Rest of World",
                          "region": "all",
                          "order": 1,
                          "formatted_region": "Whole World",
                          "created_at": "2025-01-16 10:00:00",
                          "updated_at": "2025-01-16 10:00:00"
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "shipping_zones": {
                    "total": 3,
                    "per_page": 10,
                    "current_page": 1,
                    "first_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                    "from": 1,
                    "last_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                    "links": [
                      {
                        "url": null,
                        "label": "pagination.previous",
                        "active": false
                      },
                      {
                        "url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                        "label": "1",
                        "active": true
                      }
                    ],
                    "next_page_url": null,
                    "path": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones",
                    "prev_page_url": null,
                    "to": 2,
                    "last_page": 1,
                    "data": [
                      {
                        "id": 1,
                        "name": "Domestic",
                        "region": "US",
                        "order": 0,
                        "formatted_region": "United States",
                        "created_at": "2025-01-15 12:00:00",
                        "updated_at": "2025-01-15 12:00:00"
                      },
                      {
                        "id": 2,
                        "name": "Rest of World",
                        "region": "all",
                        "order": 1,
                        "formatted_region": "Whole World",
                        "created_at": "2025-01-16 10:00:00",
                        "updated_at": "2025-01-16 10:00:00"
                      }
                    ]
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "shipping_zones": {
                        "total": 3,
                        "per_page": 10,
                        "current_page": 1,
                        "first_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                        "from": 1,
                        "last_page_url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                        "links": [
                          {
                            "url": null,
                            "label": "pagination.previous",
                            "active": false
                          },
                          {
                            "url": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones/?page=1",
                            "label": "1",
                            "active": true
                          }
                        ],
                        "next_page_url": null,
                        "path": "https://yoursite.com/wp-json/fluent-cart/v2/shipping/zones",
                        "prev_page_url": null,
                        "to": 2,
                        "last_page": 1,
                        "data": [
                          {
                            "id": 1,
                            "name": "Domestic",
                            "region": "US",
                            "order": 0,
                            "formatted_region": "United States",
                            "created_at": "2025-01-15 12:00:00",
                            "updated_at": "2025-01-15 12:00:00"
                          },
                          {
                            "id": 2,
                            "name": "Rest of World",
                            "region": "all",
                            "order": 1,
                            "formatted_region": "Whole World",
                            "created_at": "2025-01-16 10:00:00",
                            "updated_at": "2025-01-16 10:00:00"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShippingZone": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique zone identifier",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Zone display name",
            "example": "Domestic"
          },
          "region": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code or 'all' for worldwide",
            "example": "US"
          },
          "order": {
            "type": "integer",
            "description": "Sort order for display priority",
            "example": 0
          },
          "formatted_region": {
            "type": "string",
            "description": "Human-readable region name",
            "example": "United States"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp (UTC)",
            "example": "2025-01-15 12:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp (UTC)",
            "example": "2025-01-15 12:00:00"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
