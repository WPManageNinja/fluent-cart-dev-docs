{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/shipping/packages": {
      "post": {
        "operationId": "savePackages",
        "summary": "POST Save Shipping Packages",
        "description": "Replace the store's full list of shipping packages. The list is capped at 50 entries; each entry is sanitized server-side (unknown `type`/unit values fall back to defaults, `height` is forced to null for `envelope` packages, and duplicate slugs are automatically suffixed).\n\n**Access policy:** `StoreSensitivePolicy`\n\n**Access policy:** `StoreSensitivePolicy`",
        "tags": [
          "Shipping"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "packages"
                ],
                "properties": {
                  "packages": {
                    "type": "array",
                    "description": "Full replacement list of packages (max 50). Non-array values are treated as an empty list.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "slug": {
                          "type": "string",
                          "description": "Optional; derived from name if omitted."
                        },
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "box",
                            "envelope",
                            "soft_package"
                          ]
                        },
                        "length": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number",
                          "nullable": true,
                          "description": "Ignored (forced to null) for `envelope` type."
                        },
                        "dimension_unit": {
                          "type": "string",
                          "enum": [
                            "cm",
                            "mm",
                            "in",
                            "m"
                          ]
                        },
                        "weight": {
                          "type": "number"
                        },
                        "weight_unit": {
                          "type": "string",
                          "enum": [
                            "kg",
                            "g",
                            "lbs",
                            "oz"
                          ]
                        },
                        "is_default": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "packages": [
                    {
                      "name": "Small Box",
                      "type": "box",
                      "length": 20,
                      "width": 15,
                      "height": 10,
                      "dimension_unit": "cm",
                      "weight": 0.5,
                      "weight_unit": "kg",
                      "is_default": true
                    }
                  ]
                }
              },
              "example": {
                "packages": [
                  {
                    "name": "Small Box",
                    "type": "box",
                    "length": 20,
                    "width": 15,
                    "height": 10,
                    "dimension_unit": "cm",
                    "weight": 0.5,
                    "weight_unit": "kg",
                    "is_default": true
                  }
                ]
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "packages": [
                      {
                        "name": "Small Box",
                        "type": "box",
                        "length": 20,
                        "width": 15,
                        "height": 10,
                        "dimension_unit": "cm",
                        "weight": 0.5,
                        "weight_unit": "kg",
                        "is_default": true
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response. Returns the sanitized, persisted package list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "packages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ShippingPackage"
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "packages": [
                      {
                        "slug": "small-box",
                        "name": "Small Box",
                        "type": "box",
                        "length": 20,
                        "width": 15,
                        "height": 10,
                        "dimension_unit": "cm",
                        "weight": 0.5,
                        "weight_unit": "kg",
                        "is_default": true
                      }
                    ],
                    "message": "Packages have been saved successfully"
                  }
                },
                "example": {
                  "packages": [
                    {
                      "slug": "small-box",
                      "name": "Small Box",
                      "type": "box",
                      "length": 20,
                      "width": 15,
                      "height": 10,
                      "dimension_unit": "cm",
                      "weight": 0.5,
                      "weight_unit": "kg",
                      "is_default": true
                    }
                  ],
                  "message": "Packages have been saved successfully"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "packages": [
                        {
                          "slug": "small-box",
                          "name": "Small Box",
                          "type": "box",
                          "length": 20,
                          "width": 15,
                          "height": 10,
                          "dimension_unit": "cm",
                          "weight": 0.5,
                          "weight_unit": "kg",
                          "is_default": true
                        }
                      ],
                      "message": "Packages have been saved successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShippingPackage": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "small-box"
          },
          "name": {
            "type": "string",
            "example": "Small Box"
          },
          "type": {
            "type": "string",
            "enum": [
              "box",
              "envelope",
              "soft_package"
            ],
            "example": "box"
          },
          "length": {
            "type": "number",
            "example": 20
          },
          "width": {
            "type": "number",
            "example": 15
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 10
          },
          "dimension_unit": {
            "type": "string",
            "enum": [
              "cm",
              "mm",
              "in",
              "m"
            ],
            "example": "cm"
          },
          "weight": {
            "type": "number",
            "example": 0.5
          },
          "weight_unit": {
            "type": "string",
            "enum": [
              "kg",
              "g",
              "lbs",
              "oz"
            ],
            "example": "kg"
          },
          "is_default": {
            "type": "boolean",
            "example": true
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
