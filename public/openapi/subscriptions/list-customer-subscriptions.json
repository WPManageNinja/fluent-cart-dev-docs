  "components": {
    "schemas": {
      "CustomerSubscription": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Subscription UUID",
            "example": "a3f7c1b2-9e4d-4a8b-b5c6-d7e8f9012345"
          },
          "vendor_subscription_id": {
            "type": "string",
            "nullable": true,
            "description": "Subscription ID at the payment gateway",
            "example": "sub_1QxR3nH8k5m2Np9"
          },
          "status": {
            "type": "string",
            "description": "Subscription status",
            "example": "active"
          },
          "overridden_status": {
            "type": "string",
            "description": "Effective display status, accounting for expiry/overrides",
            "example": "active"
          },
          "next_billing_date": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Next billing date in GMT, or null if there is none",
            "example": "2026-09-20 14:25:00"
          },
          "billing_info": {
            "type": "object",
            "nullable": true,
            "description": "Active payment method details used for this subscription",
            "properties": {
              "method": {
                "type": "string",
                "example": "stripe"
              },
              "vendor_method_id": {
                "type": "string",
                "example": "pm_1QxR3nH8k5m2Np9"
              },
              "payment_type": {
                "type": "string",
                "example": "card"
              },
              "details": {
                "type": "object",
                "properties": {
                  "brand": {
                    "type": "string",
                    "example": "visa"
                  },
                  "last_4": {
                    "type": "string",
                    "example": "4242"
                  },
                  "exp_month": {
                    "type": "integer",
                    "example": 11
                  },
                  "exp_year": {
                    "type": "integer",
                    "example": 2028
                  },
                  "country": {
                    "type": "string",
                    "example": "US"
                  },
                  "postal_code": {
                    "type": "string",
                    "example": "94102"
                  },
                  "name": {
                    "type": "string",
                    "example": "Alex Morgan"
                  }
                }
              }
            }
          },
          "current_payment_method": {
            "type": "string",
            "description": "Current payment gateway slug",
            "example": "stripe"
          },
          "payment_method": {
            "type": "string",
            "nullable": true,
            "description": "Deprecated/legacy payment method field; typically null"
          },
          "payment_info": {
            "type": "string",
            "description": "HTML-escaped, human-readable billing summary (amount, interval, and total occurrences)",
            "example": "&#36;99.00 per year, for 1 year"
          },
          "bill_times": {
            "type": "string",
            "description": "Number of times to bill, as a string (\"0\" = unlimited)",
            "example": "0"
          },
          "bill_count": {
            "type": "string",
            "description": "Number of completed billing cycles, as a string",
            "example": "1"
          },
          "config": {
            "type": "object",
            "description": "Subscription configuration flags",
            "properties": {
              "is_trial_days_simulated": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "example": "no"
              },
              "currency": {
                "type": "string",
                "example": "USD"
              }
            }
          },
          "reactivate_url": {
            "type": "string",
            "description": "Frontend URL the customer can use to reactivate a canceled/expired subscription",
            "example": "https://yoursite.com/?fluent-cart=reactivate-subscription&subscription_hash=a3f7c1b2-9e4d-4a8b-b5c6-d7e8f9012345"
          },
          "can_upgrade": {
            "type": "boolean",
            "description": "Whether the customer can upgrade this subscription's plan"
          },
          "can_switch_payment_method": {
            "type": "boolean",
            "description": "Whether the customer can switch to a different saved payment method"
          },
          "can_update_payment_method": {
            "type": "boolean",
            "description": "Whether the customer can update the current payment method's details"
          },
          "collection_method": {
            "type": "string",
            "description": "How renewals are collected",
            "enum": [
              "automatic",
              "manual"
            ],
            "example": "automatic"
          },
          "is_auto_charged": {
            "type": "boolean",
            "description": "Whether the store automatically charges the customer on renewal"
          },
          "item_name": {
            "type": "string",
            "description": "Item name",
            "example": "Developer Toolkit Pro - Business Annual"
          }
        }
      },
      "CustomerSubscriptionPagination": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerSubscription"
            }
          },
          "total": {
            "type": "integer",
            "example": 5
          },
          "per_page": {
            "type": "integer",
            "example": 10
          },
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "last_page": {
            "type": "integer",
            "example": 1
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
