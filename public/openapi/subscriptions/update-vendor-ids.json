{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/orders/{order}/subscriptions/{subscription}/vendor-ids": {
      "put": {
        "operationId": "updateVendorIds",
        "summary": "PUT Update Vendor IDs",
        "description": "Correct the gateway identifiers (vendor_subscription_id, vendor_customer_id) on a gateway-billed subscription. Opt-in: the endpoint returns an error unless the site enables the `fluent_cart/subscription/vendor_id_editing_enabled` filter. Writes only the identifier columns \u2014 no renewal is voided, no invoice re-synced, no status event dispatched, and the payment gateway is not called. Only the keys sent are written. The new vendor_subscription_id is claimed atomically, so another subscription on the same payment method cannot already hold it.\n\n**Required permission:** `subscriptions/manage`",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The parent order ID"
          },
          {
            "name": "subscription",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The subscription ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vendor_subscription_id": {
                    "type": "string",
                    "maxLength": 45,
                    "pattern": "^[a-zA-Z0-9_.-]+$",
                    "description": "The subscription ID at the payment gateway. Send an empty string to clear it. Omit the key to leave it untouched."
                  },
                  "vendor_customer_id": {
                    "type": "string",
                    "maxLength": 45,
                    "pattern": "^[a-zA-Z0-9_.-]+$",
                    "description": "The customer ID at the payment gateway. Send an empty string to clear it. Omit the key to leave it untouched."
                  }
                },
                "example": {
                  "vendor_subscription_id": "sub_1P9xyzABCdef",
                  "vendor_customer_id": "cus_NffrFeUfNV2Hib"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vendor IDs updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "subscription": {
                      "type": "object"
                    }
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Vendor IDs have been updated successfully!",
                      "subscription": {
                        "id": 1,
                        "status": "active",
                        "collection_method": "automatic",
                        "current_payment_method": "stripe",
                        "vendor_subscription_id": "sub_1P9xyzABCdef",
                        "vendor_customer_id": "cus_NffrFeUfNV2Hib"
                      }
                    }
                  },
                  "notEditable": {
                    "summary": "Feature disabled or subscription not eligible",
                    "value": {
                      "message": "Vendor IDs can only be edited on an active gateway-billed subscription."
                    }
                  },
                  "duplicate": {
                    "summary": "Another subscription already holds the ID",
                    "value": {
                      "message": "Another subscription on this payment method is already using this Vendor Subscription ID."
                    }
                  },
                  "noChanges": {
                    "summary": "Payload matches the stored values",
                    "value": {
                      "message": "No changes detected."
                    }
                  }
                },
                "example": {
                  "message": "Vendor IDs have been updated successfully!",
                  "subscription": {
                    "id": 638,
                    "customer_id": 2306,
                    "parent_order_id": 5100,
                    "status": "active",
                    "vendor_subscription_id": "sub_1PxaBcDeFgHiJkLmNoPqRsTu",
                    "vendor_customer_id": "cus_QrStUvWxYz012345",
                    "current_payment_method": "stripe",
                    "billing_interval": "yearly",
                    "recurring_amount": 9900,
                    "bill_times": 0,
                    "bill_count": 2,
                    "next_billing_date": "2027-05-29 12:35:43",
                    "created_at": "2025-11-25 17:44:02",
                    "updated_at": "2026-05-29 12:35:43"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "default": {
                    "summary": "Invalid ID format",
                    "value": {
                      "vendor_subscription_id": [
                        "Vendor IDs may only contain letters, numbers, dots, dashes and underscores."
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`subscriptions/manage`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
