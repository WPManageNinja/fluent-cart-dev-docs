{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/classes": {
      "post": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "createTaxClass",
        "summary": "POST Create Tax Class",
        "description": "Create a new tax class. A unique slug is auto-generated from the title. Pass slug \"reduced\" or \"zero\" to create one of the built-in classes (title is then set automatically). A maximum of 6 tax classes is allowed; the built-in \"standard\" class always exists and cannot be deleted.",
        "tags": [
          "Tax"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 30,
                    "description": "Tax class title (max 30 characters). Required unless a built-in slug is passed",
                    "example": "Digital Goods"
                  },
                  "slug": {
                    "type": "string",
                    "description": "Optional. Pass a built-in slug (reduced or zero) to create that built-in class; otherwise the slug is auto-generated from the title",
                    "example": ""
                  }
                },
                "example": {
                  "title": "Digital Goods"
                }
              },
              "example": {
                "title": "Digital Goods"
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "title": "Digital Goods"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tax class created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "class": {
                      "$ref": "#/components/schemas/TaxClass"
                    },
                    "message": {
                      "type": "string",
                      "example": "Tax class created successfully"
                    }
                  },
                  "example": {
                    "class": {
                      "id": 4,
                      "title": "Digital Goods",
                      "slug": "digital-goods",
                      "meta": [],
                      "created_at": "2025-06-01 12:00:00",
                      "updated_at": "2025-06-01 12:00:00"
                    },
                    "message": "Tax class created successfully"
                  }
                },
                "example": {
                  "class": {
                    "id": 4,
                    "title": "Digital Goods",
                    "slug": "digital-goods",
                    "meta": [],
                    "created_at": "2025-06-01 12:00:00",
                    "updated_at": "2025-06-01 12:00:00"
                  },
                  "message": "Tax class created successfully"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "class": {
                        "id": 4,
                        "title": "Digital Goods",
                        "slug": "digital-goods",
                        "meta": [],
                        "created_at": "2025-06-01 12:00:00",
                        "updated_at": "2025-06-01 12:00:00"
                      },
                      "message": "Tax class created successfully"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Title exceeds 30 characters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Tax class name must be 30 characters or fewer"
                    }
                  },
                  "example": {
                    "message": "Tax class name must be 30 characters or fewer"
                  }
                },
                "example": {
                  "message": "Tax class name must be 30 characters or fewer"
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Tax class name must be 30 characters or fewer"
                    }
                  }
                }
              }
            }
          },
          "423": {
            "description": "Limit reached, missing title, or duplicate class. Returned when 6 classes already exist, the title is missing, or a class with the same slug already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Maximum of 6 tax classes allowed"
                    }
                  },
                  "example": {
                    "message": "Maximum of 6 tax classes allowed"
                  }
                },
                "example": {
                  "message": "Maximum of 6 tax classes allowed"
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Maximum of 6 tax classes allowed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaxClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Tax class ID",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Tax class title",
            "example": "Standard"
          },
          "slug": {
            "type": "string",
            "description": "Tax class slug (unique, auto-generated from the title)",
            "example": "standard"
          },
          "meta": {
            "type": "array",
            "description": "Tax class metadata (empty array when unset)",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp",
            "example": "2025-01-01 00:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp",
            "example": "2025-01-01 00:00:00"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
