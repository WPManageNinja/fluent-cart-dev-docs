{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/rates/country/rates/{country_code}": {
      "get": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "getCountryTaxRates",
        "summary": "GET Get Country Tax Rates",
        "description": "Retrieve all tax rates for a specific country (ordered by priority, then ID), the country-level form configuration, and whether tax is enabled for the country.",
        "tags": [
          "Tax"
        ],
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "description": "ISO 3166-1 alpha-2 country code (e.g., US, DE, GB)",
            "required": true,
            "schema": {
              "type": "string",
              "example": "DE"
            }
          },
          {
            "name": "class_id",
            "in": "query",
            "description": "Optional tax class ID to filter the rates",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns tax rates for the specified country.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tax_rates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaxRate"
                      }
                    },
                    "settings": {
                      "type": "object",
                      "nullable": true,
                      "description": "Country-level form configuration from the built-in tax config. Falls back to the continent configuration (e.g., EU) and is null when neither defines one",
                      "properties": {
                        "hidden": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Address fields hidden in the rate form for this country (e.g., city, zip, state)",
                          "example": [
                            "city",
                            "zip",
                            "state"
                          ]
                        }
                      }
                    },
                    "tax_enabled": {
                      "type": "boolean",
                      "description": "Whether tax collection is enabled for this country (default: true)",
                      "example": true
                    }
                  },
                  "example": {
                    "tax_rates": [
                      {
                        "id": 5,
                        "class_id": 1,
                        "country": "DE",
                        "state": "",
                        "postcode": "",
                        "city": "",
                        "rate": "19.0000",
                        "name": "DE Standard Tax",
                        "group": "EU",
                        "priority": 1,
                        "is_compound": 0,
                        "for_shipping": null,
                        "for_order": 0,
                        "formatted_state": ""
                      }
                    ],
                    "settings": {
                      "hidden": [
                        "city",
                        "zip",
                        "state"
                      ]
                    },
                    "tax_enabled": true
                  }
                },
                "example": {
                  "tax_rates": [
                    {
                      "id": 5,
                      "class_id": 1,
                      "country": "DE",
                      "state": "",
                      "postcode": "",
                      "city": "",
                      "rate": "19.0000",
                      "name": "DE Standard Tax",
                      "group": "EU",
                      "priority": 1,
                      "is_compound": 0,
                      "for_shipping": null,
                      "for_order": 0,
                      "formatted_state": ""
                    }
                  ],
                  "settings": {
                    "hidden": [
                      "city",
                      "zip",
                      "state"
                    ]
                  },
                  "tax_enabled": true
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "tax_rates": [
                        {
                          "id": 5,
                          "class_id": 1,
                          "country": "DE",
                          "state": "",
                          "postcode": "",
                          "city": "",
                          "rate": "19.0000",
                          "name": "DE Standard Tax",
                          "group": "EU",
                          "priority": 1,
                          "is_compound": 0,
                          "for_shipping": null,
                          "for_order": 0,
                          "formatted_state": ""
                        }
                      ],
                      "settings": {
                        "hidden": [
                          "city",
                          "zip",
                          "state"
                        ]
                      },
                      "tax_enabled": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaxRate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Tax rate ID",
            "example": 5
          },
          "class_id": {
            "type": "integer",
            "description": "Associated tax class ID",
            "example": 1
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code",
            "example": "DE"
          },
          "state": {
            "type": "string",
            "description": "State/province code",
            "example": ""
          },
          "postcode": {
            "type": "string",
            "description": "Postcode/ZIP code",
            "example": ""
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": ""
          },
          "rate": {
            "type": "string",
            "description": "Tax rate percentage",
            "example": "19.0000"
          },
          "name": {
            "type": "string",
            "description": "Display name for the tax rate",
            "example": "DE Standard Tax"
          },
          "group": {
            "type": "string",
            "description": "Geographic group/continent code",
            "example": "EU"
          },
          "priority": {
            "type": "integer",
            "description": "Priority for rate application order",
            "example": 1
          },
          "is_compound": {
            "type": "integer",
            "description": "Whether this rate is compound (0 or 1)",
            "example": 0
          },
          "for_shipping": {
            "type": "string",
            "nullable": true,
            "description": "Shipping tax override rate (null when no override)",
            "example": null
          },
          "for_order": {
            "type": "integer",
            "description": "Whether this rate applies at order level (0 or 1)",
            "example": 0
          },
          "formatted_state": {
            "type": "string",
            "description": "Formatted state name",
            "example": ""
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
