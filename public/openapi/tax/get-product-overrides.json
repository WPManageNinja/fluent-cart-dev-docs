{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/product-overrides/{country_code}": {
      "get": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "getProductOverrides",
        "summary": "GET Get Product Category Tax Overrides",
        "description": "Retrieve all product category tax overrides for a specific country. Each override is a meta row whose meta_value holds the location, category, rate, and tax class data; class_id and class_label are appended for convenience.\n\n**Required permission:** `store/settings`",
        "tags": [
          "Tax"
        ],
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "description": "ISO 3166-1 alpha-2 country code (e.g., US, DE)",
            "required": true,
            "schema": {
              "type": "string",
              "example": "DE"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns the product category tax overrides for the country.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "overrides": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProductCategoryTaxOverride"
                      }
                    }
                  },
                  "example": {
                    "overrides": [
                      {
                        "id": 12,
                        "object_type": "tax_override",
                        "object_id": 15,
                        "meta_key": "product_category_override",
                        "meta_value": {
                          "country": "DE",
                          "state": "",
                          "city": "",
                          "postcode": "",
                          "category_id": 15,
                          "category_name": "Books",
                          "tax_label": "Reduced VAT",
                          "override_state_tax": "no",
                          "rate": 7,
                          "class_id": 1
                        },
                        "class_id": 1,
                        "class_label": "Standard",
                        "created_at": "2025-06-01 12:00:00",
                        "updated_at": "2025-06-01 12:00:00"
                      }
                    ]
                  }
                },
                "example": {
                  "overrides": [
                    {
                      "id": 12,
                      "object_type": "tax_override",
                      "object_id": 15,
                      "meta_key": "product_category_override",
                      "meta_value": {
                        "country": "DE",
                        "state": "",
                        "city": "",
                        "postcode": "",
                        "category_id": 15,
                        "category_name": "Books",
                        "tax_label": "Reduced VAT",
                        "override_state_tax": "no",
                        "rate": 7,
                        "class_id": 1
                      },
                      "class_id": 1,
                      "class_label": "Standard",
                      "created_at": "2025-06-01 12:00:00",
                      "updated_at": "2025-06-01 12:00:00"
                    }
                  ]
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "overrides": [
                        {
                          "id": 12,
                          "object_type": "tax_override",
                          "object_id": 15,
                          "meta_key": "product_category_override",
                          "meta_value": {
                            "country": "DE",
                            "state": "",
                            "city": "",
                            "postcode": "",
                            "category_id": 15,
                            "category_name": "Books",
                            "tax_label": "Reduced VAT",
                            "override_state_tax": "no",
                            "rate": 7,
                            "class_id": 1
                          },
                          "class_id": 1,
                          "class_label": "Standard",
                          "created_at": "2025-06-01 12:00:00",
                          "updated_at": "2025-06-01 12:00:00"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`store/settings`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductCategoryTaxOverride": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Override (meta row) ID",
            "example": 12
          },
          "object_type": {
            "type": "string",
            "description": "Always tax_override",
            "example": "tax_override"
          },
          "object_id": {
            "type": "integer",
            "description": "Product category (term) ID",
            "example": 15
          },
          "meta_key": {
            "type": "string",
            "description": "Always product_category_override",
            "example": "product_category_override"
          },
          "meta_value": {
            "type": "object",
            "description": "Override data",
            "properties": {
              "country": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 country code",
                "example": "DE"
              },
              "state": {
                "type": "string",
                "description": "State/province code (empty for country-wide)",
                "example": ""
              },
              "city": {
                "type": "string",
                "description": "City name (max 45 characters)",
                "example": ""
              },
              "postcode": {
                "type": "string",
                "description": "Postcode/ZIP code",
                "example": ""
              },
              "category_id": {
                "type": "integer",
                "description": "Product category (term) ID",
                "example": 15
              },
              "category_name": {
                "type": "string",
                "description": "Product category name (resolved server-side)",
                "example": "Books"
              },
              "tax_label": {
                "type": "string",
                "description": "Display label for the override tax",
                "example": "Reduced VAT"
              },
              "override_state_tax": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the override replaces state-level tax",
                "example": "no"
              },
              "rate": {
                "type": "number",
                "description": "Override tax rate percentage (minimum 0)",
                "example": 7
              },
              "class_id": {
                "type": "integer",
                "description": "Tax class ID the override applies to (0 = none)",
                "example": 1
              }
            }
          },
          "class_id": {
            "type": "integer",
            "description": "Tax class ID (appended for convenience)",
            "example": 1
          },
          "class_label": {
            "type": "string",
            "description": "Tax class title (empty string when the class no longer exists)",
            "example": "Standard"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-01 12:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-01 12:00:00"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
