{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/configuration/settings": {
      "get": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "getTaxSettings",
        "summary": "GET Get Tax Settings",
        "description": "Retrieve the current global tax configuration settings along with the store country.\n\n**Required permission:** `store/settings`",
        "tags": [
          "Tax"
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns the current tax settings and the store country.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "$ref": "#/components/schemas/TaxSettings"
                    },
                    "store_country": {
                      "type": "string",
                      "description": "The store country code from store settings (empty string when unset)",
                      "example": "DE"
                    }
                  },
                  "example": {
                    "settings": {
                      "tax_inclusion": "included",
                      "tax_calculation_basis": "shipping",
                      "tax_rounding": "item",
                      "checkout_tax_breakdown_display": "itemized",
                      "tax_display_label": "Tax",
                      "enable_tax": "yes",
                      "price_suffix_included": "",
                      "price_suffix_excluded": "",
                      "eu_vat_settings": {
                        "require_vat_number": "no",
                        "local_reverse_charge": "yes",
                        "reverse_charge_price_mode": "fixed",
                        "vat_reverse_excluded_categories": [
                          30,
                          42
                        ],
                        "method": "oss",
                        "oss_country": "DE",
                        "oss_vat": "DE123456789",
                        "country_wise_vat": [],
                        "country_registrations": [
                          {
                            "country": "DE",
                            "vat": "DE123456789",
                            "rate": 19,
                            "rates": {
                              "standard": {
                                "rate": 19,
                                "label": "VAT"
                              },
                              "reduced": {
                                "rate": 7,
                                "label": "Reduced VAT"
                              }
                            },
                            "tax_label": "VAT"
                          }
                        ]
                      }
                    },
                    "store_country": "DE"
                  }
                },
                "example": {
                  "settings": {
                    "tax_inclusion": "included",
                    "tax_calculation_basis": "shipping",
                    "tax_rounding": "item",
                    "checkout_tax_breakdown_display": "itemized",
                    "tax_display_label": "Tax",
                    "enable_tax": "yes",
                    "price_suffix_included": "",
                    "price_suffix_excluded": "",
                    "eu_vat_settings": {
                      "require_vat_number": "no",
                      "local_reverse_charge": "yes",
                      "reverse_charge_price_mode": "fixed",
                      "vat_reverse_excluded_categories": [
                        30,
                        42
                      ],
                      "method": "oss",
                      "oss_country": "DE",
                      "oss_vat": "DE123456789",
                      "country_wise_vat": [],
                      "country_registrations": [
                        {
                          "country": "DE",
                          "vat": "DE123456789",
                          "rate": 19,
                          "rates": {
                            "standard": {
                              "rate": 19,
                              "label": "VAT"
                            },
                            "reduced": {
                              "rate": 7,
                              "label": "Reduced VAT"
                            }
                          },
                          "tax_label": "VAT"
                        }
                      ]
                    }
                  },
                  "store_country": "DE"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "settings": {
                        "tax_inclusion": "included",
                        "tax_calculation_basis": "shipping",
                        "tax_rounding": "item",
                        "checkout_tax_breakdown_display": "itemized",
                        "tax_display_label": "Tax",
                        "enable_tax": "yes",
                        "price_suffix_included": "",
                        "price_suffix_excluded": "",
                        "eu_vat_settings": {
                          "require_vat_number": "no",
                          "local_reverse_charge": "yes",
                          "reverse_charge_price_mode": "fixed",
                          "vat_reverse_excluded_categories": [
                            30,
                            42
                          ],
                          "method": "oss",
                          "oss_country": "DE",
                          "oss_vat": "DE123456789",
                          "country_wise_vat": [],
                          "country_registrations": [
                            {
                              "country": "DE",
                              "vat": "DE123456789",
                              "rate": 19,
                              "rates": {
                                "standard": {
                                  "rate": 19,
                                  "label": "VAT"
                                },
                                "reduced": {
                                  "rate": 7,
                                  "label": "Reduced VAT"
                                }
                              },
                              "tax_label": "VAT"
                            }
                          ]
                        }
                      },
                      "store_country": "DE"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`store/settings`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaxSettings": {
        "type": "object",
        "properties": {
          "enable_tax": {
            "type": "string",
            "description": "Whether tax calculation is enabled",
            "enum": [
              "yes",
              "no"
            ],
            "example": "yes"
          },
          "tax_inclusion": {
            "type": "string",
            "description": "Whether product prices include tax",
            "enum": [
              "included",
              "excluded"
            ],
            "example": "included"
          },
          "tax_calculation_basis": {
            "type": "string",
            "description": "Address used for tax calculation",
            "enum": [
              "shipping",
              "billing",
              "store"
            ],
            "example": "shipping"
          },
          "tax_rounding": {
            "type": "string",
            "description": "Where tax rounding is applied",
            "enum": [
              "item",
              "total",
              "subtotal"
            ],
            "example": "item"
          },
          "checkout_tax_breakdown_display": {
            "type": "string",
            "description": "How the tax breakdown is displayed at checkout",
            "enum": [
              "itemized",
              "simplified"
            ],
            "example": "itemized"
          },
          "tax_display_label": {
            "type": "string",
            "description": "Label used when displaying tax amounts (default: Tax)",
            "example": "Tax"
          },
          "price_suffix_included": {
            "type": "string",
            "description": "Text appended after prices that include tax (e.g., incl. VAT)",
            "example": ""
          },
          "price_suffix_excluded": {
            "type": "string",
            "description": "Text appended after prices that exclude tax (e.g., excl. VAT)",
            "example": ""
          },
          "eu_vat_settings": {
            "$ref": "#/components/schemas/EuVatSettings"
          }
        }
      },
      "EuVatSettings": {
        "type": "object",
        "properties": {
          "require_vat_number": {
            "type": "string",
            "description": "Whether EU VAT number field is shown at checkout",
            "enum": [
              "yes",
              "no"
            ],
            "example": "no"
          },
          "local_reverse_charge": {
            "type": "string",
            "description": "Whether reverse charge applies for domestic B2B",
            "enum": [
              "yes",
              "no"
            ],
            "example": "yes"
          },
          "reverse_charge_price_mode": {
            "type": "string",
            "description": "How reverse-charged prices are displayed: fixed keeps the tax-inclusive price, dynamic removes the VAT amount",
            "enum": [
              "fixed",
              "dynamic"
            ],
            "default": "fixed",
            "example": "fixed"
          },
          "vat_reverse_excluded_categories": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Product category IDs excluded from VAT reverse charge",
            "example": [
              30,
              42
            ]
          },
          "method": {
            "type": "string",
            "description": "Cross-border method",
            "enum": [
              "oss",
              "home",
              "specific"
            ],
            "example": "oss"
          },
          "oss_country": {
            "type": "string",
            "description": "Country of OSS registration (when method is oss)",
            "example": "DE"
          },
          "oss_vat": {
            "type": "string",
            "description": "OSS VAT number (when method is oss)",
            "example": "DE123456789"
          },
          "home_country": {
            "type": "string",
            "description": "Home country (when method is home)"
          },
          "home_vat": {
            "type": "string",
            "description": "Home VAT number (when method is home)"
          },
          "country_wise_vat": {
            "type": "array",
            "description": "Country-specific VAT settings (when method is specific)",
            "items": {
              "type": "object"
            }
          },
          "country_registrations": {
            "type": "array",
            "description": "Per-country EU VAT registrations (stored in fct_meta; present in GET responses only)",
            "items": {
              "type": "object",
              "properties": {
                "country": {
                  "type": "string",
                  "description": "ISO 3166-1 alpha-2 country code",
                  "example": "DE"
                },
                "vat": {
                  "type": "string",
                  "description": "VAT registration number",
                  "example": "DE123456789"
                },
                "rate": {
                  "type": "number",
                  "description": "Standard-class rate (backward compatibility)",
                  "example": 19
                },
                "rates": {
                  "type": "object",
                  "description": "Per-class rates keyed by tax class slug",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "rate": {
                        "type": "number",
                        "example": 19
                      },
                      "label": {
                        "type": "string",
                        "example": "VAT"
                      }
                    }
                  }
                },
                "tax_label": {
                  "type": "string",
                  "description": "Standard-class label (backward compatibility)",
                  "example": "VAT"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
