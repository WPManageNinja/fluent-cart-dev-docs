{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/classes": {
      "get": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "listTaxClasses",
        "summary": "GET List Tax Classes",
        "description": "Retrieve all tax classes ordered by ID (oldest first), along with the maximum allowed number of classes and the next built-in class (Reduced or Zero) that has not been created yet.",
        "tags": [
          "Tax"
        ],
        "responses": {
          "200": {
            "description": "Successful response. Returns all tax classes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "classes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaxClass"
                      }
                    },
                    "max_classes": {
                      "type": "integer",
                      "description": "Maximum number of tax classes allowed (6)",
                      "example": 6
                    },
                    "next_builtin": {
                      "type": "object",
                      "nullable": true,
                      "description": "The next built-in class not yet created (null when both reduced and zero exist)",
                      "properties": {
                        "slug": {
                          "type": "string",
                          "example": "zero"
                        },
                        "title": {
                          "type": "string",
                          "example": "Zero"
                        }
                      }
                    }
                  },
                  "example": {
                    "classes": [
                      {
                        "id": 1,
                        "title": "Standard",
                        "slug": "standard",
                        "meta": [],
                        "created_at": "2025-01-15 10:00:00",
                        "updated_at": "2025-01-15 10:00:00"
                      },
                      {
                        "id": 2,
                        "title": "Reduced",
                        "slug": "reduced",
                        "meta": [],
                        "created_at": "2025-01-15 10:15:00",
                        "updated_at": "2025-01-15 10:15:00"
                      },
                      {
                        "id": 3,
                        "title": "Digital Goods",
                        "slug": "digital-goods",
                        "meta": [],
                        "created_at": "2025-01-15 10:30:00",
                        "updated_at": "2025-01-15 10:30:00"
                      }
                    ],
                    "max_classes": 6,
                    "next_builtin": {
                      "slug": "zero",
                      "title": "Zero"
                    }
                  }
                },
                "example": {
                  "classes": [
                    {
                      "id": 1,
                      "title": "Standard",
                      "slug": "standard",
                      "meta": [],
                      "created_at": "2025-01-15 10:00:00",
                      "updated_at": "2025-01-15 10:00:00"
                    },
                    {
                      "id": 2,
                      "title": "Reduced",
                      "slug": "reduced",
                      "meta": [],
                      "created_at": "2025-01-15 10:15:00",
                      "updated_at": "2025-01-15 10:15:00"
                    },
                    {
                      "id": 3,
                      "title": "Digital Goods",
                      "slug": "digital-goods",
                      "meta": [],
                      "created_at": "2025-01-15 10:30:00",
                      "updated_at": "2025-01-15 10:30:00"
                    }
                  ],
                  "max_classes": 6,
                  "next_builtin": {
                    "slug": "zero",
                    "title": "Zero"
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "classes": [
                        {
                          "id": 1,
                          "title": "Standard",
                          "slug": "standard",
                          "meta": [],
                          "created_at": "2025-01-15 10:00:00",
                          "updated_at": "2025-01-15 10:00:00"
                        },
                        {
                          "id": 2,
                          "title": "Reduced",
                          "slug": "reduced",
                          "meta": [],
                          "created_at": "2025-01-15 10:15:00",
                          "updated_at": "2025-01-15 10:15:00"
                        },
                        {
                          "id": 3,
                          "title": "Digital Goods",
                          "slug": "digital-goods",
                          "meta": [],
                          "created_at": "2025-01-15 10:30:00",
                          "updated_at": "2025-01-15 10:30:00"
                        }
                      ],
                      "max_classes": 6,
                      "next_builtin": {
                        "slug": "zero",
                        "title": "Zero"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaxClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Tax class ID",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Tax class title",
            "example": "Standard"
          },
          "slug": {
            "type": "string",
            "description": "Tax class slug (unique, auto-generated from the title)",
            "example": "standard"
          },
          "meta": {
            "type": "array",
            "description": "Tax class metadata (empty array when unset)",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp",
            "example": "2025-01-01 00:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp",
            "example": "2025-01-01 00:00:00"
          }
        }
      }
    },
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
