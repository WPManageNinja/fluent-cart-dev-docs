{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/configuration/settings/eu-vat": {
      "post": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "saveEuVatCrossBorderSettings",
        "summary": "POST Save EU VAT Cross-Border Settings",
        "description": "Multi-action endpoint for EU VAT settings, dispatched by the action field: euCrossBorderSettings saves the cross-border registration configuration (OSS, home country, or specific country registrations); saveCountryRegistration creates or updates a per-country VAT registration with per-class rates; deleteCountryRegistration removes a per-country VAT registration.\n\n**Required permission:** `store/sensitive`",
        "tags": [
          "Tax"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Which operation to perform",
                    "enum": [
                      "euCrossBorderSettings",
                      "saveCountryRegistration",
                      "deleteCountryRegistration"
                    ],
                    "example": "euCrossBorderSettings"
                  },
                  "eu_vat_settings": {
                    "type": "object",
                    "description": "euCrossBorderSettings only. Merged into the stored eu_vat_settings",
                    "properties": {
                      "method": {
                        "type": "string",
                        "description": "Cross-border method (required)",
                        "enum": [
                          "oss",
                          "home",
                          "specific"
                        ],
                        "example": "oss"
                      },
                      "oss_country": {
                        "type": "string",
                        "description": "Country of OSS registration (required when method is oss; must be an EU VAT country)",
                        "example": "DE"
                      },
                      "oss_vat": {
                        "type": "string",
                        "description": "OSS VAT number",
                        "example": "DE123456789"
                      },
                      "home_country": {
                        "type": "string",
                        "description": "Home country code (required when method is home; must be an EU VAT country)"
                      },
                      "home_vat": {
                        "type": "string",
                        "description": "Home VAT number"
                      }
                    }
                  },
                  "reset_registration": {
                    "type": "string",
                    "description": "euCrossBorderSettings only. Set to yes to clear the current method (reset registration)",
                    "enum": [
                      "yes",
                      "no"
                    ],
                    "example": "no"
                  },
                  "country": {
                    "type": "string",
                    "description": "saveCountryRegistration / deleteCountryRegistration. ISO 3166-1 alpha-2 code of an EU VAT country (required)",
                    "example": "DE"
                  },
                  "vat": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "saveCountryRegistration only. VAT registration number (max 50 characters)",
                    "example": "DE123456789"
                  },
                  "rates": {
                    "type": "object",
                    "description": "saveCountryRegistration only. Per-class rates keyed by tax class slug; at least one rate must be greater than 0 and every slug must reference an existing tax class",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "rate": {
                          "type": "number",
                          "description": "Tax rate percentage",
                          "example": 19
                        },
                        "label": {
                          "type": "string",
                          "description": "Rate label",
                          "example": "VAT"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "action": "euCrossBorderSettings",
                  "eu_vat_settings": {
                    "method": "oss",
                    "oss_country": "DE",
                    "oss_vat": "DE123456789"
                  }
                }
              },
              "example": {
                "action": "euCrossBorderSettings",
                "eu_vat_settings": {
                  "method": "oss",
                  "oss_country": "DE",
                  "oss_vat": "DE123456789"
                }
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "action": "euCrossBorderSettings",
                    "eu_vat_settings": {
                      "method": "oss",
                      "oss_country": "DE",
                      "oss_vat": "DE123456789"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings saved. The message depends on the action: \"EU VAT settings saved successfully\", \"Country VAT registration saved successfully\", or \"Country registration removed successfully\".",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "EU VAT settings saved successfully"
                    }
                  },
                  "example": {
                    "message": "EU VAT settings saved successfully"
                  }
                },
                "example": {
                  "message": "EU VAT settings saved successfully"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "EU VAT settings saved successfully"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unknown action (\"Invalid method\") or validation failed for the given action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "example": {
                    "message": "Validation failed for EU VAT settings",
                    "errors": {
                      "method": "Select a cross-border registration type"
                    }
                  }
                },
                "example": {
                  "message": "Validation failed for EU VAT settings",
                  "errors": {
                    "method": "Select a cross-border registration type"
                  }
                },
                "examples": {
                  "default": {
                    "summary": "Error response",
                    "value": {
                      "message": "Validation failed for EU VAT settings",
                      "errors": {
                        "method": "Select a cross-border registration type"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`store/sensitive`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
