{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentCart API",
    "description": "Complete REST API documentation for FluentCart e-commerce platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{website}/wp-json/fluent-cart/v2",
      "description": "Your WordPress website",
      "variables": {
        "website": {
          "default": "YourWebsite.com",
          "description": "Your WordPress website domain (without https://)"
        }
      }
    }
  ],
  "security": [
    {
      "ApplicationPasswords": []
    }
  ],
  "paths": {
    "/tax/configuration/settings": {
      "post": {
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "operationId": "saveTaxSettings",
        "summary": "POST Save Tax Settings",
        "description": "Save the global tax configuration settings. Invalid enum values are silently replaced with their defaults. If tax is enabled, initial tax classes are automatically created.\n\n**Required permission:** `store/sensitive`",
        "tags": [
          "Tax"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "settings"
                ],
                "properties": {
                  "settings": {
                    "type": "object",
                    "properties": {
                      "enable_tax": {
                        "type": "string",
                        "description": "Enable or disable tax calculation",
                        "enum": [
                          "yes",
                          "no"
                        ],
                        "example": "yes"
                      },
                      "tax_inclusion": {
                        "type": "string",
                        "description": "Whether prices include tax",
                        "enum": [
                          "included",
                          "excluded"
                        ],
                        "example": "excluded"
                      },
                      "tax_calculation_basis": {
                        "type": "string",
                        "description": "Address basis for tax calculation",
                        "enum": [
                          "shipping",
                          "billing",
                          "store"
                        ],
                        "example": "billing"
                      },
                      "tax_rounding": {
                        "type": "string",
                        "description": "Where tax rounding is applied",
                        "enum": [
                          "item",
                          "total",
                          "subtotal"
                        ],
                        "example": "subtotal"
                      },
                      "checkout_tax_breakdown_display": {
                        "type": "string",
                        "description": "How the tax breakdown is displayed at checkout",
                        "enum": [
                          "itemized",
                          "simplified"
                        ],
                        "example": "itemized"
                      },
                      "tax_display_label": {
                        "type": "string",
                        "description": "Label used when displaying tax amounts",
                        "example": "VAT"
                      },
                      "price_suffix_included": {
                        "type": "string",
                        "description": "Text appended after prices that include tax",
                        "example": "incl. VAT"
                      },
                      "price_suffix_excluded": {
                        "type": "string",
                        "description": "Text appended after prices that exclude tax",
                        "example": "excl. VAT"
                      },
                      "eu_vat_settings": {
                        "type": "object",
                        "description": "EU VAT configuration object",
                        "properties": {
                          "require_vat_number": {
                            "type": "string",
                            "enum": [
                              "yes",
                              "no"
                            ]
                          },
                          "local_reverse_charge": {
                            "type": "string",
                            "enum": [
                              "yes",
                              "no"
                            ]
                          },
                          "reverse_charge_price_mode": {
                            "type": "string",
                            "enum": [
                              "fixed",
                              "dynamic"
                            ],
                            "default": "fixed",
                            "description": "Invalid values are replaced with fixed"
                          },
                          "vat_reverse_excluded_categories": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            }
                          },
                          "country_wise_vat": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "settings": {
                    "enable_tax": "yes",
                    "tax_inclusion": "excluded",
                    "tax_calculation_basis": "billing",
                    "tax_rounding": "subtotal",
                    "checkout_tax_breakdown_display": "itemized",
                    "tax_display_label": "VAT",
                    "price_suffix_included": "incl. VAT",
                    "price_suffix_excluded": "excl. VAT",
                    "eu_vat_settings": {
                      "require_vat_number": "yes",
                      "local_reverse_charge": "yes",
                      "reverse_charge_price_mode": "fixed",
                      "vat_reverse_excluded_categories": [
                        12,
                        15
                      ],
                      "country_wise_vat": []
                    }
                  }
                }
              },
              "example": {
                "settings": {
                  "enable_tax": "yes",
                  "tax_inclusion": "excluded",
                  "tax_calculation_basis": "billing",
                  "tax_rounding": "subtotal",
                  "checkout_tax_breakdown_display": "itemized",
                  "tax_display_label": "VAT",
                  "price_suffix_included": "incl. VAT",
                  "price_suffix_excluded": "excl. VAT",
                  "eu_vat_settings": {
                    "require_vat_number": "yes",
                    "local_reverse_charge": "yes",
                    "reverse_charge_price_mode": "fixed",
                    "vat_reverse_excluded_categories": [
                      12,
                      15
                    ],
                    "country_wise_vat": []
                  }
                }
              },
              "examples": {
                "default": {
                  "summary": "Example request",
                  "value": {
                    "settings": {
                      "enable_tax": "yes",
                      "tax_inclusion": "excluded",
                      "tax_calculation_basis": "billing",
                      "tax_rounding": "subtotal",
                      "checkout_tax_breakdown_display": "itemized",
                      "tax_display_label": "VAT",
                      "price_suffix_included": "incl. VAT",
                      "price_suffix_excluded": "excl. VAT",
                      "eu_vat_settings": {
                        "require_vat_number": "yes",
                        "local_reverse_charge": "yes",
                        "reverse_charge_price_mode": "fixed",
                        "vat_reverse_excluded_categories": [
                          12,
                          15
                        ],
                        "country_wise_vat": []
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings saved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Settings saved successfully"
                    }
                  },
                  "example": {
                    "message": "Settings saved successfully"
                  }
                },
                "example": {
                  "message": "Settings saved successfully"
                },
                "examples": {
                  "default": {
                    "summary": "Successful response",
                    "value": {
                      "message": "Settings saved successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated. The request carried no valid WordPress credentials.",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but the user lacks the required capability (`store/sensitive`).",
            "content": {
              "application/json": {
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed, or the referenced record does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "field_name": [
                      "This field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords \u2014 use Basic auth with your WordPress username and an application password in the format: username:application_password"
      }
    }
  }
}
